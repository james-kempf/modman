parse_collection_ref() {   # url | nxm:// | slug → C_DOMAIN C_SLUG C_REV
    local ref="$1"
    C_DOMAIN=""; C_SLUG=""; C_REV=""
    if [[ "$ref" =~ ^nxm://([^/?#]+)/collections/([a-zA-Z0-9]+)(/revisions/([0-9]+))? ]] ||
       [[ "$ref" =~ nexusmods\.com/games/([^/?#]+)/collections/([a-zA-Z0-9]+)(/revisions/([0-9]+))? ]] ||
       [[ "$ref" =~ nexusmods\.com/([^/?#]+)/collections/([a-zA-Z0-9]+)(/revisions/([0-9]+))? ]]; then
        C_DOMAIN="${BASH_REMATCH[1],,}"; C_SLUG="${BASH_REMATCH[2]}"; C_REV="${BASH_REMATCH[4]}"
        return 0
    fi
    if [[ "$ref" =~ ^[a-zA-Z0-9]{3,12}$ ]]; then
        C_SLUG="$ref"; C_DOMAIN="${FORCE_GAME:-$GAME_DOMAIN}"
        return 0
    fi
    return 1
}

collection_url_help() {
    echo -e "  Supported formats:"
    echo -e "    nxm://{game}/collections/{slug}[/revisions/{rev}]"
    echo -e "    https://www.nexusmods.com/games/{game}/collections/{slug}"
    echo -e "    https://www.nexusmods.com/{game}/collections/{slug}"
    echo -e "    {slug}   (for the active game)"
}

# Switches to the given game for this run (offers to set it up first).
use_game_for() {
    local d="$1"
    if [[ -n "$d" ]] && ! game_exists "$d"; then
        if is_interactive && confirm "Game '${d}' is not set up yet. Set it up now?" Y; then
            game_add_flow "$d" ""
        else
            die "Game '${d}' is not set up. Run: ${PROG} game add ${d}"
        fi
    fi
    FORCE_GAME="$d"
    need_game
}

GQL_COLLECTION='query Rev($slug: String, $domainName: String, $revision: Int, $viewAdultContent: Boolean) {
  collectionRevision(slug: $slug, domainName: $domainName, revision: $revision, viewAdultContent: $viewAdultContent) {
    revisionNumber revisionStatus downloadLink totalSize assetsSizeBytes modCount createdAt
    collection { name summary slug latestPublishedRevision { revisionNumber } user { name } game { domainName name } }
    modFiles { fileId optional file { modId name version sizeInBytes mod { name author } } }
    externalResources { name resourceType resourceUrl }
  }
}'

# Fetches revision metadata (GraphQL) and the collection archive (collection.json + bundles).
# Sets C_DIR C_JSON C_NAME C_AUTHOR C_REV C_LATEST C_SIZE C_STATUS
fetch_collection() {
    local vars data rev link body uri cf
    vars=$(jq -cn --arg s "$C_SLUG" --arg d "$C_DOMAIN" --arg r "$C_REV" --argjson a "${VIEW_ADULT:-false}" \
        '{slug: $s, domainName: $d, revision: (if $r == "" then null else ($r | tonumber) end), viewAdultContent: $a}')
    info "Querying collection ${BOLD}${C_SLUG}${RESET} (${C_DOMAIN}, revision ${C_REV:-latest})..."
    if ! data=$(gql_query "$GQL_COLLECTION" "$vars"); then
        error "GraphQL error: $(api_error_msg "$data")"
        echo "  • Slug '${C_SLUG}' not found, collection is private, or not yet published" >&2
        echo "  • Game domain '${C_DOMAIN}' does not match the collection's game" >&2
        echo "  • API key invalid — run: ${PROG} login" >&2
        return 1
    fi
    rev=$(jq -c '.collectionRevision' <<< "$data")
    if [[ -z "$rev" || "$rev" == null ]]; then
        error "Collection '${C_SLUG}' not found or not published."; return 1
    fi
    IFS="$SEP" read -r C_REV C_NAME C_AUTHOR C_LATEST C_SIZE C_STATUS < <(jq -r "$JQ_DEFS"'
        [.revisionNumber, .collection.name, .collection.user.name, .collection.latestPublishedRevision.revisionNumber,
         .totalSize, .revisionStatus] | row' <<< "$rev")
    C_DIR="${COL_DIR}/${C_SLUG}/rev${C_REV}"
    C_JSON="${C_DIR}/collection.json"
    mkdir -p "$C_DIR"
    printf '%s\n' "$rev" > "${C_DIR}/revision.json"

    if [[ ! -s "$C_JSON" ]]; then
        link=$(jq -r '.downloadLink // empty' <<< "$rev")
        if [[ -n "$link" ]]; then
            [[ "$link" == /* ]] && link="${API_ROOT}${link}"
            if body=$(api_request GET "$link"); then
                uri=$(jq -r '.download_links[0].URI // empty' <<< "$body" 2>/dev/null || true)
            else
                warn "Collection download link refused: $(api_error_msg "$body")"; uri=""
            fi
            if [[ -n "$uri" ]] && fetch_file "$(encode_uri "$uri")" "${C_DIR}/collection.archive" "" quiet \
               && extract_archive "${C_DIR}/collection.archive" "${C_DIR}/content"; then
                cf=$(find "${C_DIR}/content" -maxdepth 2 -iname collection.json -print -quit 2>/dev/null || true)
                [[ -n "$cf" ]] && cp -- "$cf" "$C_JSON"
            fi
        fi
        if [[ ! -s "$C_JSON" ]]; then
            warn "Collection archive unavailable — using the API mod list (no FOMOD choices or load-order rules)."
            jq --arg d "$C_DOMAIN" '{
                info: {name: .collection.name, author: .collection.user.name, domainName: $d},
                mods: [ .modFiles[] | {
                    name: (.file.mod.name // .file.name), version: .file.version, optional: (.optional // false),
                    domainName: $d, author: (.file.mod.author // ""),
                    source: {type: "nexus", modId: .file.modId, fileId: .fileId,
                             fileSize: ((.file.sizeInBytes // "0") | tonumber? // 0)} } ],
                modRules: [] }' <<< "$rev" > "$C_JSON"
        fi
    fi
    jq -e '.mods | type == "array"' "$C_JSON" >/dev/null 2>&1 || { error "collection.json is invalid: ${C_JSON}"; return 1; }
}

# parse_selection "1,3-5" <max> → 0-based indexes (one per line); "all" / "none" supported
parse_selection() {
    local text="${1,,}" max="$2" tok a b i
    text="${text//,/ }"
    case "$text" in
        all|a|"*") for (( i = 0; i < max; i++ )); do echo "$i"; done; return 0 ;;
        none|n|0|"") return 0 ;;
    esac
    for tok in $text; do
        if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            a=${BASH_REMATCH[1]}; b=${BASH_REMATCH[2]}
            for (( i = a; i <= b; i++ )); do (( i >= 1 && i <= max )) && echo $(( i - 1 )); done
        elif [[ "$tok" =~ ^[0-9]+$ ]]; then
            (( tok >= 1 && tok <= max )) && echo $(( tok - 1 ))
        else
            return 1
        fi
    done
    return 0
}

collection_order_py() {
    cat <<'PYEOF'
import sys, json, heapq
cj = json.load(open(sys.argv[1]))
present = [int(x) for x in sys.argv[2].split(',') if x]
mods = cj.get('mods') or []

def keys(m):
    s = m.get('source') or {}
    out = []
    if s.get('tag'): out.append(('tag', s['tag']))
    if s.get('md5'): out.append(('md5', s['md5'].lower()))
    if s.get('logicalFilename'): out.append(('lfn', s['logicalFilename'].lower()))
    if s.get('fileExpression'): out.append(('exp', s['fileExpression'].lower()))
    return out

index = {}
for i in present:
    for k in keys(mods[i]):
        index.setdefault(k, i)

def lookup(ref):
    if not isinstance(ref, dict):
        return None
    for kind, field in (('tag', 'tag'), ('md5', 'fileMD5'), ('lfn', 'logicalFileName'), ('exp', 'fileExpression')):
        v = ref.get(field)
        if v:
            i = index.get((kind, v if kind == 'tag' else str(v).lower()))
            if i is not None:
                return i
    return None

edges = {i: set() for i in present}
indeg = {i: 0 for i in present}
def before(a, b):
    if a is None or b is None or a == b or b in edges[a]:
        return
    edges[a].add(b)
    indeg[b] += 1

for r in cj.get('modRules') or []:
    t = r.get('type')
    s, ref = lookup(r.get('source')), lookup(r.get('reference'))
    if t == 'before':
        before(s, ref)
    elif t == 'after':
        before(ref, s)

rank = {i: ((mods[i].get('phase') or 0), n) for n, i in enumerate(present)}
heap = [(rank[i], i) for i in present if indeg[i] == 0]
heapq.heapify(heap)
out = []
while heap:
    _, i = heapq.heappop(heap)
    out.append(i)
    for j in edges[i]:
        indeg[j] -= 1
        if indeg[j] == 0:
            heapq.heappush(heap, (rank[j], j))
if len(out) < len(present):
    done = set(out)
    rest = sorted((i for i in present if i not in done), key=lambda i: rank[i])
    print(f"{len(rest)} mods are part of a rule cycle; keeping collection order for them", file=sys.stderr)
    out += rest
print(','.join(map(str, out)))
PYEOF
}

# Moves the given mod ids (in order) into one contiguous block in the load order.
JQ_REORDER_BLOCK='
($ids | map({(.): true}) | add // {}) as $set
| (.mods | map(.id)) as $cur
| ([ $cur | to_entries[] | select($set[.value]) | .key ] | min // (.mods | length)) as $pos
| (.mods | map(select($set[.id] | not))) as $rest
| (.mods | map({key: .id, value: .}) | from_entries) as $by
| .mods = ($rest[:$pos] + [ $ids[] | $by[.] | select(. != null) ] + $rest[$pos:])'

json_array() { if (( $# )); then printf '%s\n' "$@" | jq -R . | jq -sc .; else echo '[]'; fi; }

collection_install() {
    local ref="" optional_mode="" fomod_mode="collection" deploy_after=0 download_only=0 rev_override=""
    while (( $# )); do
        case "$1" in
            --optional)        optional_mode="${2:-}"; shift ;;
            --optional=*)      optional_mode="${1#*=}" ;;
            --fomod)           fomod_mode="${2:-}"; shift ;;
            --revision|-r)     rev_override="${2:-}"; shift ;;
            --deploy)          deploy_after=1 ;;
            --download-only)   download_only=1 ;;
            -*)                die "Unknown option for collection install: $1" ;;
            *)                 ref="$1" ;;
        esac
        shift
    done
    [[ -n "$ref" ]] || { error "Usage: ${PROG} collection install <collection-url|slug> [--optional all|none|ask] [--revision N]"; collection_url_help; exit 1; }
    parse_collection_ref "$ref" || { error "Cannot parse collection reference: ${ref}"; collection_url_help; exit 1; }
    [[ -n "$rev_override" ]] && C_REV="$rev_override"
    case "$optional_mode" in ""|all|none|ask) ;; *) die "--optional must be all, none or ask" ;; esac
    case "$fomod_mode" in collection|ask|default) ;; *) die "--fomod must be collection, ask or default" ;; esac
    require_login
    use_game_for "$C_DOMAIN"
    acquire_lock
    [[ -n "$IS_PREMIUM" ]] || refresh_account || true

    banner "Collection — ${C_SLUG}"
    fetch_collection || exit 1

    # ── mod table ─────────────────────────────────────────
    local -a CM=() R_NAME=() R_VER=() R_OPT=() R_TYPE=() R_MOD=() R_FILE=() R_MD5=() R_SIZE=()
    mapfile -t CM < <(jq -c '.mods[]' "$C_JSON")
    local idx name ver opt type modid fileid md5 size n=${#CM[@]}
    while IFS="$SEP" read -r idx name ver opt type modid fileid md5 size; do
        R_NAME[idx]="${name:-mod ${modid}}"; R_VER[idx]="$ver"; R_OPT[idx]="$opt"; R_TYPE[idx]="$type"
        R_MOD[idx]="$modid"; R_FILE[idx]="$fileid"; R_MD5[idx]="${md5,,}"; R_SIZE[idx]="${size:-0}"
    done < <(jq -r "$JQ_DEFS"' .mods | to_entries[] | [.key, (.value.name // .value.source.logicalFilename),
             .value.version, (.value.optional // false), (.value.source.type // "nexus"), .value.source.modId,
             .value.source.fileId, .value.source.md5, (.value.source.fileSize // 0)] | row' "$C_JSON")

    local n_opt=0 i
    for (( i = 0; i < n; i++ )); do [[ "${R_OPT[i]}" == true ]] && n_opt=$(( n_opt + 1 )); done
    local instructions
    instructions=$(jq -r '.info.installInstructions // empty' "$C_JSON")

    echo ""
    info "Collection : ${BOLD}${C_NAME}${RESET} by ${BOLD}${C_AUTHOR}${RESET}"
    info "Revision   : ${BOLD}${C_REV}${RESET}  [${C_STATUS}]$( [[ -n "$C_LATEST" && "$C_LATEST" != "$C_REV" ]] && echo "  ${YELLOW}(latest is ${C_LATEST})${RESET}")"
    info "Mods       : ${BOLD}${n}${RESET}  ($(( n - n_opt )) required, ${n_opt} optional)"
    info "Total size : ${BOLD}$(human_size "${C_SIZE:-0}")${RESET}"
    if [[ -n "$instructions" ]]; then
        echo ""
        echo -e "${BOLD}Curator's instructions${RESET} ${DIM}(written for Vortex — modman handles staging/deploy itself)${RESET}"
        fold -s -w $(( $(term_cols) - 6 )) <<< "$instructions" | sed 's/^/    │ /'
    fi
    echo ""

    # ── optional mods ─────────────────────────────────────
    local -a selected=() opt_idx=()
    for (( i = 0; i < n; i++ )); do
        if [[ "${R_OPT[i]}" == true ]]; then opt_idx+=("$i"); else selected+=("$i"); fi
    done
    if (( ${#opt_idx[@]} )); then
        local mode="${optional_mode:-ask}"
        [[ "$mode" == ask ]] && ! is_interactive && mode=none
        case "$mode" in
            all)  selected+=("${opt_idx[@]}") ;;
            none) info "Skipping ${#opt_idx[@]} optional mods (use --optional all to include them)." ;;
            ask)
                echo -e "${BOLD}Optional mods:${RESET}"
                for i in "${!opt_idx[@]}"; do
                    printf "  ${CYAN}%3d.${RESET} %s ${DIM}%s  (%s)${RESET}\n" $(( i + 1 )) "${R_NAME[${opt_idx[i]}]}" \
                        "${R_VER[${opt_idx[i]}]}" "$(human_size "${R_SIZE[${opt_idx[i]}]}")"
                done
                local ans picks
                while :; do
                    ask ans "Install which optional mods? (all, none, or e.g. 1,3-5)" all
                    if picks=$(parse_selection "$ans" "${#opt_idx[@]}"); then break; fi
                    warn "Invalid selection."
                done
                while IFS= read -r i; do [[ -n "$i" ]] && selected+=("${opt_idx[i]}"); done <<< "$picks" ;;
        esac
    fi
    mapfile -t selected < <(printf '%s\n' "${selected[@]}" | sort -nu)

    # ── what do we already have? ──────────────────────────
    local -A BY_MD5=() BY_FILE=() HAVE=() ARCH=()
    local id m f
    while IFS="$SEP" read -r id md5 m f; do
        [[ -n "$md5" ]] && BY_MD5[${md5,,}]="$id"
        [[ -n "$m" ]] && BY_FILE["${m}-${f}"]="$id"
    done < <(jq -r "$JQ_DEFS"' .mods[] | [.id, .md5, .modId, .fileId] | row' "$DB_FILE")
    local -a todo=() dl_queue=()
    local dl_bytes=0 p
    for i in "${selected[@]}"; do
        id=""
        [[ -n "${R_MD5[i]}" ]] && id="${BY_MD5[${R_MD5[i]}]:-}"
        [[ -z "$id" && -n "${R_MOD[i]}" ]] && id="${BY_FILE["${R_MOD[i]}-${R_FILE[i]}"]:-}"
        if [[ -n "$id" ]]; then HAVE[$i]="$id"; continue; fi
        todo+=("$i")
        if [[ "${R_TYPE[i]}" == nexus ]]; then
            if p=$(find_download "${R_MOD[i]}" "${R_FILE[i]}"); then ARCH[$i]="$p"
            else dl_queue+=("$i"); dl_bytes=$(( dl_bytes + ${R_SIZE[i]:-0} )); fi
        fi
    done

    info "Already installed : ${#HAVE[@]}"
    info "To install        : ${#todo[@]}"
    info "To download       : ${#dl_queue[@]}  ($(human_size "$dl_bytes"))"
    local avail
    avail=$(df --output=avail -B1 "$DL_DIR" 2>/dev/null | tail -1 | tr -d ' ') || avail=""
    if [[ "$avail" =~ ^[0-9]+$ ]] && (( dl_bytes * 2 > avail )); then
        warn "Low disk space: ~$(human_size $(( dl_bytes * 2 ))) needed (archives + extracted files), $(human_size "$avail") free."
    fi
    if (( ${#dl_queue[@]} )) && [[ "$IS_PREMIUM" != true ]]; then
        warn "Free account: Nexus requires a click on \"Slow download\" for each of the ${#dl_queue[@]} files."
        nxm_handler_registered || warn "Register the link handler first: ${PROG} nxm register"
    fi
    if (( ${#todo[@]} == 0 && ${#HAVE[@]} == 0 )); then die "Nothing selected."; fi
    echo ""
    confirm "Proceed?" Y || { info "Cancelled."; return 0; }

    local -a failed=()

    # ── acquire archives ──────────────────────────────────
    for i in "${todo[@]}"; do
        case "${R_TYPE[i]}" in
            nexus) ;;
            bundle)
                if collection_bundled "$i"; then ARCH[$i]="$ACQ_RESULT"; else failed+=("${i}${SEP}bundled file missing from collection archive"); fi ;;
            direct)
                if collection_direct "$i"; then ARCH[$i]="$ACQ_RESULT"; else failed+=("${i}${SEP}direct download failed"); fi ;;
            browse|manual)
                if collection_manual "$i"; then ARCH[$i]="$ACQ_RESULT"; else failed+=("${i}${SEP}manual download required"); fi ;;
            *)  failed+=("${i}${SEP}unsupported source type '${R_TYPE[i]}'") ;;
        esac
    done
    if (( ${#dl_queue[@]} )); then
        section "Downloading"
        download_queue "${dl_queue[@]}"
    fi

    if (( download_only )); then
        echo ""
        success "Downloaded $(( ${#ARCH[@]} )) archive(s) into ${DL_DIR}"
        print_collection_failures
        info "Install with: ${PROG} collection install nxm://${C_DOMAIN}/collections/${C_SLUG}/revisions/${C_REV}"
        return 0
    fi

    # ── install ───────────────────────────────────────────
    local -A IDS=()
    for i in "${!HAVE[@]}"; do IDS[$i]="${HAVE[$i]}"; done
    if (( ${#HAVE[@]} )); then
        local have_json; have_json=$(json_array "${HAVE[@]}")
        db_update --argjson ids "$have_json" --arg slug "$C_SLUG" \
            '.mods |= map(if (.id | IN($ids[])) then .collections = (((.collections // []) + [$slug]) | unique) else . end)'
    fi
    local k=0 ok=0 meta
    if (( ${#todo[@]} )); then section "Installing"; fi
    for i in "${todo[@]}"; do
        k=$(( k + 1 ))
        [[ -n "${ARCH[$i]:-}" ]] || continue
        echo -e "  ${CYAN}[${k}/${#todo[@]}]${RESET} ${BOLD}${R_NAME[i]}${RESET} ${DIM}${R_VER[i]}${RESET}"
        meta=$(jq -c --arg slug "$C_SLUG" --arg fm "$fomod_mode" --arg name "${R_NAME[i]}" '{
                name: $name, version: (.version // ""), modId: .source.modId, fileId: .source.fileId,
                md5: ((.source.md5 // "") | ascii_downcase),
                source: (if (.source.type // "nexus") == "nexus" then "nexus" else .source.type end),
                collections: [$slug], choices: (.choices // null), fomodMode: $fm,
                author: (.author // ""), category: (.details.category // ""), updatePolicy: (.source.updatePolicy // "")}' <<< "${CM[i]}")
        if install_archive "${ARCH[$i]}" "$meta"; then
            IDS[$i]="$INSTALLED_ID"; ok=$(( ok + 1 ))
        else
            failed+=("${i}${SEP}install failed")
        fi
    done

    # ── load order from the collection's rules ────────────
    local present="" order ordered_ids=() seen_ids=""
    for i in "${selected[@]}"; do [[ -n "${IDS[$i]:-}" ]] && present+="${i},"; done
    if [[ -n "$present" ]]; then
        if order=$(python3 -I -c "$(collection_order_py)" "$C_JSON" "${present%,}"); then
            local -A dedupe=()
            IFS=',' read -r -a order <<< "$order"
            for i in "${order[@]}"; do
                id="${IDS[$i]:-}"
                [[ -n "$id" && -z "${dedupe[$id]+x}" ]] || continue
                dedupe[$id]=1; ordered_ids+=("$id")
            done
            db_update --argjson ids "$(json_array "${ordered_ids[@]}")" "$JQ_REORDER_BLOCK"
            info "Applied the collection's load order (${#ordered_ids[@]} mods, $(jq '.modRules | length' "$C_JSON") rules)."
        else
            warn "Could not compute the collection load order — keeping install order."
            for i in "${selected[@]}"; do [[ -n "${IDS[$i]:-}" ]] && ordered_ids+=("${IDS[$i]}"); done
        fi
    fi

    # ── record the collection ─────────────────────────────
    local failed_names=() entry
    for entry in "${failed[@]}"; do failed_names+=("${R_NAME[${entry%%"$SEP"*}]}"); done
    local rec
    rec=$(jq -n --arg slug "$C_SLUG" --arg name "$C_NAME" --arg author "$C_AUTHOR" --arg domain "$C_DOMAIN" \
        --argjson rev "$C_REV" --argjson mods "$(json_array "${ordered_ids[@]}")" \
        --argjson failed "$(json_array "${failed_names[@]}")" --argjson now "$(now)" --arg dir "$C_DIR" \
        '{slug: $slug, name: $name, author: $author, domain: $domain, revision: $rev, installed: $now,
          mods: $mods, failed: $failed, dir: $dir}')
    db_update --arg slug "$C_SLUG" --argjson rec "$rec" '.collections[$slug] = $rec'

    echo ""
    section "Collection Summary"
    echo -e "  ${CYAN}Collection :${RESET} ${C_NAME}  (rev ${C_REV})"
    echo -e "  ${GREEN}Installed  :${RESET} ${ok}"
    echo -e "  ${GREEN}Present    :${RESET} ${#HAVE[@]}  (already installed)"
    echo -e "  ${RED}Failed     :${RESET} ${#failed[@]}"
    print_collection_failures
    echo ""
    if (( ${#failed[@]} )); then
        warn "Re-run the same command to retry — finished mods are skipped."
    fi

    # ── requirements the collection does not include (UE4SS, script extenders, ...) ──
    local -a col_ids=() col_modids=()
    mapfile -t col_ids < <(jq -r --arg s "$C_SLUG" '.mods[] | select((.collections // []) | index($s)) | .id' "$DB_FILE")
    mapfile -t col_modids < <(jq -r --arg s "$C_SLUG" '.mods[] | select(((.collections // []) | index($s)) and .modId != null) | .modId' "$DB_FILE")
    if (( ${#col_ids[@]} )); then
        deps_fetch "${col_modids[@]+"${col_modids[@]}"}" || true
        deps_report problems "$(deps_scope_json "${col_ids[@]}")" "Requirements not included in the collection" || true
        echo ""
    fi
    if (( deploy_after )) || [[ "$AUTO_DEPLOY" == true ]]; then
        cmd_deploy
    else
        success "Collection installed. Apply it to the game with: ${BOLD}${PROG} deploy${RESET}"
    fi
}

print_collection_failures() {
    local entry i reason
    (( ${#failed[@]} )) || return 0
    echo ""
    for entry in "${failed[@]}"; do
        i="${entry%%"$SEP"*}"; reason="${entry#*"$SEP"}"
        echo -e "    ${RED}✗${RESET} ${R_NAME[i]} ${DIM}— ${reason}${RESET}"
        [[ -n "${R_MOD[i]}" ]] && echo -e "      ${DIM}${SITE_URL}/${C_DOMAIN}/mods/${R_MOD[i]}?tab=files&file_id=${R_FILE[i]}${RESET}"
    done
    return 0
}

# Downloads collection files. Premium: parallel; free: one at a time via the website.
download_queue() {
    local total=$# jobs=1 res k=0 i st line
    res="$(run_tmp)/dl-results"; : > "$res"
    [[ "$IS_PREMIUM" == true ]] && jobs="${DOWNLOAD_JOBS:-4}"
    [[ "$jobs" =~ ^[0-9]+$ ]] && (( jobs >= 1 )) || jobs=1
    if (( jobs == 1 )); then
        for i in "$@"; do
            k=$(( k + 1 ))
            echo -e "  ${CYAN}[${k}/${total}]${RESET} ${R_NAME[i]}  ${DIM}$(human_size "${R_SIZE[i]}")${RESET}"
            if download_nexus_file "$C_DOMAIN" "${R_MOD[i]}" "${R_FILE[i]}" "${R_MD5[i]}"; then
                ARCH[$i]="$DL_RESULT"
            else
                failed+=("${i}${SEP}download failed")
            fi
        done
        return 0
    fi
    info "${total} files, ${jobs} at a time"
    for i in "$@"; do
        while (( $(jobs -rp | wc -l) >= jobs )); do wait -n 2>/dev/null || true; done
        (
            if download_nexus_file "$C_DOMAIN" "${R_MOD[i]}" "${R_FILE[i]}" "${R_MD5[i]}" quiet; then
                printf 'ok\x1f%s\x1f%s\n' "$i" "$DL_RESULT" >> "$res"; st="${GREEN}✓${RESET}"
            else
                printf 'fail\x1f%s\x1f\n' "$i" >> "$res"; st="${RED}✗${RESET}"
            fi
            echo -e "  ${st} [$(wc -l < "$res")/${total}] ${R_NAME[i]}  ${DIM}$(human_size "${R_SIZE[i]}")${RESET}"
        ) &
    done
    wait || true
    local status idx path
    while IFS="$SEP" read -r status idx path; do
        if [[ "$status" == ok && -f "$path" ]]; then ARCH[$idx]="$path"; else failed+=("${idx}${SEP}download failed"); fi
    done < "$res"
}

collection_bundled() {   # → ACQ_RESULT
    local i="$1" bdir="${C_DIR}/content/bundled" want p
    ACQ_RESULT=""
    [[ -d "$bdir" ]] || return 1
    for want in "$(jq -r '.source.fileExpression // empty' <<< "${CM[i]}")" \
                "$(jq -r '.source.logicalFilename // empty' <<< "${CM[i]}")" "${R_NAME[i]}"; do
        [[ -n "$want" ]] || continue
        p=$(find "$bdir" -mindepth 1 -maxdepth 1 -iname "${want}*" -print -quit 2>/dev/null || true)
        [[ -n "$p" ]] && { ACQ_RESULT="$p"; return 0; }
    done
    return 1
}

collection_direct() {
    local i="$1" url fname
    ACQ_RESULT=""
    url=$(jq -r '.source.url // empty' <<< "${CM[i]}")
    [[ -n "$url" ]] || return 1
    fname="${url%%\?*}"; fname=$(urldecode "${fname##*/}"); fname="${fname//\//_}"
    [[ -n "$fname" ]] || fname="$(sanitize_name "${R_NAME[i]}").archive"
    echo -e "  ${DIM}↓ ${fname} (direct)${RESET}"
    fetch_file "$(encode_uri "$url")" "${DL_DIR}/${fname}" "${R_MD5[i]}" || return 1
    ACQ_RESULT="${DL_DIR}/${fname}"
}

collection_manual() {
    local i="$1" url instr p
    ACQ_RESULT=""
    url=$(jq -r '.source.url // empty' <<< "${CM[i]}")
    instr=$(jq -r '.source.instructions // .instructions // empty' <<< "${CM[i]}")
    is_interactive || return 1
    echo -e "\n  ${YELLOW}Manual download required:${RESET} ${BOLD}${R_NAME[i]}${RESET}"
    [[ -n "$instr" ]] && fold -s -w 90 <<< "$instr" | sed 's/^/    /'
    if [[ -n "$url" ]]; then echo -e "    ${CYAN}${url}${RESET}"; open_url "$url"; fi
    ask p "Path to the downloaded file (empty to skip)" ""
    p="${p/#\~/$HOME}"
    [[ -n "$p" && -e "$p" ]] || return 1
    cp -r --reflink=auto -- "$p" "${DL_DIR}/" || return 1
    ACQ_RESULT="${DL_DIR}/${p##*/}"
}

collection_list() {
    need_game
    banner "Collections — ${G_NAME}"
    local n; n=$(jq '.collections | length' "$DB_FILE")
    if (( n == 0 )); then
        info "No collections installed. Install one with: ${PROG} collection install <url>"
        return 0
    fi
    local slug name author rev cnt enabled failed installed
    while IFS="$SEP" read -r slug name author rev cnt enabled failed installed; do
        echo -e "  ${CYAN}•${RESET} ${BOLD}${name}${RESET}  ${DIM}(${slug}, rev ${rev}, by ${author})${RESET}"
        echo -e "      ${cnt} mods (${enabled} enabled)$( (( failed > 0 )) && echo ", ${RED}${failed} failed${RESET}")  · installed $(fmt_date "$installed")"
    done < <(jq -r "$JQ_DEFS"' . as $db | .collections | to_entries[] | .value as $c
             | [$c.slug, $c.name, $c.author, $c.revision,
                ([$db.mods[] | select((.collections // []) | index($c.slug))] | length),
                ([$db.mods[] | select(((.collections // []) | index($c.slug)) and .enabled)] | length),
                ($c.failed | length), $c.installed] | row' "$DB_FILE")
}

collection_info() {
    local ref="${1:-}"
    [[ -n "$ref" ]] || die "Usage: ${PROG} collection info <url|slug>"
    parse_collection_ref "$ref" || { error "Cannot parse collection reference: ${ref}"; collection_url_help; exit 1; }
    require_login
    use_game_for "$C_DOMAIN"
    local local_rec
    local_rec=$(jq -c --arg s "$C_SLUG" '.collections[$s] // empty' "$DB_FILE")
    local vars data rev
    vars=$(jq -cn --arg s "$C_SLUG" --arg d "$C_DOMAIN" --arg r "$C_REV" --argjson a "${VIEW_ADULT:-false}" \
        '{slug: $s, domainName: $d, revision: (if $r == "" then null else ($r | tonumber) end), viewAdultContent: $a}')
    data=$(gql_query "$GQL_COLLECTION" "$vars") || die "GraphQL error: $(api_error_msg "$data")"
    rev=$(jq -c '.collectionRevision' <<< "$data")
    [[ "$rev" != null ]] || die "Collection '${C_SLUG}' not found."
    banner "Collection — ${C_SLUG}"
    jq -r --arg site "$SITE_URL" '
        "  Name      : \(.collection.name)",
        "  Author    : \(.collection.user.name)",
        "  Game      : \(.collection.game.name) (\(.collection.game.domainName))",
        "  Revision  : \(.revisionNumber) [\(.revisionStatus)]  — latest published: \(.collection.latestPublishedRevision.revisionNumber // "?")",
        "  Mods      : \(.modCount)  (\([.modFiles[] | select(.optional)] | length) optional)",
        "  Size      : \((.totalSize | tonumber? // 0) / 1048576 | floor) MB",
        "  URL       : \($site)/games/\(.collection.game.domainName)/collections/\(.collection.slug)",
        "  Summary   : \(.collection.summary // "")"' <<< "$rev"
    echo ""
    if [[ -n "$local_rec" ]]; then
        local irev; irev=$(jq -r '.revision' <<< "$local_rec")
        echo -e "  ${GREEN}Installed${RESET}: revision ${irev}, $(jq '.mods | length' <<< "$local_rec") mods, on $(fmt_date "$(jq -r '.installed' <<< "$local_rec")")"
        local latest; latest=$(jq -r '.collection.latestPublishedRevision.revisionNumber // empty' <<< "$rev")
        if [[ -n "$latest" && "$latest" != "$irev" ]]; then
            echo -e "  ${YELLOW}Update available${RESET}: revision ${latest} → ${PROG} collection update ${C_SLUG}"
        fi
    else
        echo -e "  ${DIM}Not installed. Install with: ${PROG} collection install ${ref}${RESET}"
    fi
}

collection_update() {
    local ref="${1:-}"; shift || true
    [[ -n "$ref" ]] || die "Usage: ${PROG} collection update <slug> [install options]"
    parse_collection_ref "$ref" || die "Cannot parse collection reference: ${ref}"
    use_game_for "$C_DOMAIN"
    local rec; rec=$(jq -c --arg s "$C_SLUG" '.collections[$s] // empty' "$DB_FILE")
    [[ -n "$rec" ]] || die "Collection '${C_SLUG}' is not installed for ${G_NAME}."
    require_login
    local vars data latest irev
    vars=$(jq -cn --arg s "$C_SLUG" --arg d "$C_DOMAIN" '{slug: $s, domainName: $d, revision: null, viewAdultContent: false}')
    data=$(gql_query "$GQL_COLLECTION" "$vars") || die "GraphQL error: $(api_error_msg "$data")"
    latest=$(jq -r '.collectionRevision.revisionNumber // empty' <<< "$data")
    irev=$(jq -r '.revision' <<< "$rec")
    if [[ "$latest" == "$irev" ]] && [[ "$(jq '.failed | length' <<< "$rec")" == 0 ]]; then
        success "${C_SLUG} is up to date (revision ${irev})."
        return 0
    fi
    info "Updating ${C_SLUG}: revision ${irev} → ${latest}"
    local -a old_ids=()
    mapfile -t old_ids < <(jq -r '.mods[]' <<< "$rec")
    collection_install "nxm://${C_DOMAIN}/collections/${C_SLUG}" --revision "$latest" "$@"
    # mods that the new revision dropped
    local new_ids dropped=() shared=() id
    new_ids=$(jq -c --arg s "$C_SLUG" '.collections[$s].mods' "$DB_FILE")
    for id in "${old_ids[@]}"; do
        jq -e --arg id "$id" 'index($id)' <<< "$new_ids" >/dev/null && continue
        db_has "$id" || continue
        if [[ "$(jq -r --arg id "$id" --arg s "$C_SLUG" '.mods[] | select(.id == $id) | (.collections // []) - [$s] | length' "$DB_FILE")" == 0 ]]; then
            dropped+=("$id")
        else
            shared+=("$id")
        fi
    done
    if (( ${#shared[@]} )); then
        db_update --argjson ids "$(json_array "${shared[@]}")" --arg s "$C_SLUG" \
            '.mods |= map(if (.id | IN($ids[])) then .collections -= [$s] else . end)'
    fi
    if (( ${#dropped[@]} )); then
        echo ""
        warn "${#dropped[@]} mod(s) are no longer part of ${C_SLUG}:"
        for id in "${dropped[@]}"; do echo -e "    ${YELLOW}−${RESET} ${id}"; done
        if confirm "Uninstall them?" Y; then
            uninstall_ids 1 "${dropped[@]}"
            success "Removed ${#dropped[@]} dropped mod(s)."
        else
            db_update --argjson ids "$(json_array "${dropped[@]}")" --arg s "$C_SLUG" \
                '.mods |= map(if (.id | IN($ids[])) then .collections -= [$s] else . end)'
        fi
    fi
}

collection_remove() {
    local ref="" keep=0
    while (( $# )); do
        case "$1" in --keep-mods) keep=1 ;; -*) die "Unknown option: $1" ;; *) ref="$1" ;; esac
        shift
    done
    [[ -n "$ref" ]] || die "Usage: ${PROG} collection remove <slug> [--keep-mods]"
    parse_collection_ref "$ref" || die "Cannot parse collection reference: ${ref}"
    use_game_for "$C_DOMAIN"
    acquire_lock
    jq -e --arg s "$C_SLUG" '.collections[$s]' "$DB_FILE" >/dev/null || die "Collection '${C_SLUG}' is not installed."
    local -a exclusive=() shared=()
    mapfile -t exclusive < <(jq -r --arg s "$C_SLUG" '.mods[] | select((.collections // []) == [$s]) | .id' "$DB_FILE")
    mapfile -t shared < <(jq -r --arg s "$C_SLUG" '.mods[] | select(((.collections // []) | index($s)) and ((.collections | length) > 1)) | .id' "$DB_FILE")
    banner "Remove collection — ${C_SLUG}" "$RED"
    if (( keep )); then
        info "Mods stay installed (only the collection record is removed)."
    else
        info "${#exclusive[@]} mod(s) will be uninstalled; ${#shared[@]} shared with other collections stay."
    fi
    confirm "Remove collection ${C_SLUG}?" Y || { info "Cancelled."; return 0; }
    if (( ! keep && ${#exclusive[@]} )); then uninstall_ids 1 "${exclusive[@]}"; fi
    db_update --arg s "$C_SLUG" '.mods |= map(.collections = ((.collections // []) - [$s])) | del(.collections[$s])'
    success "Collection ${C_SLUG} removed."
    after_change
}

cmd_collection() {
    local sub="${1:-list}"; shift || true
    case "$sub" in
        install|add|i)       collection_install "$@" ;;
        download|dl)         collection_install "$@" --download-only ;;
        list|ls)             collection_list ;;
        info|show)           collection_info "$@" ;;
        update|upgrade)      collection_update "$@" ;;
        remove|rm|uninstall) collection_remove "$@" ;;
        *)
            # allow "modman collection <url>" as a shortcut for install
            if parse_collection_ref "$sub" 2>/dev/null && [[ "$sub" == *collections* ]]; then
                collection_install "$sub" "$@"
            else
                die "Unknown collection command '${sub}'. Use: install | download | list | info | update | remove"
            fi ;;
    esac
}

