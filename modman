#!/usr/bin/env bash

# ============================================================
#  modman — Nexus Mods manager for Linux
#
#  Installs single mods and full Nexus collections (with FOMOD
#  choices and load-order rules), stages every mod in its own
#  folder, and deploys them into the game folder with hardlinks,
#  symlinks or reflink copies. Purge restores the game exactly.
#
#  API:  REST v1    → https://api.nexusmods.com/v1   (mods, files, download links)
#        GraphQL v2 → https://api.nexusmods.com/v2/graphql (collections, search)
# ============================================================

set -euo pipefail
shopt -s extglob

MODMAN_VERSION="3.1.0"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PROG="$(basename "$0")"

# ── Paths & Constants ─────────────────────────────────────
CONFIG_DIR="${MODMAN_CONFIG_DIR:-${HOME}/.config/nexus-mod-manager}"
CONFIG_FILE="${CONFIG_DIR}/config.cfg"
GAMES_DIR="${CONFIG_DIR}/games"
NMM_LOG="${CONFIG_DIR}/nmm.log"
LEGACY_MANIFEST="${CONFIG_DIR}/deployed.manifest"
NXM_QUEUE="${CONFIG_DIR}/nxm-queue"
RATELIMIT_FILE="${CONFIG_DIR}/ratelimit"
LOCK_FILE="${CONFIG_DIR}/modman.lock"
REST_BASE="https://api.nexusmods.com/v1"
API_ROOT="https://api.nexusmods.com"
GQL_ENDPOINT="https://api.nexusmods.com/v2/graphql"
SITE_URL="https://www.nexusmods.com"
SEP=$'\x1f'   # internal field separator for lists of paths

# Runtime flags (set by global options)
ASSUME_YES=0
FORCE_GAME=""
RUN_TMP=""
SEVENZ=""

# ── ANSI Colors ───────────────────────────────────────────
setup_colors() {
    if [[ -t 1 && -z "${NO_COLOR:-}" && "${MODMAN_NO_COLOR:-0}" != 1 ]]; then
        RED=$'\e[0;31m';  GREEN=$'\e[0;32m';  YELLOW=$'\e[1;33m'
        BLUE=$'\e[0;34m'; CYAN=$'\e[0;36m';   MAGENTA=$'\e[0;35m'
        BOLD=$'\e[1m';    DIM=$'\e[2m';       RESET=$'\e[0m'
    else
        RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; MAGENTA=''; BOLD=''; DIM=''; RESET=''
    fi
}
setup_colors

# ── Logging Helpers ───────────────────────────────────────
_log() {
    local ts msg="${*:2}"
    msg="${msg//$'\e'\[*([0-9;])m/}"
    printf -v ts '%(%Y-%m-%d %H:%M:%S)T' -1
    printf '%s [%s] %s\n' "$ts" "$1" "$msg" >> "$NMM_LOG" 2>/dev/null || true
}
info()    { echo -e "${CYAN}[INFO]${RESET}  $*"; _log INFO  "$*"; }
success() { echo -e "${GREEN}[ OK ]${RESET}  $*"; _log OK    "$*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*" >&2; _log WARN  "$*"; }
error()   { echo -e "${RED}[ERR ]${RESET}  $*" >&2; _log ERROR "$*"; }
die()     { error "$*"; exit 1; }
debug()   { [[ "${MODMAN_DEBUG:-0}" == 1 ]] && echo -e "${DIM}[DBG ]  $*${RESET}" >&2; _log DEBUG "$*"; }

banner() {
    local color="${2:-$BLUE}" text="$1" width=44
    (( ${#text} + 4 > width )) && width=$(( ${#text} + 4 ))
    local line; printf -v line '%*s' "$width" ''; line="${line// /─}"
    echo -e "${BOLD}${color}┌${line}┐${RESET}"
    printf "${BOLD}${color}│${RESET}  %s%*s${BOLD}${color}│${RESET}\n" "$text" $(( width - 2 - ${#text} )) ""
    echo -e "${BOLD}${color}└${line}┘${RESET}"
    echo ""
}

section() {
    local fill; printf -v fill '%*s' $(( 46 - ${#1} > 0 ? 46 - ${#1} : 0 )) ''
    echo -e "\n${BOLD}── $* ${RESET}${DIM}${fill// /─}${RESET}"
}

# ── Generic Utilities ─────────────────────────────────────
have() { command -v "$1" >/dev/null 2>&1; }
now() { printf '%(%s)T' -1; }
is_interactive() { [[ "$ASSUME_YES" != 1 && -t 0 ]]; }
term_cols() { local c; c=$(tput cols 2>/dev/null || echo "${COLUMNS:-100}"); [[ "$c" =~ ^[0-9]+$ ]] || c=100; echo "$c"; }

human_size() {
    awk -v b="${1:-0}" 'BEGIN { split("B KB MB GB TB", u, " "); i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        if (i == 1) printf "%d %s", b, u[i]; else printf "%.1f %s", b, u[i] }'
}

fmt_date() { [[ -n "${1:-}" && "$1" != null && "$1" != 0 ]] && date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "—"; }

trunc() {
    local s="$1" n="$2"
    if (( ${#s} > n )); then printf '%s…' "${s:0:$((n - 1))}"; else printf '%s' "$s"; fi
}

# Folder-safe name: keeps letters, digits, dot, dash, underscore.
sanitize_name() {
    local s="$1"
    s="${s//[^A-Za-z0-9._-]/_}"
    s="${s//+(_)/_}"
    s="${s##+([_.-])}"; s="${s%%+([_.-])}"
    s="${s:0:60}"
    [[ -n "$s" ]] || s="mod"
    printf '%s' "$s"
}

urldecode() { local s="${1//+/ }"; printf '%b' "${s//%/\\x}"; }

# CDN URIs come back from the API with raw spaces and brackets in the file name.
encode_uri() {
    local u="$1"
    u="${u// /%20}"; u="${u//\[/%5B}"; u="${u//\]/%5D}"; u="${u//\"/%22}"
    printf '%s' "$u"
}

lc_ext() { local f="${1##*/}"; f="${f,,}"; [[ "$f" == *.* ]] && printf '%s' "${f##*.}"; }

# confirm "question" [Y|N] — honours -y, defaults when not interactive
confirm() {
    local q="$1" def="${2:-N}" ans hint
    [[ "$ASSUME_YES" == 1 ]] && return 0
    if [[ ! -t 0 ]]; then [[ "$def" == Y ]]; return; fi
    [[ "$def" == Y ]] && hint="[Y/n]" || hint="[y/N]"
    read -rp "$(echo -e "${BOLD}?${RESET} ${q} ${hint} ")" ans || ans=""
    ans="${ans,,}"
    [[ -z "$ans" ]] && { [[ "$def" == Y ]]; return; }
    [[ "$ans" == y || "$ans" == yes ]]
}

# ask <var> "prompt" [default] — reads a line; uses default when not interactive
ask() {
    local __var="$1" __prompt="$2" __def="${3:-}" __ans=""
    if is_interactive; then
        local __hint=""; [[ -n "$__def" ]] && __hint=" ${DIM}[${__def}]${RESET}"
        read -rp "$(echo -e "${BOLD}?${RESET} ${__prompt}${__hint}: ")" __ans || __ans=""
    fi
    [[ -z "$__ans" ]] && __ans="$__def"
    printf -v "$__var" '%s' "$__ans"
}

open_url() {
    local url="$1"
    if have xdg-open; then
        (setsid xdg-open "$url" >/dev/null 2>&1 &) || true
    else
        warn "Open this URL in your browser: $url"
    fi
}

notify() {
    have notify-send && notify-send -a modman -i applications-games "modman" "$*" 2>/dev/null || true
    _log NOTIFY "$*"
}

# Per-run scratch dir (created once in main, so subshells share it)
run_tmp() {
    if [[ -z "$RUN_TMP" ]]; then
        mkdir -p "${CONFIG_DIR}/tmp"
        RUN_TMP="$(mktemp -d "${CONFIG_DIR}/tmp/run.XXXXXX")"
    fi
    printf '%s' "$RUN_TMP"
}

WORK_TMP=""   # extraction dir of the install in progress (same filesystem as mods/)

cleanup() {
    [[ -n "$RUN_TMP" && -d "$RUN_TMP" ]] && rm -rf -- "$RUN_TMP"
    [[ -n "$WORK_TMP" && -d "$WORK_TMP" ]] && rm -rf -- "$WORK_TMP"
    [[ -f "${NXM_QUEUE}/waiting.pid" ]] && [[ "$(cat "${NXM_QUEUE}/waiting.pid" 2>/dev/null)" == "$$" ]] && rm -f "${NXM_QUEUE}/waiting.pid"
    return 0
}
trap cleanup EXIT
trap 'echo ""; error "Interrupted."; exit 130' INT TERM

acquire_lock() {
    exec 9>"$LOCK_FILE"
    flock -n 9 || die "Another modman command is running (lock: ${LOCK_FILE})."
}

# ── Init ──────────────────────────────────────────────────
init_dirs() {
    mkdir -p "$CONFIG_DIR" "$GAMES_DIR" "$NXM_QUEUE"
    touch "$NMM_LOG"
}

# ── Dependency Check ──────────────────────────────────────
pkg_hint() {
    if have dnf; then echo "sudo dnf install $*"
    elif have apt; then echo "sudo apt install $*"
    elif have pacman; then echo "sudo pacman -S $*"
    elif have zypper; then echo "sudo zypper install $*"
    else echo "install: $*"; fi
}

check_deps() {
    local missing=() dep
    for dep in curl jq python3 file flock; do
        have "$dep" || missing+=("$dep")
    done
    for dep in 7zz 7z 7za; do have "$dep" && { SEVENZ="$dep"; break; }; done
    if [[ -z "$SEVENZ" ]] && ! have bsdtar; then missing+=("7zip"); fi
    if (( ${#missing[@]} )); then
        error "Missing required tools: ${missing[*]}"
        echo -e "  Install with: ${CYAN}$(pkg_hint "${missing[@]}")${RESET}"
        exit 1
    fi
}

# ── Global Config ─────────────────────────────────────────
load_config() {
    local env_key="${NEXUS_API_KEY:-}"
    NEXUS_API_KEY=""; GAME_DOMAIN=""; NEXUS_USER=""; IS_PREMIUM=""
    DATA_DIR="${HOME}/nexus-mods"
    DEPLOY_METHOD="auto"; DOWNLOAD_JOBS=4; PREFERRED_CDN=""
    VIEW_ADULT=false; AUTO_DEPLOY=false; FOMOD_MODE=auto
    GAME_FOLDER=""; STAGING_DIR=""          # legacy (v2) keys

    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    fi
    # Environment overrides apply to this run only and are never written back.
    CFG_API_KEY="$NEXUS_API_KEY"; CFG_DATA_DIR="$DATA_DIR"
    [[ -n "${MODMAN_DATA_DIR:-}" ]] && DATA_DIR="$MODMAN_DATA_DIR"
    [[ -n "$env_key" ]] && NEXUS_API_KEY="$env_key"

    # Migrate the single-game v2 config into a game profile.
    if [[ -n "$GAME_FOLDER" && -n "$GAME_DOMAIN" && ! -f "${GAMES_DIR}/${GAME_DOMAIN}.cfg" ]]; then
        game_defaults "$GAME_DOMAIN"
        G_FOLDER="$GAME_FOLDER"
        save_game "$GAME_DOMAIN"
        GAME_FOLDER=""; STAGING_DIR=""
        save_config
        _log INFO "Migrated v2 configuration for ${GAME_DOMAIN}"
    fi
    GAME_FOLDER=""; STAGING_DIR=""
    return 0
}

save_config() {
    local tmp="${CONFIG_FILE}.tmp"
    {
        echo "# modman configuration — edit with: ${PROG} config <key> <value>"
        local k
        printf '%s=%q\n' NEXUS_API_KEY "${CFG_API_KEY-$NEXUS_API_KEY}" DATA_DIR "${CFG_DATA_DIR-$DATA_DIR}"
        for k in NEXUS_USER IS_PREMIUM GAME_DOMAIN DEPLOY_METHOD \
                 DOWNLOAD_JOBS PREFERRED_CDN VIEW_ADULT AUTO_DEPLOY FOMOD_MODE; do
            printf '%s=%q\n' "$k" "${!k}"
        done
    } > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$CONFIG_FILE"
}

require_login() {
    [[ -n "$NEXUS_API_KEY" ]] || die "Not logged in. Run: ${PROG} login"
}

