# ══════════════════════════════════════════════════════════
# Installing an archive into the staging area
# ══════════════════════════════════════════════════════════
cleanup_work() { [[ -n "$WORK_TMP" ]] && rm -rf -- "$WORK_TMP"; WORK_TMP=""; }

# install_archive <archive> <meta-json> → INSTALLED_ID
# meta keys: name version modId fileId md5 source collections[] choices fomodMode
#            replaces author category updatePolicy variant reinstall
install_archive() {
    local archive="$1" meta="$2" name modid fileid fmode replaces variant reinstall forced_id choices id
    IFS="$SEP" read -r name modid fileid fmode replaces variant reinstall forced_id < <(jq -r "$JQ_DEFS"'
        [.name, .modId, .fileId, .fomodMode, .replaces, .variant, (.reinstall // false), .id] | row' <<< "$meta")
    choices=$(jq -c '.choices // null' <<< "$meta")
    if [[ -z "$name" ]]; then name="${archive##*/}"; name="${name%.*}"; fi

    if [[ -n "$forced_id" ]]; then
        id="$forced_id"
    elif [[ -n "$modid" ]]; then
        id="$(sanitize_name "$name")-${modid}-${fileid}"
    else
        id=$(sanitize_name "$name")
        if [[ "$reinstall" != true ]] && db_has "$id"; then
            local i=2; while db_has "${id}-${i}"; do i=$(( i + 1 )); done
            id="${id}-${i}"
        fi
    fi

    WORK_TMP=$(mktemp -d "${TMP_DIR}/install.XXXXXX")
    local ext="${WORK_TMP}/x" out="${WORK_TMP}/out" froot mode
    extract_archive "$archive" "$ext" || { cleanup_work; return 1; }

    MOD_ROOT=""; MOD_VARIANT=""; FOMOD_CHOICES="null"; PRESET_VARIANT="$variant"
    if [[ "$fmode" != none ]] && froot=$(find_fomod "$ext"); then
        case "$fmode" in
            collection|reuse) if [[ "$choices" != null ]]; then mode=choices
                              elif [[ "$fmode" == reuse ]] && is_interactive; then mode=ask
                              else mode=default; fi ;;
            ask)              if is_interactive; then mode=ask; else mode=default; fi ;;
            default)          mode=default ;;
            *)                if is_interactive; then mode=ask; else mode=default; fi ;;
        esac
        [[ "$mode" != ask ]] && echo -e "      ${DIM}FOMOD installer (${mode/choices/collection choices})${RESET}"
        if ! run_fomod "$froot" "${WORK_TMP}/fomod" "$mode" "$choices" "$name"; then
            error "FOMOD installer failed for ${name}"; cleanup_work; return 1
        fi
        normalize_layout "${WORK_TMP}/fomod" "$out" "$name" 0 0
    else
        normalize_layout "$ext" "$out" "$name" 1 1
    fi

    local nfiles size
    nfiles=$(find "$out" -type f | wc -l)
    if (( nfiles == 0 )); then
        error "No installable files in ${archive##*/}"; cleanup_work; return 1
    fi
    local dest="${MODS_DIR}/${id}"
    if [[ -n "$replaces" && "$replaces" != "$id" && -d "${MODS_DIR}/${replaces}" ]]; then
        rm -rf -- "${MODS_DIR:?}/${replaces}"
    fi
    [[ -d "$dest" ]] && rm -rf -- "$dest"
    mv -- "$out" "$dest"
    size=$(du -sb "$dest" | cut -f1)
    cleanup_work

    local rec
    rec=$(jq -c --arg id "$id" --arg name "$name" --arg archive "$archive" --argjson files "$nfiles" \
              --argjson size "$size" --arg root "$MOD_ROOT" --arg variant "$MOD_VARIANT" \
              --argjson fomod "$FOMOD_CHOICES" --argjson now "$(now)" '
        {id: $id, name: $name, version: (.version // ""),
         modId: (.modId // null), fileId: (.fileId // null), md5: (.md5 // ""),
         source: (.source // "local"), archive: $archive, collections: (.collections // []),
         author: (.author // ""), category: (.category // ""), updatePolicy: (.updatePolicy // ""),
         root: $root, variant: $variant, fomod: $fomod, files: $files, size: $size, installed: $now}' <<< "$meta")
    db_update --argjson m "$rec" --arg rep "$replaces" "$JQ_UPSERT"
    INSTALLED_ID="$id"
}

# ══════════════════════════════════════════════════════════
# Downloading
# ══════════════════════════════════════════════════════════
dl_meta_path() { printf '%s' "${DL_DIR}/.meta/${1}-${2}.json"; }

find_download() {   # find_download <modId> <fileId> → archive path
    local m f
    m=$(dl_meta_path "$1" "$2")
    [[ -f "$m" ]] || return 1
    f=$(jq -r '.file // empty' "$m" 2>/dev/null || true)
    [[ -n "$f" && -f "${DL_DIR}/${f}" ]] || return 1
    printf '%s' "${DL_DIR}/${f}"
}

# fetch_file <url> <dest> [md5] [quiet] — resumable, verified download
fetch_file() {
    local url="$1" dest="$2" md5="${3:-}" quiet="${4:-}" part="${2}.part" try rc got
    mkdir -p "${dest%/*}"
    for try in 1 2 3; do
        local args=(-gL --fail --connect-timeout 30 --retry 3 --retry-delay 3 -C - -o "$part" -A "modman/${MODMAN_VERSION}")
        if [[ -n "$quiet" ]]; then args+=(-sS); else args+=(--progress-bar); fi
        rc=0; curl "${args[@]}" "$url" || rc=$?
        if [[ -f "$part" ]] && (( rc == 0 || rc == 22 || rc == 33 || rc == 36 )); then
            if [[ -n "$md5" ]]; then
                got=$(md5sum -- "$part" | cut -d' ' -f1)
                if [[ "$got" == "$md5" ]]; then mv -f -- "$part" "$dest"; return 0; fi
                (( rc == 0 )) && warn "Checksum mismatch for ${dest##*/} (attempt ${try}/3)"
                rm -f -- "$part"
            elif (( rc == 0 )); then
                mv -f -- "$part" "$dest"; return 0
            else
                rm -f -- "$part"
            fi
        fi
        (( try < 3 )) && sleep $(( try * 2 ))
    done
    rm -f -- "$part"
    return 1
}

nexus_download_uri() {   # → prints the CDN URI for a file
    local game="$1" mod="$2" file="$3" key="${4:-}" exp="${5:-}" q="" body uri
    [[ -n "$key" ]] && q="?key=${key}&expires=${exp}"
    if ! body=$(rest_get "/games/${game}/mods/${mod}/files/${file}/download_link.json${q}"); then
        warn "Download link for ${mod}/${file} refused: $(api_error_msg "$body")"
        return 1
    fi
    uri=$(jq -r --arg p "$PREFERRED_CDN" '
        (if $p != "" then (map(select(.short_name == $p or .name == $p)) | first) else null end // first(.[])) | .URI // empty' <<< "$body" 2>/dev/null || true)
    [[ -n "$uri" ]] || { warn "No download link returned for ${mod}/${file}"; return 1; }
    encode_uri "$uri"
}

# download_nexus_file <game> <modId> <fileId> [md5] [quiet] [nxm-key] [nxm-expires] → DL_RESULT
download_nexus_file() {
    local game="$1" mod="$2" file="$3" md5="${4:-}" quiet="${5:-}" key="${6:-}" exp="${7:-}" uri fname dest existing
    DL_RESULT=""
    if existing=$(find_download "$mod" "$file"); then DL_RESULT="$existing"; return 0; fi
    if [[ -z "$key" && "$IS_PREMIUM" != true ]]; then
        nxm_acquire "$game" "$mod" "$file" || return 1
        key="$NXM_KEY"; exp="$NXM_EXPIRES"
    fi
    uri=$(nexus_download_uri "$game" "$mod" "$file" "$key" "$exp") || return 1
    fname="${uri%%\?*}"; fname="${fname##*/}"
    fname=$(urldecode "$fname")
    if [[ "$fname" != *.* ]]; then
        # Newer CDN URLs are opaque ids; the real name is in Content-Disposition.
        fname=$(curl -gsIL -m 30 "$uri" 2>/dev/null | tr -d '\r' \
                | sed -n 's/^[Cc]ontent-[Dd]isposition:.*filename="\{0,1\}\([^";]*\)"\{0,1\}.*$/\1/p' | tail -1) || fname=""
        fname="${fname//\//_}"; fname="${fname#.}"
        [[ -n "$fname" ]] || fname="${mod}-${file}"
    fi
    dest="${DL_DIR}/${fname}"
    if [[ -f "$dest" && -n "$md5" ]] && [[ "$(md5sum -- "$dest" | cut -d' ' -f1)" != "$md5" ]]; then
        rm -f -- "$dest"
    fi
    if [[ ! -f "$dest" ]]; then
        [[ -z "$quiet" ]] && echo -e "  ${DIM}↓ ${fname}${RESET}"
        fetch_file "$uri" "$dest" "$md5" "$quiet" || { warn "Download failed: ${fname}"; return 1; }
    fi
    jq -n --arg f "$fname" --arg md5 "$md5" --arg mod "$mod" --arg file "$file" --arg game "$game" --argjson t "$(now)" \
        '{file: $f, md5: $md5, modId: ($mod | tonumber), fileId: ($file | tonumber), game: $game, downloaded: $t}' \
        > "$(dl_meta_path "$mod" "$file")"
    DL_RESULT="$dest"
}

# ══════════════════════════════════════════════════════════
# nxm:// links (free accounts get download keys from the website)
# ══════════════════════════════════════════════════════════
parse_nxm() {
    local url="$1"
    NXM_KIND=""; NXM_GAME=""; NXM_MOD=""; NXM_FILE=""; NXM_KEY=""; NXM_EXPIRES=""; NXM_SLUG=""; NXM_REV=""
    if [[ "$url" =~ ^nxm://([^/]+)/mods/([0-9]+)/files/([0-9]+) ]]; then
        NXM_KIND=mod; NXM_GAME="${BASH_REMATCH[1],,}"; NXM_MOD="${BASH_REMATCH[2]}"; NXM_FILE="${BASH_REMATCH[3]}"
        if [[ "$url" =~ [?\&]key=([^\&]+) ]]; then NXM_KEY="${BASH_REMATCH[1]}"; fi
        if [[ "$url" =~ [?\&]expires=([0-9]+) ]]; then NXM_EXPIRES="${BASH_REMATCH[1]}"; fi
        return 0
    fi
    if [[ "$url" =~ ^nxm://([^/]+)/collections/([a-zA-Z0-9]+)(/revisions/([0-9]+))? ]]; then
        NXM_KIND=collection; NXM_GAME="${BASH_REMATCH[1],,}"; NXM_SLUG="${BASH_REMATCH[2]}"; NXM_REV="${BASH_REMATCH[4]}"
        return 0
    fi
    return 1
}

NXM_DESKTOP="modman-nxm.desktop"
nxm_handler_registered() {
    have xdg-mime || return 1
    [[ "$(xdg-mime query default x-scheme-handler/nxm 2>/dev/null || true)" == "$NXM_DESKTOP" ]]
}

# Waits for the browser to hand us an nxm:// link for this file (free accounts).
nxm_acquire() {
    local game="$1" mod="$2" file="$3" qf waited=0 timeout="${MODMAN_NXM_TIMEOUT:-900}"
    qf="${NXM_QUEUE}/${game}-${mod}-${file}.nxm"
    if ! is_interactive && [[ "${MODMAN_NXM_HEADLESS:-0}" != 1 ]]; then
        warn "Free accounts must click \"Slow download\" on the website for every file — run this command in a terminal."
        return 1
    fi
    nxm_handler_registered || warn "modman is not the nxm:// handler yet — run: ${PROG} nxm register"
    echo "$$" > "${NXM_QUEUE}/waiting.pid"
    rm -f -- "$qf"
    echo -e "  ${YELLOW}➜${RESET} Click ${BOLD}\"Slow download\"${RESET} in your browser for mod ${mod} (file ${file}). Waiting…"
    open_url "${SITE_URL}/${game}/mods/${mod}?tab=files&file_id=${file}&nmm=1"
    while [[ ! -s "$qf" ]]; do
        sleep 1; waited=$(( waited + 1 ))
        if (( waited >= timeout )); then error "Timed out waiting for the nxm:// link."; return 1; fi
    done
    parse_nxm "$(cat "$qf")" || { rm -f -- "$qf"; return 1; }
    rm -f -- "$qf"
}

# ══════════════════════════════════════════════════════════
# Deployment engine
#   • every enabled mod is merged in priority order (later wins)
#   • paths are matched case-insensitively against the game folder
#     (Windows games under Proton expect that)
#   • original game files that get overridden are moved to backup/
#   • deployment.tsv records every placed file so purge only ever
#     removes files that modman put there and that are unchanged
# ══════════════════════════════════════════════════════════
declare -A P_OWNER=() P_SRC=() P_REL=() P_INO=() P_SIZE=() P_MT=() P_PROV=()
declare -A E_DIR=() E_FILE=() NEW_DIRS=()
PLAN_MODS=0
RD=""

resolve_method() {
    local m="${G_METHOD:-$DEPLOY_METHOD}"
    [[ -n "$m" ]] || m=auto
    if [[ "$m" == auto ]]; then
        local probe="${MODS_DIR}/.modman-probe.$$" target="${G_FOLDER}/.modman-probe.$$"
        echo probe > "$probe"
        if ln -- "$probe" "$target" 2>/dev/null; then m=hardlink; rm -f -- "$target"; else m=copy; fi
        rm -f -- "$probe"
    fi
    printf '%s' "$m"
}

build_plan() {
    P_OWNER=(); P_SRC=(); P_REL=(); P_INO=(); P_SIZE=(); P_MT=(); P_PROV=()
    PLAN_MODS=0
    local base id root dir prefix p ino size mt rel key
    base=$(deploy_base_rel)
    while IFS="$SEP" read -r id root; do
        [[ -n "$id" ]] || continue
        dir="${MODS_DIR}/${id}"
        if [[ ! -d "$dir" ]]; then warn "Staged files missing for ${id} — run: ${PROG} reinstall '${id}'"; continue; fi
        PLAN_MODS=$(( PLAN_MODS + 1 ))
        if [[ "$root" == game ]]; then prefix=""; else prefix="$base"; fi
        while IFS= read -r -d '' p && IFS= read -r -d '' ino && IFS= read -r -d '' size && IFS= read -r -d '' mt; do
            rel="${prefix}${p}"; key="${rel,,}"
            if [[ -n "${P_OWNER[$key]+x}" ]]; then
                P_PROV[$key]+="${SEP}${id}"
            else
                P_PROV[$key]="$id"; P_REL[$key]="$rel"
            fi
            P_OWNER[$key]="$id"; P_SRC[$key]="${dir}/${p}"
            P_INO[$key]="$ino"; P_SIZE[$key]="$size"; P_MT[$key]="$mt"
        done < <(find "$dir" -type f -printf '%P\0%i\0%s\0%Ts\0')
    done < <(jq -r "$JQ_DEFS"' .mods[] | select(.enabled) | [.id, .root] | row' "$DB_FILE")
}

# Index the parts of the game folder that the plan touches (lower-case → real spelling).
scan_game_folder() {
    E_DIR=(); E_FILE=(); NEW_DIRS=()
    local n nl p y k
    local -A want=()
    local -a tops=()
    for k in "${!P_REL[@]}"; do want["${k%%/*}"]=1; done
    while IFS= read -r -d '' n; do
        nl="${n,,}"
        if [[ -d "${G_FOLDER}/${n}" ]]; then
            E_DIR[$nl]="$n"
            [[ -n "${want[$nl]+x}" ]] && tops+=("$n")
        else
            E_FILE[$nl]="$n"
        fi
    done < <(find "$G_FOLDER" -mindepth 1 -maxdepth 1 -printf '%f\0')
    for n in "${tops[@]}"; do
        while IFS= read -r -d '' p && IFS= read -r -d '' y; do
            if [[ "$y" == d ]]; then E_DIR[${p,,}]="$p"; else E_FILE[${p,,}]="$p"; fi
        done < <(cd "$G_FOLDER" && find "$n" -mindepth 1 -printf '%p\0%y\0')
    done
}

# resolve_dir <rel-dir> → RD = spelling to use in the game folder (memoised, records new dirs)
resolve_dir() {
    local d="$1" lk="${1,,}" parent base
    if [[ -z "$d" ]]; then RD=""; return 0; fi
    if [[ -n "${E_DIR[$lk]+x}" ]]; then RD="${E_DIR[$lk]}"; return 0; fi
    if [[ "$d" == */* ]]; then parent="${d%/*}"; base="${d##*/}"; else parent=""; base="$d"; fi
    resolve_dir "$parent"
    if [[ -n "$RD" ]]; then RD="${RD}/${base}"; else RD="$base"; fi
    E_DIR[$lk]="$RD"; NEW_DIRS[$RD]=1
}

link_files() {   # link_files <method> <dest-dir> <src...>
    local method="$1" dest="$2"; shift 2
    case "$method" in
        hardlink) ln -t "$dest" -- "$@" ;;
        symlink)  ln -s -t "$dest" -- "$@" ;;
        copy)     cp --reflink=auto -p -t "$dest" -- "$@" ;;
    esac
}

link_one() {     # link_one <method> <src> <dest-file>
    case "$1" in
        hardlink) ln -- "$2" "$3" ;;
        symlink)  ln -s -- "$2" "$3" ;;
        copy)     cp --reflink=auto -p -- "$2" "$3" ;;
    esac
}

manifest_line() { printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$@"; }

deployment_active() { [[ -s "$MANIFEST" || -s "$BACKUP_LIST" ]]; }

# Removes the current deployment. Sets U_REMOVED U_CHANGED U_MISSING U_RESTORED U_KEPT.
undeploy() {
    U_REMOVED=0; U_CHANGED=0; U_MISSING=0; U_RESTORED=0; U_KEPT=0
    local t mod method ino size mt src p y l
    local -A M_METHOD=() M_INO=() M_SIZE=() M_MT=() M_SRC=() seen=()
    local -a del=() remain=()

    if [[ -s "$MANIFEST" ]]; then
        while IFS="$SEP" read -r t mod method ino size mt src; do
            [[ -n "$t" ]] || continue
            M_METHOD[$t]="$method"; M_INO[$t]="$ino"; M_SIZE[$t]="$size"; M_MT[$t]="$mt"; M_SRC[$t]="$src"
        done < "$MANIFEST"
    fi

    if (( ${#M_METHOD[@]} )); then
        while IFS= read -r -d '' p && IFS= read -r -d '' y && IFS= read -r -d '' ino \
              && IFS= read -r -d '' size && IFS= read -r -d '' mt && IFS= read -r -d '' l; do
            t="${p#"${G_FOLDER}/"}"
            seen[$t]=1
            local ok=0
            case "${M_METHOD[$t]:-}" in
                hardlink) [[ "$y" == f && "$ino" == "${M_INO[$t]}" ]] && ok=1 ;;
                copy)     [[ "$y" == f && "$size" == "${M_SIZE[$t]}" && "$mt" == "${M_MT[$t]}" ]] && ok=1 ;;
                symlink)  [[ "$y" == l && "$l" == "${M_SRC[$t]}" ]] && ok=1 ;;
            esac
            if (( ok )); then
                del+=("$p")
            elif [[ -e "${BACKUP_DIR}/${t}" ]]; then
                # The game (e.g. a Steam update/verify) replaced this file: keep it, retire the old backup.
                mkdir -p "${OVERWRITE_DIR}/.stale-backups/$(dirname "$t")"
                mv -f -- "${BACKUP_DIR}/${t}" "${OVERWRITE_DIR}/.stale-backups/${t}"
                U_CHANGED=$(( U_CHANGED + 1 ))
            else
                # Changed after deployment (e.g. a mod config written by the game): keep a copy in overwrite/.
                mkdir -p "${OVERWRITE_DIR}/$(dirname "$t")"
                mv -f -- "$p" "${OVERWRITE_DIR}/${t}"
                U_CHANGED=$(( U_CHANGED + 1 ))
            fi
        done < <(for t in "${!M_METHOD[@]}"; do printf '%s\0' "${G_FOLDER}/${t}"; done \
                   | find -files0-from - -maxdepth 0 -printf '%p\0%y\0%i\0%s\0%Ts\0%l\0' 2>/dev/null)
        U_MISSING=$(( ${#M_METHOD[@]} - ${#seen[@]} ))
        if (( ${#del[@]} )); then
            printf '%s\0' "${del[@]}" | xargs -0 -r rm -f --
            U_REMOVED=${#del[@]}
        fi
    fi

    # Put original game files back
    if [[ -s "$BACKUP_LIST" ]]; then
        while IFS= read -r t; do
            [[ -n "$t" && -e "${BACKUP_DIR}/${t}" ]] || continue
            if [[ -e "${G_FOLDER}/${t}" || -L "${G_FOLDER}/${t}" ]]; then
                remain+=("$t"); U_KEPT=$(( U_KEPT + 1 )); continue
            fi
            mkdir -p "$(dirname "${G_FOLDER}/${t}")"
            mv -- "${BACKUP_DIR}/${t}" "${G_FOLDER}/${t}"
            U_RESTORED=$(( U_RESTORED + 1 ))
        done < "$BACKUP_LIST"
        if (( ${#remain[@]} )); then printf '%s\n' "${remain[@]}" > "$BACKUP_LIST"; else : > "$BACKUP_LIST"; fi
    fi

    # Remove folders that modman created (deepest first; non-empty ones stay)
    if [[ -s "$DIRS_FILE" ]]; then
        LC_ALL=C sort -ru "$DIRS_FILE" | while IFS= read -r t; do
            [[ -n "$t" ]] && printf '%s\0' "${G_FOLDER}/${t}"
        done | xargs -0 -r rmdir --ignore-fail-on-non-empty -- 2>/dev/null || true
        : > "$DIRS_FILE"
    fi
    : > "$MANIFEST"
    plugins_remove_managed
    rm -f "${GDATA}/deployed.stamp"
}

cmd_deploy() {
    local dry=0 method_override=""
    while (( $# )); do
        case "$1" in
            -n|--dry-run) dry=1 ;;
            --method)     method_override="${2:-}"; shift ;;
            *)            die "Unknown option for deploy: $1" ;;
        esac
        shift
    done
    need_game
    require_game_folder
    acquire_lock
    [[ -w "$G_FOLDER" ]] || die "No write permission for ${G_FOLDER}"

    banner "Deploy — ${G_NAME}"
    local method
    method="${method_override:-$(resolve_method)}"
    case "$method" in hardlink|symlink|copy) ;; *) die "Invalid deploy method '${method}' (hardlink|symlink|copy)";; esac

    info "Building file plan..."
    build_plan
    local total=${#P_OWNER[@]} conflicts=0 k
    for k in "${!P_PROV[@]}"; do [[ "${P_PROV[$k]}" == *"$SEP"* ]] && conflicts=$(( conflicts + 1 )); done

    if (( total == 0 )); then
        if deployment_active && (( ! dry )); then
            info "No enabled mods — removing the previous deployment."
            undeploy
            success "Game folder is clean."
        else
            info "No enabled mods — nothing to deploy."
        fi
        return 0
    fi

    info "Mods    : ${BOLD}${PLAN_MODS}${RESET} enabled"
    info "Files   : ${BOLD}${total}${RESET}  (${conflicts} provided by more than one mod)"
    info "Method  : ${BOLD}${method}${RESET}"
    info "Target  : ${G_FOLDER}$( [[ -n "$(deploy_base_rel)" ]] && echo "  (mods go into $(deploy_base_rel))")"

    if (( dry )); then
        local -A current=()
        local t _rest
        if [[ -s "$MANIFEST" ]]; then
            while IFS="$SEP" read -r t _rest; do [[ -n "$t" ]] && current[${t,,}]=1; done < "$MANIFEST"
        fi
        scan_game_folder
        local overrides=0
        for k in "${!P_OWNER[@]}"; do
            [[ -n "${E_FILE[$k]+x}" && -z "${current[$k]+x}" ]] && overrides=$(( overrides + 1 ))
        done
        info "Game files that would be backed up and replaced: ${overrides}"
        success "Dry run — nothing changed."
        deps_check_enabled
        return 0
    fi

    if deployment_active; then
        info "Removing previous deployment..."
        undeploy
    fi

    scan_game_folder

    local key rel dpart base target src tdir errlog
    local -A batch=()
    local -a singles=() backups=()
    errlog="$(run_tmp)/deploy-errors.log"; : > "$errlog"
    : > "$MANIFEST"
    exec 8>>"$MANIFEST"
    for key in "${!P_OWNER[@]}"; do
        rel="${P_REL[$key]}"
        if [[ "$rel" == */* ]]; then dpart="${rel%/*}"; base="${rel##*/}"; else dpart=""; base="$rel"; fi
        resolve_dir "$dpart"; tdir="$RD"
        if [[ -n "${E_FILE[$key]+x}" ]]; then
            target="${E_FILE[$key]}"; backups+=("$target")
            base="${target##*/}"; tdir="${target%/*}"; [[ "$target" == */* ]] || tdir=""
        else
            target="${tdir:+${tdir}/}${base}"
        fi
        src="${P_SRC[$key]}"
        if [[ "${src##*/}" == "$base" ]]; then
            batch["${tdir:-.}"]+="${src}${SEP}"      # "." = game root (bash keys cannot be empty)
        else
            singles+=("${src}${SEP}${target}")
        fi
        manifest_line "$target" "${P_OWNER[$key]}" "$method" "${P_INO[$key]}" "${P_SIZE[$key]}" "${P_MT[$key]}" "$src" >&8
    done

    # 1) folders
    if (( ${#NEW_DIRS[@]} )); then
        printf '%s\n' "${!NEW_DIRS[@]}" >> "$DIRS_FILE"
        ( cd "$G_FOLDER" && printf '%s\0' "${!NEW_DIRS[@]}" | xargs -0 -r mkdir -p -- )
    fi

    # 2) back up original files that mods replace
    local t bdst nb=0
    for t in "${backups[@]}"; do
        bdst="${BACKUP_DIR}/${t}"
        if [[ -e "$bdst" ]]; then
            mkdir -p "$(dirname "${OVERWRITE_DIR}/${t}")"
            mv -f -- "${G_FOLDER}/${t}" "${OVERWRITE_DIR}/${t}"
        else
            mkdir -p "$(dirname "$bdst")"
            mv -- "${G_FOLDER}/${t}" "$bdst"
            printf '%s\n' "$t" >> "$BACKUP_LIST"
        fi
        nb=$(( nb + 1 ))
    done

    # 3) place files, one ln/cp call per folder
    local failed=0 done_dirs=0 ndirs=${#batch[@]} i f
    local -a files chunk
    for tdir in "${!batch[@]}"; do
        IFS="$SEP" read -r -a files <<< "${batch[$tdir]%"$SEP"}"
        [[ "$tdir" == . ]] && tdir=""
        local dest="$G_FOLDER"; [[ -n "$tdir" ]] && dest="${G_FOLDER}/${tdir}"
        for (( i = 0; i < ${#files[@]}; i += 400 )); do
            chunk=("${files[@]:i:400}")
            if ! link_files "$method" "$dest" "${chunk[@]}" 2>>"$errlog"; then
                # fall back to copying whatever did not get placed
                for f in "${chunk[@]}"; do
                    [[ -e "${dest}/${f##*/}" ]] && continue
                    if cp --reflink=auto -p -- "$f" "${dest}/${f##*/}" 2>>"$errlog"; then
                        local rt="${tdir:+${tdir}/}${f##*/}"
                        manifest_line "$rt" "${P_OWNER[${rt,,}]:-?}" copy "" "$(stat -c %s -- "$f")" "$(stat -c %Y -- "$f")" "$f" >&8
                    else
                        failed=$(( failed + 1 ))
                    fi
                done
            fi
        done
        done_dirs=$(( done_dirs + 1 ))
        if [[ -t 1 ]] && (( done_dirs % 50 == 0 )); then printf '\r  placing files… %d/%d folders' "$done_dirs" "$ndirs"; fi
    done
    [[ -t 1 ]] && (( ndirs >= 50 )) && printf '\r%*s\r' 60 ''
    local pair s
    for pair in "${singles[@]}"; do
        s="${pair%%"$SEP"*}"; t="${pair#*"$SEP"}"
        link_one "$method" "$s" "${G_FOLDER}/${t}" 2>>"$errlog" || failed=$(( failed + 1 ))
    done
    exec 8>&-
    now > "${GDATA}/deployed.stamp"

    plugins_update

    echo ""
    section "Deploy Summary"
    echo -e "  ${GREEN}Placed   :${RESET} $(( total - failed )) files from ${PLAN_MODS} mods (${method})"
    echo -e "  ${YELLOW}Backed up:${RESET} ${nb} original game files → ${BACKUP_DIR}"
    if (( failed )); then
        echo -e "  ${RED}Failed   :${RESET} ${failed}  (see ${NMM_LOG})"
        sed 's/^/    /' "$errlog" | head -20 >> "$NMM_LOG" || true
    fi
    echo ""
    _log INFO "Deployed ${total} files from ${PLAN_MODS} mods (${method}), failed=${failed}"
    success "Deployment complete. Undo anytime with: ${PROG} purge"
    deps_check_enabled
}

cmd_purge() {
    local legacy=0
    while (( $# )); do
        case "$1" in --legacy) legacy=1 ;; *) die "Unknown option for purge: $1" ;; esac
        shift
    done
    need_game
    require_game_folder
    acquire_lock
    banner "Purge — ${G_NAME}" "$RED"

    if [[ -s "$LEGACY_MANIFEST" ]]; then
        purge_legacy
    fi
    if ! deployment_active; then
        info "Nothing is deployed for ${G_NAME}."
        return 0
    fi
    local n; n=$(grep -c . "$MANIFEST" 2>/dev/null || true)
    echo -e "  ${n:-0} deployed files will be removed and original game files restored."
    confirm "Purge all deployed mods from the game folder?" Y || { info "Purge cancelled."; return 0; }
    undeploy
    echo ""
    section "Purge Summary"
    echo -e "  ${GREEN}Removed  :${RESET} ${U_REMOVED} files"
    echo -e "  ${GREEN}Restored :${RESET} ${U_RESTORED} original game files"
    (( U_MISSING )) && echo -e "  ${YELLOW}Missing  :${RESET} ${U_MISSING} (already gone)"
    (( U_CHANGED )) && echo -e "  ${YELLOW}Changed  :${RESET} ${U_CHANGED} files modified after deploy → ${OVERWRITE_DIR}"
    (( U_KEPT )) && echo -e "  ${YELLOW}Kept     :${RESET} ${U_KEPT} backups (the game replaced those files) → ${BACKUP_DIR}"
    echo ""
    success "Purge complete. Game folder is back to vanilla (plus anything the game itself wrote)."
}

# v2 deployed whole folders into <game>/mods — clean those up once.
purge_legacy() {
    warn "Found a deployment made by modman v2 (${LEGACY_MANIFEST}):"
    local fname path _src
    while IFS='|' read -r fname path _src; do
        [[ -n "$path" ]] && echo -e "    ${RED}✗${RESET} ${path}"
    done < "$LEGACY_MANIFEST"
    if confirm "Remove these v2 folders?" Y; then
        while IFS='|' read -r fname path _src; do
            [[ -n "$path" && -d "$path" && "$path" == "${G_FOLDER}"/* ]] && rm -rf -- "$path"
        done < "$LEGACY_MANIFEST"
        : > "$LEGACY_MANIFEST"
        rmdir "${G_FOLDER}/mods" 2>/dev/null || true
        success "v2 deployment removed."
    fi
}

cmd_verify() {
    need_game
    require_game_folder
    banner "Verify deployment — ${G_NAME}"
    if [[ ! -s "$MANIFEST" ]]; then info "Nothing is deployed."; return 0; fi
    local t mod method ino size mt src p y l ok=0 bad=0 missing=0
    local -A M_METHOD=() M_INO=() M_SIZE=() M_MT=() M_SRC=() M_MOD=() seen=()
    local -a problems=()
    while IFS="$SEP" read -r t mod method ino size mt src; do
        [[ -n "$t" ]] || continue
        M_METHOD[$t]="$method"; M_INO[$t]="$ino"; M_SIZE[$t]="$size"; M_MT[$t]="$mt"; M_SRC[$t]="$src"; M_MOD[$t]="$mod"
    done < "$MANIFEST"
    while IFS= read -r -d '' p && IFS= read -r -d '' y && IFS= read -r -d '' ino \
          && IFS= read -r -d '' size && IFS= read -r -d '' mt && IFS= read -r -d '' l; do
        t="${p#"${G_FOLDER}/"}"; seen[$t]=1
        local good=0
        case "${M_METHOD[$t]}" in
            hardlink) [[ "$y" == f && "$ino" == "${M_INO[$t]}" ]] && good=1 ;;
            copy)     [[ "$y" == f && "$size" == "${M_SIZE[$t]}" && "$mt" == "${M_MT[$t]}" ]] && good=1 ;;
            symlink)  [[ "$y" == l && "$l" == "${M_SRC[$t]}" && -e "$p" ]] && good=1 ;;
        esac
        if (( good )); then ok=$(( ok + 1 )); else bad=$(( bad + 1 )); problems+=("changed  ${t}  (${M_MOD[$t]})"); fi
    done < <(for t in "${!M_METHOD[@]}"; do printf '%s\0' "${G_FOLDER}/${t}"; done \
               | find -files0-from - -maxdepth 0 -printf '%p\0%y\0%i\0%s\0%Ts\0%l\0' 2>/dev/null)
    for t in "${!M_METHOD[@]}"; do
        [[ -n "${seen[$t]+x}" ]] || { missing=$(( missing + 1 )); problems+=("missing  ${t}  (${M_MOD[$t]})"); }
    done
    echo -e "  ${GREEN}Intact :${RESET} ${ok}"
    echo -e "  ${YELLOW}Changed:${RESET} ${bad}"
    echo -e "  ${RED}Missing:${RESET} ${missing}"
    if (( ${#problems[@]} )); then
        echo ""
        printf '%s\n' "${problems[@]}" | sort | head -40 | sed 's/^/    /'
        (( ${#problems[@]} > 40 )) && echo "    … and $(( ${#problems[@]} - 40 )) more"
        echo ""
        info "Run '${PROG} deploy' to repair the deployment."
        return 1
    fi
    if [[ "$DB_FILE" -nt "${GDATA}/deployed.stamp" ]]; then
        warn "Mods changed since the last deploy — run: ${PROG} deploy"
    fi
    success "Deployment is intact."
}

# ── Conflicts ─────────────────────────────────────────────
cmd_conflicts() {
    need_game
    local filter="" show_files=0
    while (( $# )); do
        case "$1" in
            -f|--files) show_files=1 ;;
            *) filter=$(resolve_mod "$1") || exit 1 ;;
        esac
        shift
    done
    build_plan
    local -A NAME=() POS=() pair=() pfiles=()
    local id name pos key prov winner l i
    while IFS="$SEP" read -r id name pos; do NAME[$id]="$name"; POS[$id]="$pos"; done \
        < <(jq -r "$JQ_DEFS"' .mods | to_entries[] | [.value.id, .value.name, (.key + 1)] | row' "$DB_FILE")
    local -a arr
    for key in "${!P_PROV[@]}"; do
        prov="${P_PROV[$key]}"
        [[ "$prov" == *"$SEP"* ]] || continue
        IFS="$SEP" read -r -a arr <<< "$prov"
        winner="${arr[-1]}"
        for (( i = 0; i < ${#arr[@]} - 1; i++ )); do
            l="${arr[i]}"
            [[ "$l" == "$winner" ]] && continue
            [[ -n "$filter" && "$l" != "$filter" && "$winner" != "$filter" ]] && continue
            pair["${l}${SEP}${winner}"]=$(( ${pair["${l}${SEP}${winner}"]:-0} + 1 ))
            (( show_files )) && pfiles["${l}${SEP}${winner}"]+="${P_REL[$key]}${SEP}"
        done
    done
    banner "File conflicts — ${G_NAME}"
    if (( ${#pair[@]} == 0 )); then
        success "No file conflicts between enabled mods${filter:+ involving ${NAME[$filter]}}."
        return 0
    fi
    local k loser cnt
    while IFS="$SEP" read -r cnt loser winner; do
        printf "  ${DIM}#%-4s${RESET} %-38s ${YELLOW}◀ overridden by${RESET}  ${DIM}#%-4s${RESET} %s  ${DIM}(%d files)${RESET}\n" \
            "${POS[$loser]}" "$(trunc "${NAME[$loser]}" 38)" "${POS[$winner]}" "$(trunc "${NAME[$winner]}" 38)" "$cnt"
        if (( show_files )); then
            local -a fl
            IFS="$SEP" read -r -a fl <<< "${pfiles["${loser}${SEP}${winner}"]%"$SEP"}"
            printf '%s\n' "${fl[@]}" | sort | head -25 | sed "s/^/          ${DIM}/; s/\$/${RESET}/"
            (( ${#fl[@]} > 25 )) && echo -e "          ${DIM}… $(( ${#fl[@]} - 25 )) more${RESET}"
        fi
    done < <(for k in "${!pair[@]}"; do
                 loser="${k%%"$SEP"*}"; winner="${k#*"$SEP"}"
                 printf '%s\x1f%s\x1f%s\x1f%s\n' "${POS[$winner]}" "${pair[$k]}" "$loser" "$winner"
             done | sort -t"$SEP" -k1,1n | cut -d"$SEP" -f2-)
    echo ""
    info "${#pair[@]} conflicting mod pair(s). Higher position wins — change it with: ${PROG} order <mod> <position>"
}

# ── Bethesda plugins.txt ──────────────────────────────────
plugins_file() {
    [[ "$G_PROFILE" == bethesda && -n "$G_PLUGINS_FMT" ]] || return 1
    if [[ -n "$G_PLUGINS" ]]; then printf '%s' "$G_PLUGINS"; return 0; fi
    detect_plugins_file
}

plugins_update() {
    local pf
    pf=$(plugins_file) || return 0
    if [[ ! -d "${pf%/*}" ]]; then
        warn "plugins.txt folder not found (${pf%/*}). Launch the game once, then run '${PROG} deploy' again."
        return 0
    fi
    local base id root dir pdir n
    local -a ours=()
    local -A seen=()
    base=$(deploy_base_rel)
    while IFS="$SEP" read -r id root; do
        dir="${MODS_DIR}/${id}"; pdir="$dir"
        if [[ "$root" == game ]]; then
            pdir=$(find "$dir" -mindepth 1 -maxdepth 1 -type d -iname "${base%/}" -print -quit 2>/dev/null || true)
            [[ -n "$pdir" ]] || continue
        fi
        while IFS= read -r -d '' n; do
            [[ -n "${seen[${n,,}]+x}" ]] && continue
            seen[${n,,}]=1; ours+=("$n")
        done < <(find "$pdir" -mindepth 1 -maxdepth 1 -type f \( -iname '*.esm' -o -iname '*.esl' -o -iname '*.esp' \) -printf '%f\0' 2>/dev/null | sort -z)
    done < <(jq -r "$JQ_DEFS"' .mods[] | select(.enabled) | [.id, .root] | row' "$DB_FILE")
    (( ${#ours[@]} )) || return 0

    [[ -f "$pf" && ! -f "${GDATA}/plugins.txt.orig" ]] && cp -p -- "$pf" "${GDATA}/plugins.txt.orig"
    local -a existing=() added=()
    local -A have=()
    local line nm
    if [[ -f "$pf" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%$'\r'}"
            [[ -z "$line" || "$line" == \#* ]] && continue
            existing+=("$line"); nm="${line#\*}"; have[${nm,,}]=1
        done < "$pf"
    fi
    for n in "${ours[@]}"; do [[ "${n,,}" == *.esm || "${n,,}" == *.esl ]] && [[ -z "${have[${n,,}]+x}" ]] && added+=("$n"); done
    for n in "${ours[@]}"; do [[ "${n,,}" == *.esp ]] && [[ -z "${have[${n,,}]+x}" ]] && added+=("$n"); done
    {
        printf '# This file is used by the game to keep track of your downloaded content.\r\n'
        printf '# Please do not modify this file. (entries marked by modman are removed on purge)\r\n'
        for line in "${existing[@]}"; do printf '%s\r\n' "$line"; done
        for n in "${added[@]}"; do
            if [[ "$G_PLUGINS_FMT" == star ]]; then printf '*%s\r\n' "$n"; else printf '%s\r\n' "$n"; fi
        done
    } > "${pf}.modman.tmp"
    mv -f -- "${pf}.modman.tmp" "$pf"
    (( ${#added[@]} )) && printf '%s\n' "${added[@]}" > "$PLUGINS_MANAGED"
    info "plugins.txt: ${#added[@]} plugin(s) activated (${#ours[@]} provided by mods). Use LOOT for fine-grained sorting."
}

plugins_remove_managed() {
    [[ -s "${PLUGINS_MANAGED:-}" ]] || return 0
    local pf line nm
    local -A managed=()
    pf=$(plugins_file) || { : > "$PLUGINS_MANAGED"; return 0; }
    if [[ -f "$pf" ]]; then
        while IFS= read -r nm; do [[ -n "$nm" ]] && managed[${nm,,}]=1; done < "$PLUGINS_MANAGED"
        {
            while IFS= read -r line || [[ -n "$line" ]]; do
                line="${line%$'\r'}"; nm="${line#\*}"
                [[ -n "$line" && -n "${managed[${nm,,}]+x}" ]] && continue
                printf '%s\r\n' "$line"
            done < "$pf"
        } > "${pf}.modman.tmp"
        mv -f -- "${pf}.modman.tmp" "$pf"
    fi
    : > "$PLUGINS_MANAGED"
}

