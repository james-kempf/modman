KNOWN_PROFILES="cyberpunk bethesda stardew bannerlord witcher3 bepinex melonloader ue generic"

game_defaults() {
    local domain="$1" preset fmt
    G_DOMAIN="$domain"; G_NAME="$domain"; G_FOLDER=""; G_SUBDIR="."; G_APPID=""
    G_PROFILE="generic"; G_PLUGINS=""; G_PLUGINS_FMT=""; G_EXTRA=""; G_METHOD=""; G_PREFIX=""; G_NEXUS_ID=""
    if preset=$(game_preset "$domain"); then
        IFS='|' read -r G_NAME G_APPID G_SUBDIR G_PROFILE G_EXTRA <<< "$preset"
        if [[ "$G_PROFILE" == bethesda && "$G_EXTRA" == *:* ]]; then
            G_PLUGINS_FMT="${G_EXTRA%%:*}"
        fi
    fi
    return 0
}

save_game() {
    local domain="$1" f="${GAMES_DIR}/${1}.cfg" k
    mkdir -p "$GAMES_DIR"
    {
        echo "# modman game profile for ${domain}"
        for k in G_DOMAIN G_NAME G_FOLDER G_SUBDIR G_APPID G_PROFILE G_PLUGINS G_PLUGINS_FMT G_EXTRA G_METHOD G_PREFIX G_NEXUS_ID; do
            printf '%s=%q\n' "$k" "${!k}"
        done
    } > "${f}.tmp"
    mv -f "${f}.tmp" "$f"
}

game_exists() { [[ -f "${GAMES_DIR}/${1}.cfg" ]]; }

list_game_domains() {
    local f
    for f in "${GAMES_DIR}"/*.cfg; do
        [[ -f "$f" ]] || continue
        f="${f##*/}"; echo "${f%.cfg}"
    done
}

# Loads a game profile and sets all per-game paths.
load_game() {
    local domain="$1"
    game_exists "$domain" || die "Game '${domain}' is not set up. Run: ${PROG} game add ${domain}"
    game_defaults "$domain"
    # shellcheck source=/dev/null
    source "${GAMES_DIR}/${domain}.cfg"
    G_DOMAIN="$domain"
    GDATA="${DATA_DIR}/${domain}"
    MODS_DIR="${GDATA}/mods"
    DL_DIR="${GDATA}/downloads"
    COL_DIR="${GDATA}/collections"
    BACKUP_DIR="${GDATA}/backup"
    OVERWRITE_DIR="${GDATA}/overwrite"
    PROFILES_DIR="${GDATA}/profiles"
    CACHE_DIR="${GDATA}/cache"
    TMP_DIR="${GDATA}/.tmp"
    DB_FILE="${GDATA}/mods.json"
    MANIFEST="${GDATA}/deployment.tsv"
    DIRS_FILE="${GDATA}/deployment.dirs"
    BACKUP_LIST="${GDATA}/backup.list"
    PLUGINS_MANAGED="${GDATA}/plugins.managed"
    mkdir -p "$MODS_DIR" "$DL_DIR/.meta" "$COL_DIR" "$BACKUP_DIR" "$PROFILES_DIR" "$CACHE_DIR" "$TMP_DIR"
    db_init
}

# Active game: -g flag, then config, else the only configured game.
need_game() {
    local domain="${FORCE_GAME:-$GAME_DOMAIN}"
    if [[ -z "$domain" ]]; then
        local games; games=$(list_game_domains)
        if [[ $(grep -c . <<< "$games") -eq 1 ]]; then domain="$games"; fi
    fi
    [[ -n "$domain" ]] || die "No game selected. Run: ${PROG} game add <domain>  (or ${PROG} login)"
    load_game "$domain"
}

require_game_folder() {
    [[ -n "$G_FOLDER" ]] || die "Game folder for ${G_DOMAIN} is not set. Run: ${PROG} game set folder <path>"
    [[ -d "$G_FOLDER" ]] || die "Game folder does not exist: ${G_FOLDER}"
}

deploy_base_rel() {   # relative path from game folder to the default deploy root, with trailing slash
    local s="${G_SUBDIR:-.}"
    s="${s#./}"; s="${s%/}"
    [[ -z "$s" || "$s" == "." ]] && return 0
    printf '%s/' "$s"
}

# ── Steam Detection ───────────────────────────────────────
steam_roots() {
    local r
    for r in "${HOME}/.local/share/Steam" "${HOME}/.steam/steam" "${HOME}/.steam/root" \
             "${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam" \
             "${HOME}/snap/steam/common/.local/share/Steam"; do
        [[ -d "${r}/steamapps" ]] && readlink -f "$r"
    done | sort -u
}

steam_libraries() {
    local root vdf p
    while IFS= read -r root; do
        [[ -n "$root" ]] || continue
        echo "$root"
        vdf="${root}/steamapps/libraryfolders.vdf"
        [[ -f "$vdf" ]] || continue
        while IFS= read -r p; do
            p="${p//\\\\/\/}"
            [[ -d "${p}/steamapps" ]] && readlink -f "$p"
        done < <(sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$vdf")
    done < <(steam_roots) | sort -u
}

# Prints the install folder of a Steam app id (empty if not installed).
steam_app_dir() {
    local appid="$1" lib acf dir
    [[ -n "$appid" ]] || return 1
    while IFS= read -r lib; do
        acf="${lib}/steamapps/appmanifest_${appid}.acf"
        [[ -f "$acf" ]] || continue
        dir=$(sed -n 's/^[[:space:]]*"installdir"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$acf" | head -1) || true
        [[ -n "$dir" && -d "${lib}/steamapps/common/${dir}" ]] && { echo "${lib}/steamapps/common/${dir}"; return 0; }
    done < <(steam_libraries)
    return 1
}

steam_prefix() {
    local appid="$1" lib
    [[ -n "$appid" ]] || return 1
    while IFS= read -r lib; do
        [[ -d "${lib}/steamapps/compatdata/${appid}/pfx" ]] && { echo "${lib}/steamapps/compatdata/${appid}/pfx"; return 0; }
    done < <(steam_libraries)
    return 1
}

# plugins.txt location for Bethesda games under Proton
detect_plugins_file() {
    [[ "$G_PROFILE" == bethesda && "$G_EXTRA" == *:* ]] || return 1
    local pfx="${G_PREFIX:-}"
    [[ -n "$pfx" ]] || pfx=$(steam_prefix "$G_APPID") || return 1
    echo "${pfx}/drive_c/users/steamuser/AppData/Local/${G_EXTRA#*:}/plugins.txt"
}

# ── REST / GraphQL Helpers ────────────────────────────────
# api_request METHOD URL [JSON-BODY] → prints body; non-zero on HTTP error.
api_request() {
    local method="$1" url="$2" data="${3:-}" attempt=0 raw code body hdr
    hdr="$(run_tmp)/hdr.$$.$RANDOM"
    while :; do
        attempt=$(( attempt + 1 ))
        local args=(-sS -m 90 -X "$method" -D "$hdr" -w $'\n%{http_code}'
                    -H "Accept: application/json"
                    -H "Application-Name: modman"
                    -H "Application-Version: ${MODMAN_VERSION}"
                    -H "User-Agent: modman/${MODMAN_VERSION} (Linux; bash)")
        [[ -n "$NEXUS_API_KEY" ]] && args+=(-H "apikey: ${NEXUS_API_KEY}")
        [[ -n "$data" ]] && args+=(-H "Content-Type: application/json" --data-binary "$data")
        raw=$(curl "${args[@]}" "$url" 2>/dev/null) || raw=$'\n000'
        code="${raw##*$'\n'}"; body="${raw%$'\n'*}"
        if [[ -f "$hdr" ]]; then
            awk 'BEGIN{IGNORECASE=1}
                 tolower($1)=="x-rl-hourly-remaining:" {h=$2}
                 tolower($1)=="x-rl-daily-remaining:"  {d=$2}
                 END { gsub(/\r/,"",h); gsub(/\r/,"",d); if (h!="" || d!="") print h, d, systime() }' \
                "$hdr" > "${RATELIMIT_FILE}.new" 2>/dev/null || true
            [[ -s "${RATELIMIT_FILE}.new" ]] && mv -f "${RATELIMIT_FILE}.new" "$RATELIMIT_FILE" || rm -f "${RATELIMIT_FILE}.new"
            rm -f "$hdr"
        fi
        case "$code" in
            2??) printf '%s' "$body"; return 0 ;;
            429)
                if (( attempt < 4 )); then
                    warn "Nexus rate limit hit — waiting $(( attempt * 15 ))s before retrying..."
                    sleep $(( attempt * 15 )); continue
                fi ;;
            5??|000)
                if (( attempt < 4 )); then sleep $(( attempt * 2 )); continue; fi ;;
        esac
        break
    done
    debug "HTTP ${code} for ${method} ${url%%\?*}"
    printf '%s' "$body"
    return 1
}

api_error_msg() {   # extracts a readable message from an API error body
    local body="$1" msg
    msg=$(jq -r '.message // .error // (.errors[0].message?) // empty' <<< "$body" 2>/dev/null || true)
    [[ -n "$msg" ]] || msg="${body:0:200}"
    [[ -n "$msg" ]] || msg="no response (network error?)"
    printf '%s' "$msg"
}

rest_get() { api_request GET "${REST_BASE}$1"; }

# gql_query 'query' '{"var":"val"}' → prints .data JSON; non-zero on errors
gql_query() {
    local query="$1" variables="${2:-}" payload resp
    [[ -z "${variables// }" ]] && variables="{}"
    payload=$(jq -cn --arg q "$query" --argjson v "$variables" '{query: $q, variables: $v}')
    resp=$(api_request POST "$GQL_ENDPOINT" "$payload") || { printf '%s' "$resp"; return 1; }
    if jq -e '.errors and (.errors | length > 0)' <<< "$resp" >/dev/null 2>&1; then
        printf '%s' "$resp"; return 1
    fi
    jq -c '.data' <<< "$resp"
}

ratelimit_summary() {
    [[ -f "$RATELIMIT_FILE" ]] || { echo "unknown"; return; }
    local h d t; read -r h d t < "$RATELIMIT_FILE" || true
    echo "${h:-?} hourly / ${d:-?} daily requests left (as of $(fmt_date "${t:-0}"))"
}

refresh_account() {   # updates NEXUS_USER / IS_PREMIUM from the API
    local body
    body=$(rest_get "/users/validate.json") || return 1
    NEXUS_USER=$(jq -r '.name // ""' <<< "$body")
    IS_PREMIUM=$(jq -r 'if .is_premium then "true" else "false" end' <<< "$body")
    save_config
}

# ══════════════════════════════════════════════════════════
# Mod database  (<data-dir>/<game>/mods.json)
#   .mods[]        installed mods; array order = priority (last wins)
#   .collections{} installed collections keyed by slug
# ══════════════════════════════════════════════════════════
# jq helper: row of fields joined by \x1f (keeps empty fields intact for `read`)
JQ_DEFS='def row: map(if . == null then "" else tostring end | gsub("[\n\r\t\u001f]"; " ")) | join("\u001f");'

db_init() {
    [[ -f "$DB_FILE" ]] || echo '{"version":1,"mods":[],"collections":{}}' > "$DB_FILE"
}

db_update() {   # db_update [jq args...] 'filter'
    local tmp="${DB_FILE}.tmp.$$"
    if jq "$@" "$DB_FILE" > "$tmp"; then
        mv -f "$tmp" "$DB_FILE"
    else
        rm -f "$tmp"; die "Failed to update the mod database"
    fi
}

db_get()  { jq -c --arg id "$1" '.mods[] | select(.id == $id)' "$DB_FILE"; }
db_has()  { jq -e --arg id "$1" 'any(.mods[]; .id == $id)' "$DB_FILE" >/dev/null; }
db_count() { jq "${1:-.mods} | length" "$DB_FILE"; }

JQ_RESOLVE='
def lc: ascii_downcase;
.mods as $m | ($r | lc) as $q |
(if ($r | test("^#[0-9]+$")) then (($r[1:] | tonumber) as $n | if $n >= 1 then [ $m[$n - 1] // empty ] else [] end) else [] end) as $a |
[ $m[] | select(.id == $r) ] as $b |
[ $m[] | select((.name // "" | lc) == $q) ] as $c |
(if ($r | test("^[0-9]+$")) then [ $m[] | select((.modId // "" | tostring) == $r) ] else [] end) as $d |
[ $m[] | select(((.name // "") | lc | contains($q)) or (.id | lc | contains($q))) ] as $e |
(first([$a, $b, $c, $d, $e][] | select(length > 0)) // []) | .[].id'

# resolve_mod <ref> → mod id. ref = #position | id | name | nexus mod id | unique substring
resolve_mod() {
    local ref="$1" out n
    out=$(jq -r --arg r "$ref" "$JQ_RESOLVE" "$DB_FILE")
    n=$(grep -c . <<< "$out" || true)
    if (( n == 0 )); then
        error "No installed mod matches '${ref}'. See: ${PROG} list"; return 1
    fi
    if (( n > 1 )); then
        error "'${ref}' matches ${n} mods — use #position or the full id:"
        local id pos
        while IFS= read -r id; do
            pos=$(jq -r --arg id "$id" '.mods | map(.id) | index($id) + 1' "$DB_FILE")
            echo -e "    ${CYAN}#${pos}${RESET}  ${id}" >&2
        done <<< "$out"
        return 1
    fi
    printf '%s' "$out"
}

# Inserts or updates a mod record ($m). $rep = id of an older install it replaces.
JQ_UPSERT='
def merged($old): $m + {enabled: ($old.enabled // true),
                        collections: ((($old.collections // []) + ($m.collections // [])) | unique)};
if any(.mods[]; .id == $m.id) then
    (.mods[] | select(.id == $m.id)) as $old
    | .mods |= map(if .id == $m.id then merged($old) else . end)
    | if ($rep != "" and $rep != $m.id) then .mods |= map(select(.id != $rep)) else . end
elif ($rep != "" and any(.mods[]; .id == $rep)) then
    (.mods[] | select(.id == $rep)) as $old
    | .mods |= map(if .id == $rep then merged($old) else . end)
else
    .mods += [$m + {enabled: true}]
end
| if $rep != "" then .collections |= map_values(.mods |= ((map(if . == $rep then $m.id else . end)) | unique)) else . end'

# ══════════════════════════════════════════════════════════
# Archive extraction
# ══════════════════════════════════════════════════════════
archive_kind() {
    local f="$1" l="${1,,}" m
    case "$l" in
        *.zip) echo zip ;;
        *.7z)  echo 7z ;;
        *.rar) echo rar ;;
        *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar.zst) echo tar ;;
        *)
            m=$(file -b -- "$f" 2>/dev/null || true)
            case "$m" in
                *Zip\ archive*) echo zip ;;
                *7-zip*)        echo 7z ;;
                *RAR\ archive*) echo rar ;;
                *tar\ archive*|*gzip*|*XZ\ compressed*|*bzip2*|*Zstandard*) echo tar ;;
                *) echo unknown ;;
            esac ;;
    esac
}

extract_archive() {
    local f="$1" dest="$2" kind ok=1 log
    mkdir -p "$dest"
    if [[ -d "$f" ]]; then   # bundled folders in collections
        cp -a -- "$f/." "$dest/"; return 0
    fi
    kind=$(archive_kind "$f")
    log="$(run_tmp)/extract.log"; : > "$log"
    case "$kind" in
        zip|7z)
            if [[ -n "$SEVENZ" ]]; then "$SEVENZ" x -y -bd -bso0 -bsp0 -o"$dest" -- "$f" >>"$log" 2>&1 && ok=0; fi
            if (( ok )) && have bsdtar; then bsdtar -xf "$f" -C "$dest" >>"$log" 2>&1 && ok=0; fi
            if (( ok )) && [[ "$kind" == zip ]] && have unzip; then unzip -qo "$f" -d "$dest" >>"$log" 2>&1 && ok=0; fi ;;
        rar)
            if have unrar; then unrar x -o+ -y -idq -- "$f" "$dest/" >>"$log" 2>&1 && ok=0; fi
            if (( ok )) && have bsdtar; then bsdtar -xf "$f" -C "$dest" >>"$log" 2>&1 && ok=0; fi
            if (( ok )) && [[ -n "$SEVENZ" ]]; then "$SEVENZ" x -y -bd -bso0 -bsp0 -o"$dest" -- "$f" >>"$log" 2>&1 && ok=0; fi ;;
        tar)
            tar -xf "$f" -C "$dest" --no-same-owner --no-same-permissions >>"$log" 2>&1 && ok=0 ;;
        *)
            error "Unrecognised archive format: ${f##*/}"; return 1 ;;
    esac
    if (( ok )); then
        error "Extraction failed: ${f##*/}"
        tail -5 "$log" | sed 's/^/        /' >&2
        if [[ "$kind" == rar ]] && ! have unrar; then
            warn "RAR support: install unrar or bsdtar — $(pkg_hint unrar)"
        fi
        return 1
    fi
    # Archives are untrusted: drop links/special files, normalise permissions.
    find "$dest" \( -type l -o -type p -o -type s -o -type b -o -type c \) -delete 2>/dev/null || true
    chmod -R u+rwX "$dest" 2>/dev/null || true
}

# ══════════════════════════════════════════════════════════
# Layout detection — turns an extracted archive into a folder
# whose structure mirrors the deploy root of the game.
# ══════════════════════════════════════════════════════════
DOC_RE='\.(txt|md|pdf|jpe?g|png|gif|webp|bmp|url|html?|rtf|docx?|nfo|log)$'
is_doc() { [[ "${1,,}" =~ $DOC_RE ]]; }

profile_tops() {
    case "$1" in
        cyberpunk)   echo " archive bin engine r6 red4ext mods tools " ;;
        bethesda)    echo " meshes textures scripts interface sound music strings video seq grass lodsettings shadersfx materials mcm skse f4se sfse nvse obse fose dialogueviews calientetools netscriptframework nemesis_engine platform distantlod lsdata fonts vis terrain facegen trees lightplacer actors sky lod shaders source pbrnifpatcher pbrtexturesets parallaxgen dyndolod splashes icons bookart menus characters creatures " ;;
        bepinex)     echo " bepinex doorstop_libs unstripped_corlib " ;;
        melonloader) echo " mods plugins userdata userlibs melonloader " ;;
        witcher3)    echo " mods dlc bin content " ;;
        ue)          local p="${G_EXTRA%%/*}"; echo " ${p,,} engine " ;;
        *)           echo " " ;;
    esac
}

list_entries() {   # fills ENT with the names inside a directory
    ENT=()
    mapfile -d '' -t ENT < <(find "$1" -mindepth 1 -maxdepth 1 -printf '%f\0' | sort -z)
}

dir_has_top() {    # does this folder already look like the deploy root?
    local d="$1" n nl
    list_entries "$d"
    for n in "${ENT[@]}"; do
        nl="${n,,}"
        if [[ -d "$d/$n" ]]; then
            [[ "$TOPS" == *" $nl "* ]] && return 0
        else
            [[ "$G_PROFILE" == bethesda && "$nl" =~ \.(esp|esm|esl|bsa|ba2)$ ]] && return 0
            [[ "$G_PROFILE" == bepinex && ( "$nl" == winhttp.dll || "$nl" == doorstop_config.ini ) ]] && return 0
        fi
    done
    return 1
}

has_file_like() { [[ -n "$(find "$1" -type f -iname "$2" -print -quit 2>/dev/null)" ]]; }

# Moves src to dst, merging into an existing directory.
merge_into() {
    local src="$1" dst="$2"
    if [[ ! -e "$dst" && ! -L "$dst" ]]; then
        mkdir -p -- "${dst%/*}"
        mv -- "$src" "$dst"
    elif [[ -d "$src" && -d "$dst" ]]; then
        cp -a --remove-destination -- "$src/." "$dst/"
        rm -rf -- "$src"
    else
        rm -rf -- "$dst"
        mv -- "$src" "$dst"
    fi
}

place_all() {      # place_all <src> <out> <skip-root-docs 0|1>
    local src="$1" out="$2" skipdocs="${3:-1}" n
    list_entries "$src"
    local ents=("${ENT[@]}")
    for n in "${ents[@]}"; do
        if [[ "$skipdocs" == 1 && -f "$src/$n" ]] && is_doc "$n"; then continue; fi
        merge_into "$src/$n" "$out/$n"
    done
}

layout_cyberpunk() {
    local src="$1" out="$2" mod="$3" n nl p f structured=0
    local CET="bin/x64/plugins/cyber_engine_tweaks/mods"
    if [[ -f "$src/init.lua" ]] && ! dir_has_top "$src"; then
        merge_into "$src" "$out/$CET/$mod"; return 0
    fi
    dir_has_top "$src" && structured=1
    list_entries "$src"
    local ents=("${ENT[@]}")
    for n in "${ents[@]}"; do
        nl="${n,,}"; p="$src/$n"
        if [[ -d "$p" ]]; then
            if [[ "$TOPS" == *" $nl "* ]]; then
                merge_into "$p" "$out/$n"
            elif [[ -f "$p/init.lua" ]]; then
                merge_into "$p" "$out/$CET/$n"
            elif has_file_like "$p" '*.reds'; then
                merge_into "$p" "$out/r6/scripts/$n"
            elif has_file_like "$p" '*.archive' || has_file_like "$p" '*.xl'; then
                while IFS= read -r -d '' f; do
                    merge_into "$f" "$out/archive/pc/mod/${f##*/}"
                done < <(find "$p" -type f \( -iname '*.archive' -o -iname '*.xl' \) -print0)
            else
                warn "    Unrecognised folder '${n}' — placed at the game root"
                merge_into "$p" "$out/$n"
            fi
        elif (( structured )); then
            is_doc "$n" || merge_into "$p" "$out/$n"
        else
            case "$nl" in
                *.archive|*.xl) merge_into "$p" "$out/archive/pc/mod/$n" ;;
                *.reds)         merge_into "$p" "$out/r6/scripts/$mod/$n" ;;
                *.yaml|*.yml)   merge_into "$p" "$out/r6/tweaks/$mod/$n" ;;
                *.lua)          merge_into "$p" "$out/$CET/$mod/$n" ;;
                *.dll)          merge_into "$p" "$out/red4ext/plugins/$mod/$n" ;;
                *)              is_doc "$n" || merge_into "$p" "$out/$n" ;;
            esac
        fi
    done
}

layout_bethesda() {
    local src="$1" out="$2" n nl data_dir="" root_mod=0 others=0
    list_entries "$src"
    local ents=("${ENT[@]}")
    for n in "${ents[@]}"; do
        nl="${n,,}"
        if [[ -d "$src/$n" && ( "$nl" == data || "$nl" == "data files" ) ]]; then data_dir="$n"; fi
        if [[ -f "$src/$n" && ( "$nl" == *.exe || "$nl" == *.dll ) ]]; then root_mod=1; fi
    done
    if [[ -n "$data_dir" ]]; then
        for n in "${ents[@]}"; do
            [[ "$n" == "$data_dir" ]] && continue
            [[ -f "$src/$n" ]] && is_doc "$n" && continue
            others=1
        done
        (( others )) && root_mod=1
    fi
    if (( root_mod )); then          # script extenders, engine fixes: relative to the game root
        MOD_ROOT="game"; place_all "$src" "$out" 1; return 0
    fi
    [[ -n "$data_dir" ]] && src="$src/$data_dir"
    place_all "$src" "$out" 1
}

layout_marker_dirs() {   # layout_marker_dirs <src> <out> <marker-file> — each folder holding the marker becomes a top-level folder
    local src="$1" out="$2" marker="$3" m d found=0
    while IFS= read -r -d '' m; do
        d="${m%/*}"
        [[ -d "$d" ]] || continue
        merge_into "$d" "$out/${d##*/}"; found=1
    done < <(find "$src" -mindepth 2 -maxdepth 5 -type f -iname "$marker" -printf '%d %p\0' | sort -zn | cut -z -d' ' -f2-)
    (( found ))
}

layout_stardew() {
    local src="$1" out="$2" mod="$3"
    if [[ -f "$src/manifest.json" ]]; then merge_into "$src" "$out/$mod"; return 0; fi
    layout_marker_dirs "$src" "$out" manifest.json || place_all "$src" "$out" 1
}

layout_bannerlord() {
    local src="$1" out="$2" mod="$3"
    if [[ -f "$src/SubModule.xml" ]]; then merge_into "$src" "$out/$mod"; return 0; fi
    layout_marker_dirs "$src" "$out" SubModule.xml || place_all "$src" "$out" 1
}

layout_bepinex() {
    local src="$1" out="$2" mod="$3" n nl p
    if dir_has_top "$src"; then place_all "$src" "$out" 1; return 0; fi
    list_entries "$src"
    local ents=("${ENT[@]}")
    for n in "${ents[@]}"; do
        nl="${n,,}"; p="$src/$n"
        if [[ -d "$p" ]]; then
            case "$nl" in
                plugins|config|patchers|core) merge_into "$p" "$out/BepInEx/$n" ;;
                *)                            merge_into "$p" "$out/BepInEx/plugins/$n" ;;
            esac
        else
            case "$nl" in
                *.cfg) merge_into "$p" "$out/BepInEx/config/$n" ;;
                *)     is_doc "$n" || merge_into "$p" "$out/BepInEx/plugins/$mod/$n" ;;
            esac
        fi
    done
}

layout_melonloader() {
    local src="$1" out="$2" n p
    if dir_has_top "$src"; then place_all "$src" "$out" 1; return 0; fi
    list_entries "$src"
    local ents=("${ENT[@]}")
    for n in "${ents[@]}"; do
        p="$src/$n"
        if [[ -f "$p" && "${n,,}" == *.dll ]]; then merge_into "$p" "$out/Mods/$n"
        elif [[ -f "$p" ]] && is_doc "$n"; then continue
        else merge_into "$p" "$out/$n"; fi
    done
}

layout_ue() {
    local src="$1" out="$2" f found=0
    if dir_has_top "$src"; then place_all "$src" "$out" 1; return 0; fi
    while IFS= read -r -d '' f; do
        merge_into "$f" "$out/${G_EXTRA}/${f##*/}"; found=1
    done < <(find "$src" -type f \( -iname '*.pak' -o -iname '*.utoc' -o -iname '*.ucas' -o -iname '*.sig' \) -print0)
    (( found )) || place_all "$src" "$out" 1
}

layout_witcher3() {
    local src="$1" out="$2" mod="$3" n nl
    if [[ -d "$src/content" || -d "$src/Content" ]]; then
        [[ "${mod,,}" == mod* ]] || mod="mod${mod}"
        merge_into "$src" "$out/mods/$mod"; return 0
    fi
    list_entries "$src"
    local ents=("${ENT[@]}")
    for n in "${ents[@]}"; do
        nl="${n,,}"
        if [[ -d "$src/$n" ]]; then
            if [[ "$TOPS" == *" $nl "* ]]; then merge_into "$src/$n" "$out/$n"
            elif [[ "$nl" == mod* ]]; then merge_into "$src/$n" "$out/mods/$n"
            elif [[ "$nl" == dlc* ]]; then merge_into "$src/$n" "$out/dlc/$n"
            else merge_into "$src/$n" "$out/$n"; fi
        else
            is_doc "$n" || merge_into "$src/$n" "$out/$n"
        fi
    done
}

# normalize_layout <src> <out> <mod-name> <strip-wrappers 0|1> <detect-variants 0|1>
# Sets MOD_ROOT ("game" when the mod targets the game root instead of the deploy dir) and MOD_VARIANT.
normalize_layout() {
    local src="$1" out="$2" mname="$3" strip="${4:-1}" variants="${5:-1}" safe n
    TOPS=$(profile_tops "$G_PROFILE")
    safe=$(sanitize_name "$mname")
    mkdir -p "$out"

    # 1) Strip wrapper folders ("ModName-1.2/archive/pc/mod/...")
    if [[ "$strip" == 1 && " generic stardew bannerlord " != *" $G_PROFILE "* ]]; then
        while :; do
            local dirs=() files=()
            list_entries "$src"
            for n in "${ENT[@]}"; do
                if [[ -d "$src/$n" ]]; then dirs+=("$n"); elif ! is_doc "$n"; then files+=("$n"); fi
            done
            (( ${#dirs[@]} == 1 && ${#files[@]} == 0 )) || break
            local dl="${dirs[0],,}"
            # Bethesda: a folder holding Data/ or an .exe is a wrapper even if named like a data folder (e.g. "skse")
            if [[ "$G_PROFILE" == bethesda && "$dl" != data && "$dl" != "data files" ]] \
               && [[ -n "$(find "$src/${dirs[0]}" -mindepth 1 -maxdepth 1 \( -iname data -type d -o -iname '*.exe' -type f \) -print -quit)" ]]; then
                src="$src/${dirs[0]}"; continue
            fi
            [[ "$TOPS" == *" $dl "* || "$dl" == fomod ]] && break
            [[ "$G_PROFILE" == bethesda && ( "$dl" == data || "$dl" == "data files" ) ]] && break
            [[ "$G_PROFILE" == witcher3 && ( "$dl" == mod* || "$dl" == dlc* ) ]] && break
            src="$src/${dirs[0]}"
        done
    fi

    # 2) Variant folders: several alternative full copies of the mod side by side
    if [[ "$variants" == 1 && " generic stardew bannerlord " != *" $G_PROFILE "* ]] && ! dir_has_top "$src"; then
        local cands=()
        list_entries "$src"
        local ents=("${ENT[@]}")
        for n in "${ents[@]}"; do
            [[ -d "$src/$n" ]] && dir_has_top "$src/$n" && cands+=("$n")
        done
        if (( ${#cands[@]} >= 2 )); then
            local pick="" i
            if [[ -n "${PRESET_VARIANT:-}" ]]; then
                for n in "${cands[@]}"; do [[ "$n" == "$PRESET_VARIANT" ]] && pick="$n"; done
            fi
            if [[ -z "$pick" ]] && is_interactive; then
                echo -e "  ${BOLD}${mname}${RESET} contains ${#cands[@]} variants:"
                for i in "${!cands[@]}"; do echo -e "    ${CYAN}$((i + 1)).${RESET} ${cands[$i]}"; done
                local ans; ask ans "Which variant should be installed?" 1
                [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#cands[@]} )) && pick="${cands[$((ans - 1))]}"
            fi
            if [[ -z "$pick" ]]; then
                pick="${cands[0]}"
                warn "    ${mname}: ${#cands[@]} variants found — using '${pick}' (reinstall interactively to choose)"
            fi
            MOD_VARIANT="$pick"
            src="$src/$pick"
        fi
    fi

    # 3) Game-specific placement
    case "$G_PROFILE" in
        cyberpunk)   layout_cyberpunk   "$src" "$out" "$safe" ;;
        bethesda)    layout_bethesda    "$src" "$out" ;;
        stardew)     layout_stardew     "$src" "$out" "$safe" ;;
        bannerlord)  layout_bannerlord  "$src" "$out" "$safe" ;;
        bepinex)     layout_bepinex     "$src" "$out" "$safe" ;;
        melonloader) layout_melonloader "$src" "$out" ;;
        ue)          layout_ue          "$src" "$out" ;;
        witcher3)    layout_witcher3    "$src" "$out" "$safe" ;;
        *)           place_all          "$src" "$out" 0 ;;
    esac
}

# ══════════════════════════════════════════════════════════
# FOMOD installer (embedded Python — XML parsing in bash is hopeless)
# args: <fomod-root> <out-dir> <mode: ask|default|choices> <choices.json> <deploy-dir> <mod-name>
# stdout: the selected options in Vortex/collection format
# ══════════════════════════════════════════════════════════
fomod_py() {
    cat <<'PYEOF'
import sys, os, re, json, shutil
import xml.etree.ElementTree as ET

root, out, mode, choices_path, deploy_dir, modname = sys.argv[1:7]

def log(msg):
    print(msg, file=sys.stderr)

def strip_ns(el):
    for e in el.iter():
        if isinstance(e.tag, str) and '}' in e.tag:
            e.tag = e.tag.split('}', 1)[1]
    return el

def load_xml(path):
    data = open(path, 'rb').read()
    try:
        return strip_ns(ET.fromstring(data))
    except ET.ParseError:
        pass
    for enc in ('utf-16', 'utf-8-sig', 'cp1252', 'latin-1'):
        try:
            text = data.decode(enc)
        except UnicodeDecodeError:
            continue
        text = re.sub(r'^\s*<\?xml[^>]*\?>', '', text.lstrip('﻿'))
        try:
            return strip_ns(ET.fromstring(text))
        except ET.ParseError:
            continue
    sys.exit('fomod: cannot parse ModuleConfig.xml')

_listing = {}
def find_ci(base, rel):
    parts = [p for p in re.split(r'[\\/]+', rel or '') if p not in ('', '.')]
    cur = base
    for p in parts:
        if p == '..':
            return None
        cand = os.path.join(cur, p)
        if os.path.lexists(cand):
            cur = cand
            continue
        if cur not in _listing:
            try:
                _listing[cur] = os.listdir(cur)
            except OSError:
                return None
        low = p.lower()
        match = next((n for n in _listing[cur] if n.lower() == low), None)
        if match is None:
            return None
        cur = os.path.join(cur, match)
    return cur

def safe_rel(p):
    parts = [x for x in re.split(r'[\\/]+', p or '') if x not in ('', '.')]
    if any(x == '..' for x in parts):
        raise ValueError(p)
    return '/'.join(parts)

flags = {}

def file_present(name):
    if not deploy_dir or not os.path.isdir(deploy_dir):
        return False
    p = find_ci(deploy_dir, name)
    return bool(p) and os.path.exists(p)

def eval_deps(el):
    if el is None:
        return True
    op = (el.get('operator') or 'And').lower()
    res = []
    for c in el:
        t = c.tag
        if t == 'flagDependency':
            res.append(flags.get(c.get('flag') or '', '') == (c.get('value') or ''))
        elif t == 'fileDependency':
            want = c.get('state') or 'Active'
            present = file_present(c.get('file') or '')
            res.append((not present) if want == 'Missing' else (present if want == 'Active' else False))
        elif t in ('dependencies', 'compositeDependency'):
            res.append(eval_deps(c))
        else:
            res.append(True)   # game / script extender / fomm version checks
    if not res:
        return True
    return all(res) if op == 'and' else any(res)

def plugin_type(p):
    td = p.find('typeDescriptor')
    if td is None:
        return 'Optional'
    t = td.find('type')
    if t is not None:
        return t.get('name') or 'Optional'
    dt = td.find('dependencyType')
    if dt is not None:
        pats = dt.find('patterns')
        for pat in (pats.findall('pattern') if pats is not None else []):
            if eval_deps(pat.find('dependencies')):
                tt = pat.find('type')
                return (tt.get('name') if tt is not None else None) or 'Optional'
        d = dt.find('defaultType')
        return (d.get('name') if d is not None else None) or 'Optional'
    return 'Optional'

def ordered(parent, tag):
    if parent is None:
        return []
    items = parent.findall(tag)
    order = parent.get('order') or 'Ascending'
    if order == 'Explicit':
        return items
    items = sorted(items, key=lambda e: (e.get('name') or '').lower())
    return items if order == 'Ascending' else items[::-1]

def defaults(gtype, types):
    idx = list(range(len(types)))
    req = [i for i in idx if types[i] == 'Required']
    rec = [i for i in idx if types[i] == 'Recommended']
    usable = [i for i in idx if types[i] != 'NotUsable']
    if gtype == 'SelectAll':
        return idx
    if gtype == 'SelectExactlyOne':
        return (req or rec or usable or idx)[:1]
    if gtype == 'SelectAtMostOne':
        return (req or rec)[:1]
    if gtype == 'SelectAtLeastOne':
        return sorted(set(req + rec)) or usable[:1]
    return sorted(set(req + rec))

def find_named(items, name):
    if not items:
        return None
    for it in items:
        if it.get('name') == name:
            return it
    low = (name or '').lower()
    for it in items:
        if (it.get('name') or '').lower() == low:
            return it
    return None

def from_preset(pg, plugins, types, gtype, dflt):
    names = [p.get('name') or '' for p in plugins]
    sel = set()
    for ch in pg.get('choices') or []:
        nm, idx = ch.get('name'), ch.get('idx')
        hits = [i for i, x in enumerate(names) if x == nm]
        if len(hits) > 1 and isinstance(idx, int) and idx in hits:
            sel.add(idx)
        elif hits:
            sel.add(hits[0])
        elif isinstance(idx, int) and 0 <= idx < len(plugins):
            sel.add(idx)
    sel |= {i for i, t in enumerate(types) if t == 'Required'}
    if gtype == 'SelectAll':
        sel = set(range(len(plugins)))
    sel = {i for i in sel if types[i] != 'NotUsable'}
    if gtype == 'SelectExactlyOne' and len(sel) != 1:
        sel = {min(sel)} if sel else set(dflt)
    if gtype == 'SelectAtMostOne' and len(sel) > 1:
        sel = {min(sel)}
    if gtype == 'SelectAtLeastOne' and not sel:
        sel = set(dflt)
    return sorted(sel)

