# parse_mod_target <target> → T_GAME T_MOD T_FILE T_KEY T_EXP (returns 1 if not a Nexus mod reference)
parse_mod_target() {
    local t="$1"
    T_GAME=""; T_MOD=""; T_FILE=""; T_KEY=""; T_EXP=""
    if parse_nxm "$t" && [[ "$NXM_KIND" == mod ]]; then
        T_GAME="$NXM_GAME"; T_MOD="$NXM_MOD"; T_FILE="$NXM_FILE"; T_KEY="$NXM_KEY"; T_EXP="$NXM_EXPIRES"
        return 0
    fi
    if [[ "$t" =~ nexusmods\.com/(games/)?([^/?#]+)/mods/([0-9]+) ]]; then
        T_GAME="${BASH_REMATCH[2],,}"; T_MOD="${BASH_REMATCH[3]}"
        if [[ "$t" =~ [?\&]file_id=([0-9]+) ]]; then T_FILE="${BASH_REMATCH[1]}"; fi
        return 0
    fi
    if [[ "$t" =~ ^([a-z0-9]+):([0-9]+)$ ]]; then          # game:modid
        T_GAME="${BASH_REMATCH[1]}"; T_MOD="${BASH_REMATCH[2]}"; return 0
    fi
    if [[ "$t" =~ ^[0-9]+$ ]]; then T_MOD="$t"; return 0; fi
    return 1
}

# choose_file <files-json> → file id (table on stderr)
choose_file() {
    local fj="$1" rows=() i id cat name ver size ts prim def=0 ans
    mapfile -t rows < <(jq -r "$JQ_DEFS"' ["MAIN","UPDATE","OPTIONAL","MISCELLANEOUS"] as $cats
        | [.files[] | select(.category_name as $c | $cats | index($c))]
        | sort_by((.category_name as $c | $cats | index($c)), -(.uploaded_timestamp // 0)) | .[]
        | [.file_id, .category_name, .name, .version, .size_in_bytes, .uploaded_timestamp, .is_primary] | row' <<< "$fj")
    (( ${#rows[@]} )) || { error "This mod has no downloadable files."; return 1; }
    for i in "${!rows[@]}"; do
        IFS="$SEP" read -r id cat name ver size ts prim <<< "${rows[i]}"
        [[ "$prim" == true ]] && { def=$i; break; }
    done
    if (( ${#rows[@]} == 1 )) || ! is_interactive; then
        printf '%s' "${rows[def]%%"$SEP"*}"; return 0
    fi
    echo -e "${BOLD}Files:${RESET}" >&2
    for i in "${!rows[@]}"; do
        IFS="$SEP" read -r id cat name ver size ts prim <<< "${rows[i]}"
        printf "  ${CYAN}%2d.${RESET} %-13s %-44s %-12s %9s  ${DIM}%s${RESET}\n" $(( i + 1 )) "$cat" "$(trunc "$name" 44)" \
            "$(trunc "$ver" 12)" "$(human_size "${size:-0}")" "$(fmt_date "$ts")" >&2
    done
    while :; do
        ask ans "Which file?" $(( def + 1 ))
        if [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#rows[@]} )); then break; fi
        warn "Enter a number between 1 and ${#rows[@]}."
    done
    printf '%s' "${rows[$((ans - 1))]%%"$SEP"*}"
}

# ══════════════════════════════════════════════════════════
# Requirements: what installed mods need (Nexus mods + external tools)
#   cache/requirements.json   {modId: {t, req: [nexusRequirements nodes], avail, ta}}
#                             req = requirements of an installed mod; avail = whether
#                             a required mod can still be downloaded from Nexus
#   deps-ack.json             requirement keys the user installed by hand
# ══════════════════════════════════════════════════════════
DEPS_TTL=604800      # re-query after a week
DEPS_SHOWN=0         # set once a report was printed this run (avoids repeating it on --deploy)
GQL_REQ_FIELDS='modRequirements { nexusRequirements { nodes { modId modName gameId externalRequirement url notes } } }'

# gql_mod_batch '<fields>' <modId...> → {"<modId>": {fields} | null}
# Nexus answers data:null for the whole query when one mod is hidden or deleted,
# so failing aliases are recorded as null and the rest is asked again.
gql_mod_batch() {
    local fields="$1"; shift
    local gid q data out='{}' m tries=0
    local -a todo=("$@") bad=()
    gid=$(nexus_game_id 2>/dev/null) || return 1
    while (( ${#todo[@]} && tries < 3 )); do
        tries=$(( tries + 1 ))
        q="query {"
        for m in "${todo[@]}"; do q+=" m${m}: mod(modId: \"${m}\", gameId: \"${gid}\") { ${fields} }"; done
        q+=" }"
        if data=$(gql_query "$q"); then
            out=$(jq -c --argjson d "$data" '. + ($d | with_entries(.key |= .[1:]))' <<< "$out")
            break
        fi
        mapfile -t bad < <(jq -r '.errors[]?.path[0]? // empty | tostring | ltrimstr("m")' <<< "$data" 2>/dev/null)
        (( ${#bad[@]} )) || { debug "mod query failed: $(api_error_msg "$data")"; return 1; }
        out=$(jq -c '. + ($ARGS.positional | map({key: ., value: null}) | from_entries)' --args "${bad[@]}" <<< "$out")
        mapfile -t todo < <(printf '%s\n' "${todo[@]}" | grep -vxF -f <(printf '%s\n' "${bad[@]}") || true)
    done
    printf '%s' "$out"
}

# deps_fetch [--refresh] <modId...> — makes sure the cache knows these mods' requirements
# and whether the Nexus mods they point to are still available.
deps_fetch() {
    local refresh=0
    [[ "${1:-}" == --refresh ]] && { refresh=1; shift; }
    local cf="${CACHE_DIR}/requirements.json" gid i res
    [[ -s "$cf" ]] || echo '{}' > "$cf"
    (( $# )) && [[ -n "$NEXUS_API_KEY" ]] || return 0
    gid=$(nexus_game_id 2>/dev/null) || return 0
    local -a stale=() need=()
    mapfile -t stale < <(jq -r --argjson now "$(now)" --argjson r "$refresh" --argjson ttl "$DEPS_TTL" \
        '. as $c | [$ARGS.positional[] | select(test("^[0-9]+$"))] | unique[]
         | select($r == 1 or $c[.].req == null or ($now - ($c[.].t // 0)) > $ttl)' "$cf" --args "$@")
    (( ${#stale[@]} > 40 )) && [[ -t 1 ]] && info "Checking requirements of ${#stale[@]} mods..."
    for (( i = 0; i < ${#stale[@]}; i += 40 )); do
        res=$(gql_mod_batch "$GQL_REQ_FIELDS" "${stale[@]:i:40}") || continue
        jq --argjson d "$res" --argjson now "$(now)" 'reduce ($d | to_entries[]) as $e (.;
            .[$e.key] += {t: $now, req: ($e.value.modRequirements.nexusRequirements.nodes? // []),
                          avail: ($e.value != null), ta: $now})' "$cf" > "${cf}.tmp" && mv -f -- "${cf}.tmp" "$cf"
    done
    # required Nexus mods of this game (direct, or linked by URL) whose availability is unknown
    mapfile -t need < <(jq -r --argjson now "$(now)" --argjson r "$refresh" --argjson ttl "$DEPS_TTL" \
        --arg gid "$gid" --arg dom "$G_DOMAIN" '. as $c | [$ARGS.positional[] as $m | $c[$m].req[]?
            | if (.externalRequirement | not) and ((.gameId // "" | tostring) | IN("", "0", $gid)) then (.modId | tostring)
              else ((.url // "") | ascii_downcase | capture("nexusmods\\.com/(games/)?(?<d>[a-z0-9]+)/mods/(?<m>[0-9]+)")?
                    | select(.d == $dom) | .m) end ]
        | unique[] | select(. != "0" and . != "")
        | select($r == 1 or $c[.].avail == null or ($now - ($c[.].ta // 0)) > $ttl)' "$cf" --args "$@")
    for (( i = 0; i < ${#need[@]}; i += 40 )); do
        res=$(gql_mod_batch 'modId' "${need[@]:i:40}") || continue
        jq --argjson d "$res" --argjson now "$(now)" 'reduce ($d | to_entries[]) as $e (.;
            .[$e.key] += {avail: ($e.value != null), ta: $now})' "$cf" > "${cf}.tmp" && mv -f -- "${cf}.tmp" "$cf"
    done
    return 0
}

deps_py() {
    cat <<'PYEOF'
import json, os, re, sys

db_f, cache_f, ack_f, game, mods_dir, gid, domain, manifest_f, scope_json = sys.argv[1:10]
SEP = '\x1f'

def load(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return default

db = load(db_f, {'mods': [], 'collections': {}})
cache = load(cache_f, {})
acks = set(load(ack_f, []))
scope = json.loads(scope_json)
mods = db.get('mods', [])
want_ids = scope.get('mods')
in_scope = [m for m in mods if (m['id'] in want_ids if want_ids is not None else m.get('enabled'))]

enabled, disabled = {}, {}
for m in mods:
    if m.get('modId') is not None:
        (enabled if m.get('enabled') else disabled).setdefault(str(m['modId']), m)

# Loaders and script extenders that are usually installed outside the mod manager.
# They are recognised by name/URL and found by a file only the real tool ships.
TOOLS = [
    ('ue4ss', 'UE4SS', r'ue4ss|unreal engine 4/5 scripting', ['ue4ss.dll']),
    ('red4ext', 'RED4ext', r'red4ext', ['red4ext.dll']),
    ('cet', 'Cyber Engine Tweaks', r'cyber engine tweaks', ['cyber_engine_tweaks.asi']),
    ('redscript', 'redscript', r'\bredscript\b', ['scc.exe']),
    ('skse', 'SKSE', r'\bskse(64|vr)?\b|skyrim script extender', ['skse64_loader.exe', 'skse_loader.exe', 'sksevr_loader.exe']),
    ('f4se', 'F4SE', r'\bf4se\b|fallout 4 script extender', ['f4se_loader.exe']),
    ('sfse', 'SFSE', r'\bsfse\b|starfield script extender', ['sfse_loader.exe']),
    ('nvse', 'xNVSE', r'\bx?nvse\b|new vegas script extender', ['nvse_loader.exe']),
    ('obse', 'OBSE', r'\bobse(64)?\b|oblivion script extender', ['obse_loader.exe', 'obse64_loader.exe']),
    ('bepinex', 'BepInEx', r'bepinex', ['bepinex.core.dll', 'bepinex.dll', 'bepinex.preloader.dll']),
    ('melonloader', 'MelonLoader', r'melon ?loader', ['melonloader.dll']),
    ('smapi', 'SMAPI', r'\bsmapi\b|stardew ?modding ?api', ['stardewmoddingapi.dll', 'stardewmoddingapi.exe']),
    ('me2', 'Mod Engine 2', r'mod ?engine ?2', ['modengine2_launcher.exe']),
]

def tool_for(text):
    t = (text or '').lower()
    for key, name, pat, files in TOOLS:
        if re.search(pat, t):
            return key, name, files
    return None

def norm_url(u):
    u = (u or '').strip().lower()
    u = re.sub(r'^[a-z]+://', '', u)
    u = re.sub(r'^www\.', '', u)
    m = re.match(r'(github\.com/[^/]+/[^/?#]+)', u)
    if m:
        return m.group(1)
    return u.split('#')[0].rstrip('/')

groups = {}
def group(key, name, kind):
    g = groups.get(key)
    if g is None:
        g = groups[key] = {'key': key, 'name': name, 'kind': kind, 'nexus': [], 'urls': [], 'by': [], 'tool': None}
    return g

def nexus_url_id(url):
    m = re.search(r'nexusmods\.com/(?:games/)?([a-z0-9]+)/mods/([0-9]+)', (url or '').lower())
    return m.group(2) if m and m.group(1) == domain else None

def available(mid):
    return (cache.get(mid) or {}).get('avail', True) is not False

def add_url(g, url):
    # one link per site/repository; the most specific one (e.g. a release tag) wins
    if not url:
        return
    k = norm_url(url)
    for i, u in enumerate(g['urls']):
        if norm_url(u) == k:
            if len(url) > len(u) and not re.search(r'\.(zip|7z|rar)$', url, re.I):
                g['urls'][i] = url
            return
    g['urls'].append(url)

for m in in_scope:
    mid = m.get('modId')
    if mid is None:
        continue
    for r in (cache.get(str(mid)) or {}).get('req') or []:
        name = (r.get('modName') or '').strip() or 'unnamed requirement'
        ext = bool(r.get('externalRequirement'))
        rmod, rgame, url = str(r.get('modId') or ''), str(r.get('gameId') or ''), (r.get('url') or '').strip()
        if not ext and rmod == str(mid):
            continue
        same_game = (not ext) and rmod not in ('', '0') and rgame in ('', '0', gid)
        tool = tool_for(name + ' ' + url)
        if tool:
            g = group('tool:' + tool[0], tool[1], 'tool')
            g['tool'] = tool
        elif same_game:
            g = group('nexus:' + rmod, name, 'nexus')
        elif not ext and rmod not in ('', '0'):
            g = group('nexus:%s:%s' % (rgame, rmod), name, 'external')
        else:
            g = group('url:' + (norm_url(url) or name.lower()), name, 'external')
        uid = None if same_game else nexus_url_id(url)
        if same_game or uid:
            if (rmod if same_game else uid) not in g['nexus']:
                g['nexus'].append(rmod if same_game else uid)
        elif ext or not same_game:
            add_url(g, url)
        if m['name'] not in g['by']:
            g['by'].append(m['name'])

for e in scope.get('extra') or []:     # collection-level external resources
    url, name = e.get('url') or '', e.get('name') or 'external resource'
    tool = tool_for(name + ' ' + url)
    if tool:
        g = group('tool:' + tool[0], tool[1], 'tool')
        g['tool'] = tool
    else:
        g = group('url:' + (norm_url(url) or name.lower()), name, 'external')
    uid = nexus_url_id(url)
    if uid:
        if uid not in g['nexus']:
            g['nexus'].append(uid)
    else:
        add_url(g, url)
    if e.get('by') and e['by'] not in g['by']:
        g['by'].append(e['by'])

# Look for the tools' files in the game folder and in enabled mods (installed but not yet deployed).
wanted = {}
for g in groups.values():
    if g['tool']:
        for f in g['tool'][2]:
            wanted[f] = g['key']
# Files modman deployed are judged by the enabled mods below, not by what is in the game folder
# right now (a disabled mod's files stay there until the next deploy).
deployed = set()
try:
    with open(manifest_f, encoding='utf-8', errors='replace') as fh:
        for line in fh:
            deployed.add(line.split('\x1f', 1)[0].lower())
except OSError:
    pass
found = {}
def scan(root, label, depth=8, skip=()):
    if not root or not os.path.isdir(root):
        return
    base = root.rstrip('/').count('/')
    for dirpath, dirnames, filenames in os.walk(root):
        if dirpath.count('/') - base >= depth:
            dirnames[:] = []
        for fn in filenames:
            k = wanted.get(fn.lower())
            if k and skip and os.path.relpath(os.path.join(dirpath, fn), root).lower() in skip:
                continue
            if k and k not in found:
                found[k] = label or os.path.relpath(os.path.join(dirpath, fn), root)
        if len(found) == len(set(wanted.values())):
            return
if wanted:
    scan(game, '', skip=deployed)
    for m in mods:
        if len(found) == len(set(wanted.values())):
            break
        if m.get('enabled'):
            scan(os.path.join(mods_dir, m['id']), 'provided by "%s"' % m['name'])

rows, counts = [], {}
order = {'missing': 0, 'disabled': 1, 'external': 2, 'gone': 3, 'ok': 4}
for g in groups.values():
    have = [enabled[i] for i in g['nexus'] if i in enabled]
    off = [disabled[i] for i in g['nexus'] if i in disabled]
    hint = detail = ''
    if have:
        status, detail = 'ok', 'installed: ' + have[0]['name']
    elif g['key'] in found:
        status, detail = 'ok', 'found: ' + found[g['key']]
    elif g['key'] in acks:
        status, detail = 'ok', 'marked as installed'
    elif off:
        status, hint = 'disabled', 'enable ' + off[0]['id']
    else:
        live = [i for i in g['nexus'] if available(i)]
        if live:
            status, hint = 'missing', 'install ' + live[0]
        elif g['tool']:
            status = 'missing'     # detectable tool that is not there
        elif g['urls']:
            status = 'external'    # cannot be verified — the user has to check
        else:
            status = 'gone'        # only points to a Nexus page that no longer exists
            detail = 'no longer on Nexus'
        gone_ids = [i for i in g['nexus'] if not available(i)]
        if gone_ids and not live and g['tool']:
            detail = 'its Nexus page (mod %s) is no longer available' % gone_ids[0]
    counts[status] = counts.get(status, 0) + 1
    rows.append((order[status], g['name'].lower(), status, g, hint, detail))

for _, _, status, g, hint, detail in sorted(rows, key=lambda r: (r[0], r[1])):
    print(SEP.join([status, g['key'], g['name'], hint, ' '.join(g['urls']), '; '.join(g['by']), detail]).replace('\n', ' '))
PYEOF
}

# deps_scope_json <mod-id...> → scope for the analysis; no ids = all enabled mods.
# Collection-level external resources of the collections involved are added as well.
deps_scope_json() {
    local ids extra="[]" slug dir cname
    if (( $# )); then ids=$(json_array "$@"); else ids=null; fi
    while IFS="$SEP" read -r slug dir cname; do
        [[ -f "${dir}/revision.json" ]] || continue
        extra=$(jq -c --argjson e "$extra" --arg by "collection: ${cname}" \
            '$e + [(.externalResources // [])[] | {name, url: .resourceUrl, by: $by}]' "${dir}/revision.json" 2>/dev/null || echo "$extra")
    done < <(jq -r --argjson ids "$ids" "$JQ_DEFS"' . as $db | .collections[] | .slug as $s
        | select([$db.mods[] | select(((.collections // []) | index($s)) and (if $ids == null then .enabled else (.id | IN($ids[])) end))] | length > 0)
        | [.slug, .dir, .name] | row' "$DB_FILE")
    jq -cn --argjson ids "$ids" --argjson extra "$extra" '{mods: $ids, extra: $extra}'
}

# deps_rows <scope-json> → status␟key␟name␟hint␟urls␟required-by␟detail per requirement
deps_rows() {
    local gid="${G_NEXUS_ID:-}"
    python3 -I -c "$(deps_py)" "$DB_FILE" "${CACHE_DIR}/requirements.json" "${GDATA}/deps-ack.json" \
        "${G_FOLDER:-}" "$MODS_DIR" "$gid" "$G_DOMAIN" "$MANIFEST" "$1"
}

# deps_report full|problems <scope-json> [title]
#   full     — every requirement, with its state (install / info / deps)
#   problems — only what is missing or unverified (deploy / collection install)
deps_report() {
    local mode="$1" scope="$2" title="${3:-Requirements}"
    local rows status key name hint urls by detail n_ok=0 n_bad=0 n_ext=0 u
    rows=$(deps_rows "$scope") || { debug "requirement analysis failed"; return 0; }
    DEPS_SHOWN=1
    [[ -n "$rows" ]] || { [[ "$mode" == full ]] && { echo ""; info "${title}: none listed on Nexus."; }; return 0; }
    while IFS="$SEP" read -r status key name hint urls by detail; do
        case "$status" in
            ok)               n_ok=$(( n_ok + 1 )) ;;
            external)         n_ext=$(( n_ext + 1 )) ;;
            missing|disabled) n_bad=$(( n_bad + 1 )) ;;
        esac
    done <<< "$rows"
    if [[ "$mode" == problems ]] && (( n_bad + n_ext == 0 )); then
        (( n_ok )) && [[ -n "$NEXUS_API_KEY" ]] && success "All ${n_ok} requirement(s) of the installed mods are present."
        return 0
    fi
    section "$title"
    while IFS="$SEP" read -r status key name hint urls by detail; do
        [[ "$mode" == problems && ( "$status" == ok || "$status" == gone ) ]] && continue
        case "$status" in
            ok)       echo -e "  ${GREEN}✓${RESET} ${BOLD}${name}${RESET}  ${DIM}${detail}${RESET}" ;;
            missing)  echo -e "  ${RED}✗${RESET} ${BOLD}${name}${RESET}  ${RED}missing${RESET}${detail:+  ${DIM}(${detail})${RESET}}" ;;
            disabled) echo -e "  ${YELLOW}✗${RESET} ${BOLD}${name}${RESET}  ${YELLOW}installed but disabled${RESET}" ;;
            external) echo -e "  ${YELLOW}?${RESET} ${BOLD}${name}${RESET}  ${YELLOW}external — install it yourself${RESET}" ;;
            gone)     echo -e "  ${DIM}· ${name}  (${detail})${RESET}" ;;
        esac
        [[ "$status" == ok || "$status" == gone ]] && continue
        if [[ -n "$by" ]]; then
            local nby label="needed by"; nby=$(( $(grep -o '; ' <<< "$by" | wc -l) + 1 ))
            (( nby > 1 )) && label="needed by ${nby} mods"
            echo -e "      ${DIM}${label}: $(trunc "$by" $(( $(term_cols) - ${#label} - 10 )))${RESET}"
        fi
        [[ -n "$hint" ]] && echo -e "      → ${CYAN}${PROG} ${hint}${RESET}"
        for u in $urls; do echo -e "      → ${CYAN}${u}${RESET}"; done
    done <<< "$rows"
    if (( n_bad + n_ext )); then
        echo ""
        (( n_bad )) && warn "${n_bad} requirement(s) missing — the mods that need them will not work."
        (( n_ext )) && info "External requirements cannot be checked automatically. Once installed: ${PROG} deps ack <name>"
        [[ "$mode" == problems ]] && (( n_ok )) && echo -e "  ${DIM}${n_ok} other requirement(s) present — full list: ${PROG} deps${RESET}"
    fi
    return 0
}

# Checks requirements of all enabled mods (after deploy). Never fails the caller.
deps_check_enabled() {
    (( DEPS_SHOWN )) && return 0
    local -a ids=()
    mapfile -t ids < <(jq -r '.mods[] | select(.enabled and .modId != null) | .modId' "$DB_FILE")
    (( ${#ids[@]} )) || return 0
    deps_fetch "${ids[@]}" || true
    deps_report problems "$(deps_scope_json)" "Requirements" || true
}

# install_nexus_mod <modId> [fileId] [nxm-key] [nxm-expires] [fomod-mode] [name]
install_nexus_mod() {
    local mod="$1" file="${2:-}" key="${3:-}" exp="${4:-}" fomod="${5:-}" name_override="${6:-}"
    local info_json files_json mname mauthor mver mstatus fname fver fcat fsize
    info_json=$(rest_get "/games/${G_DOMAIN}/mods/${mod}.json") \
        || die "Mod ${mod} not found for ${G_NAME}: $(api_error_msg "$info_json")"
    IFS="$SEP" read -r mname mauthor mver mstatus < <(jq -r "$JQ_DEFS"' [.name, .author, .version, .status] | row' <<< "$info_json")
    echo -e "${BOLD}${mname}${RESET} by ${mauthor} ${DIM}(v${mver}) — ${SITE_URL}/${G_DOMAIN}/mods/${mod}${RESET}"
    [[ "$mstatus" == published ]] || warn "Mod status on Nexus: ${mstatus}"
    files_json=$(rest_get "/games/${G_DOMAIN}/mods/${mod}/files.json") \
        || die "Could not list files: $(api_error_msg "$files_json")"
    if [[ -z "$file" ]]; then file=$(choose_file "$files_json") || exit 1; fi
    IFS="$SEP" read -r fname fver fcat fsize < <(jq -r --argjson f "$file" "$JQ_DEFS"'
        .files[] | select(.file_id == $f) | [.name, .version, .category_name, .size_in_bytes] | row' <<< "$files_json")
    [[ -n "$fname" ]] || die "File ${file} does not belong to mod ${mod}."
    echo -e "  File: ${fname} ${DIM}(${fcat}, v${fver}, $(human_size "${fsize:-0}"))${RESET}"

    # Same file already installed? Older file of the same mod?
    local same older replaces="" choices="null" variant=""
    same=$(jq -r --argjson m "$mod" --argjson f "$file" '.mods[] | select(.modId == $m and .fileId == $f) | .id' "$DB_FILE" | head -1) || true
    if [[ -n "$same" ]]; then
        confirm "Already installed (${same}). Reinstall?" N || { info "Nothing to do."; return 0; }
        replaces="$same"
    else
        older=$(jq -r --argjson m "$mod" '.mods[] | select(.modId == $m) | .id' "$DB_FILE" | head -1) || true
        if [[ -n "$older" ]] && confirm "Replace the installed file ${older} with this one?" Y; then
            replaces="$older"
        fi
    fi
    if [[ -n "$replaces" ]]; then
        choices=$(jq -c --arg id "$replaces" '.mods[] | select(.id == $id) | .fomod // null' "$DB_FILE")
        variant=$(jq -r --arg id "$replaces" '.mods[] | select(.id == $id) | .variant // ""' "$DB_FILE")
        [[ -z "$fomod" ]] && fomod=reuse
    fi

    download_nexus_file "$G_DOMAIN" "$mod" "$file" "" "" "$key" "$exp" || die "Download failed."
    local archive="$DL_RESULT" md5 name meta
    md5=$(md5sum -- "$archive" | cut -d' ' -f1)
    name="$mname"
    if [[ -n "$name_override" ]]; then name="$name_override"
    elif [[ "$fcat" != MAIN && "$fname" != "$mname" ]]; then name="${mname} - ${fname}"; fi
    info "Installing ${name}..."
    meta=$(jq -n --arg name "$name" --arg ver "$fver" --argjson mod "$mod" --argjson file "$file" --arg md5 "$md5" \
        --arg author "$mauthor" --arg fm "$fomod" --arg rep "$replaces" --argjson ch "$choices" --arg var "$variant" \
        '{name: $name, version: $ver, modId: $mod, fileId: $file, md5: $md5, source: "nexus", author: $author,
          fomodMode: $fm, replaces: $rep, choices: $ch, variant: $var}')
    install_archive "$archive" "$meta" || die "Installation failed."
    success "Installed ${BOLD}${name}${RESET} → ${INSTALLED_ID}"
    deps_fetch "$mod"
    deps_report full "$(deps_scope_json "$INSTALLED_ID")"
}

install_local() {
    local path="$1" name="${2:-}" fomod="${3:-}" base dest md5 meta lookup modid="" fileid="" ver=""
    path=$(readlink -f -- "$path")
    base="${path##*/}"
    dest="${DL_DIR}/${base}"
    [[ "$path" == "$dest" ]] || cp -r --reflink=auto -f -- "$path" "$dest"
    if [[ -z "$name" ]]; then name="${base%.*}"; name="${name%.tar}"; fi
    md5=""
    [[ -f "$dest" ]] && md5=$(md5sum -- "$dest" | cut -d' ' -f1)
    # Identify Nexus files by checksum so updates can be tracked later.
    if [[ -n "$md5" && -n "$NEXUS_API_KEY" ]] && lookup=$(rest_get "/games/${G_DOMAIN}/mods/md5_search/${md5}.json" 2>/dev/null); then
        IFS="$SEP" read -r modid fileid ver name < <(jq -r --arg n "$name" "$JQ_DEFS"'
            first(.[]?) | [.mod.mod_id, .file_details.file_id, .file_details.version, (.mod.name // $n)] | row' <<< "$lookup" 2>/dev/null) || true
        [[ -n "$modid" ]] && info "Identified on Nexus: ${name} (mod ${modid}, file ${fileid})"
        [[ -n "$modid" ]] || name="${base%.*}"
    fi
    meta=$(jq -n --arg name "$name" --arg md5 "$md5" --arg fm "$fomod" --arg mod "$modid" --arg file "$fileid" --arg ver "$ver" \
        '{name: $name, md5: $md5, fomodMode: $fm, version: $ver,
          source: (if $mod != "" then "nexus" else "local" end),
          modId: (if $mod != "" then ($mod | tonumber) else null end),
          fileId: (if $file != "" then ($file | tonumber) else null end)}')
    info "Installing ${name} from ${base}..."
    install_archive "$dest" "$meta" || die "Installation failed."
    success "Installed ${BOLD}${name}${RESET} → ${INSTALLED_ID}"
    if [[ -n "$modid" ]]; then
        deps_fetch "$modid"
        deps_report full "$(deps_scope_json "$INSTALLED_ID")"
    fi
}

# ══════════════════════════════════════════════════════════
# COMMAND: install <mod-id | url | nxm:// | archive | collection>
# ══════════════════════════════════════════════════════════
cmd_install() {
    local target="" file_id="" fomod="" name_override="" deploy_after=0
    local -a passthru=()
    while (( $# )); do
        case "$1" in
            --file|-f)        file_id="${2:-}"; shift ;;
            --fomod)          fomod="${2:-}"; shift ;;
            --name)           name_override="${2:-}"; shift ;;
            --deploy)         deploy_after=1; passthru+=("$1") ;;
            --optional|--revision|-r) passthru+=("$1" "${2:-}"); shift ;;
            --download-only)  passthru+=("$1") ;;
            -*)               die "Unknown option for install: $1" ;;
            *)                target="$1" ;;
        esac
        shift
    done
    [[ -n "$target" ]] || die "Usage: ${PROG} install <mod-id | nexus-url | nxm-link | archive-file | collection-url>"
    case "$fomod" in ""|ask|default|none|reuse) ;; *) die "--fomod must be ask, default or none" ;; esac

    if [[ -e "$target" ]]; then
        need_game
        acquire_lock
        install_local "$target" "$name_override" "$fomod"
    elif [[ "$target" == *collections/* ]]; then
        collection_install "$target" "${passthru[@]+"${passthru[@]}"}"
        return 0
    elif parse_mod_target "$target"; then
        require_login
        if [[ -n "$T_GAME" ]]; then use_game_for "$T_GAME"; else need_game; fi
        acquire_lock
        [[ -n "$IS_PREMIUM" ]] || refresh_account || true
        [[ -n "$file_id" ]] && T_FILE="$file_id"
        install_nexus_mod "$T_MOD" "$T_FILE" "$T_KEY" "$T_EXP" "$fomod" "$name_override"
    else
        die "Don't know how to install '${target}'. Give a mod id, a Nexus URL, an nxm:// link, an archive or a collection URL."
    fi
    if (( deploy_after )); then echo ""; cmd_deploy; else after_change; fi
}

# ══════════════════════════════════════════════════════════
# COMMAND: download <target> — fetch archives without installing
# ══════════════════════════════════════════════════════════
cmd_download() {
    local target="" file_id=""
    local -a rest=()
    while (( $# )); do
        case "$1" in
            --file|-f) file_id="${2:-}"; shift ;;
            *)         if [[ -z "$target" ]]; then target="$1"; else rest+=("$1"); fi ;;
        esac
        shift
    done
    [[ -n "$target" ]] || die "Usage: ${PROG} download <collection-url | mod-id | nexus-url | nxm-link>"
    if [[ "$target" == *collections/* ]]; then
        collection_install "$target" --download-only "${rest[@]+"${rest[@]}"}"
        return 0
    fi
    parse_mod_target "$target" || die "Cannot parse '${target}'."
    require_login
    if [[ -n "$T_GAME" ]]; then use_game_for "$T_GAME"; else need_game; fi
    [[ -n "$IS_PREMIUM" ]] || refresh_account || true
    [[ -n "$file_id" ]] && T_FILE="$file_id"
    if [[ -z "$T_FILE" ]]; then
        local files_json
        files_json=$(rest_get "/games/${G_DOMAIN}/mods/${T_MOD}/files.json") || die "Could not list files: $(api_error_msg "$files_json")"
        T_FILE=$(choose_file "$files_json") || exit 1
    fi
    download_nexus_file "$G_DOMAIN" "$T_MOD" "$T_FILE" "" "" "$T_KEY" "$T_EXP" || die "Download failed."
    success "Saved → ${DL_RESULT}"
}

# ══════════════════════════════════════════════════════════
# COMMAND: list
# ══════════════════════════════════════════════════════════
cmd_list() {
    local only="" col="" text=""
    while (( $# )); do
        case "$1" in
            --enabled|-e)    only=enabled ;;
            --disabled|-d)   only=disabled ;;
            --collection|-c) col="${2:-}"; shift ;;
            -*)              die "Unknown option for list: $1" ;;
            *)               text="$1" ;;
        esac
        shift
    done
    need_game
    local total enabled
    total=$(db_count); enabled=$(jq '[.mods[] | select(.enabled)] | length' "$DB_FILE")
    banner "Mods — ${G_NAME}"
    if (( total == 0 )); then
        info "No mods installed. Try: ${PROG} install <mod-id|url>  or  ${PROG} collection install <url>"
        return 0
    fi
    local cols namew
    cols=$(term_cols); namew=$(( cols - 52 )); (( namew < 20 )) && namew=20; (( namew > 70 )) && namew=70
    printf "  ${BOLD}%-5s %-2s %-*s %-12s %-8s %s${RESET}\n" "#" "" "$namew" "Name" "Version" "Nexus" "Collection"
    local pos en name ver modid cols_s shown=0
    while IFS="$SEP" read -r pos en name ver modid cols_s; do
        local mark="${GREEN}✓${RESET}"; [[ "$en" == true ]] || mark="${DIM}·${RESET}"
        local tname; tname=$(trunc "$name" "$namew")
        printf "  ${DIM}%-5s${RESET} %b  %s%*s %-12s %-8s ${DIM}%s${RESET}\n" "$pos" "$mark" "$tname" $(( namew - ${#tname} )) "" \
            "$(trunc "$ver" 12)" "${modid:--}" "$(trunc "$cols_s" 20)"
        shown=$(( shown + 1 ))
    done < <(jq -r --arg only "$only" --arg col "$col" --arg q "${text,,}" "$JQ_DEFS"'
        .mods | to_entries[]
        | select($only == "" or ($only == "enabled" and .value.enabled) or ($only == "disabled" and (.value.enabled | not)))
        | select($col == "" or ((.value.collections // []) | index($col)))
        | select($q == "" or ((.value.name | ascii_downcase | contains($q)) or (.value.id | ascii_downcase | contains($q))))
        | [.key + 1, .value.enabled, .value.name, .value.version, .value.modId, ((.value.collections // []) | join(","))] | row' "$DB_FILE")
    echo ""
    local size; size=$(jq '[.mods[].size // 0] | add // 0' "$DB_FILE")
    echo -e "  ${shown} shown · ${total} installed · ${enabled} enabled · $(human_size "$size") staged"
    if [[ "$DB_FILE" -nt "${GDATA}/deployed.stamp" ]] && (( enabled > 0 )); then
        echo -e "  ${YELLOW}Mods changed since the last deploy — run: ${PROG} deploy${RESET}"
    fi
    echo -e "  ${DIM}Higher # = higher priority (wins file conflicts). Reorder: ${PROG} order <mod> <position>${RESET}"
}

# ══════════════════════════════════════════════════════════
# COMMAND: info <mod>
# ══════════════════════════════════════════════════════════
cmd_info() {
    [[ -n "${1:-}" ]] || die "Usage: ${PROG} info <mod>"
    need_game
    local id rec pos
    id=$(resolve_mod "$1") || exit 1
    rec=$(db_get "$id")
    pos=$(jq -r --arg id "$id" '.mods | map(.id) | index($id) + 1' "$DB_FILE")
    banner "$(jq -r '.name' <<< "$rec")"
    jq -r --arg pos "$pos" --arg site "$SITE_URL" --arg game "$G_DOMAIN" --arg dir "$MODS_DIR" '
        def d: if . == null or . == "" then "—" else tostring end;
        "  ID          : \(.id)",
        "  Position    : #\($pos)   \(if .enabled then "enabled" else "disabled" end)",
        "  Version     : \(.version | d)",
        "  Author      : \(.author | d)",
        "  Source      : \(.source | d)\(if .modId then "   \($site)/\($game)/mods/\(.modId)?tab=files&file_id=\(.fileId)" else "" end)",
        "  Archive     : \(.archive | d)",
        "  Staged at   : \($dir)/\(.id)",
        "  Files       : \(.files // 0)  (\(((.size // 0) / 1048576 * 10 | floor) / 10) MB)",
        "  Deploys to  : \(if .root == "game" then "game root" else "deploy folder" end)",
        "  Collections : \((.collections // []) | if length == 0 then "—" else join(", ") end)",
        "  Variant     : \(.variant | d)",
        "  Installed   : \(.installed | if . then (strflocaltime("%Y-%m-%d %H:%M")) else "—" end)",
        (if (.fomod // null) != null then "  FOMOD       :", (.fomod.options[]? | "      \(.name): " + ([.groups[]? | .choices[]?.name] | join(", "))) else empty end)' <<< "$rec"
    if [[ "$(jq -r '.enabled' <<< "$rec")" == true ]]; then
        build_plan
        local wins=0 loses=0 key prov
        for key in "${!P_PROV[@]}"; do
            prov="${P_PROV[$key]}"
            [[ "$prov" == *"$SEP"* && "${SEP}${prov}${SEP}" == *"${SEP}${id}${SEP}"* ]] || continue
            if [[ "${P_OWNER[$key]}" == "$id" ]]; then wins=$(( wins + 1 )); else loses=$(( loses + 1 )); fi
        done
        echo "  Conflicts   : wins ${wins} file(s), overridden on ${loses}  (details: ${PROG} conflicts '${id}' --files)"
    fi
    local modid; modid=$(jq -r '.modId // empty' <<< "$rec")
    if [[ -n "$modid" ]]; then
        deps_fetch "$modid"
        deps_report full "$(deps_scope_json "$id")"
    fi
}

# ══════════════════════════════════════════════════════════
# COMMAND: deps [mod] [--refresh] | deps ack|unack <name>
# ══════════════════════════════════════════════════════════
cmd_deps() {
    local refresh="" ref="" sub=""
    case "${1:-}" in ack|unack) sub="$1"; shift ;; esac
    while (( $# )); do
        case "$1" in
            --refresh|-r) refresh=--refresh ;;
            -*)           die "Unknown option for deps: $1" ;;
            *)            ref="${ref:+$ref }$1" ;;
        esac
        shift
    done
    need_game
    local ack_f="${GDATA}/deps-ack.json"
    [[ -s "$ack_f" ]] || echo '[]' > "$ack_f"
    local -a ids=()
    mapfile -t ids < <(jq -r '.mods[] | select(.modId != null) | .modId' "$DB_FILE")

    if [[ -n "$sub" ]]; then
        [[ -n "$ref" ]] || die "Usage: ${PROG} deps ${sub} <requirement name>"
        deps_fetch ${refresh} "${ids[@]+"${ids[@]}"}"
        local rows match="" n=0 status key name rest
        rows=$(deps_rows "$(deps_scope_json)")
        while IFS="$SEP" read -r status key name rest; do
            [[ -n "$key" ]] || continue
            if [[ "$sub" == ack ]]; then
                [[ "$status" == external || "$status" == missing ]] || continue
            else
                jq -e --arg k "$key" 'index($k) != null' "$ack_f" >/dev/null || continue
            fi
            if [[ "${name,,}" == "${ref,,}" || "$key" == "$ref" ]]; then match="${key}${SEP}${name}"; n=1; break; fi
            [[ "${name,,}" == *"${ref,,}"* ]] && { match="${key}${SEP}${name}"; n=$(( n + 1 )); }
        done <<< "$rows"
        (( n == 1 )) || die "$( (( n == 0 )) && echo "No requirement matches '${ref}'." || echo "'${ref}' matches ${n} requirements — be more specific.") See: ${PROG} deps"
        key="${match%%"$SEP"*}"; name="${match#*"$SEP"}"
        if [[ "$sub" == ack ]]; then
            jq --arg k "$key" '. + [$k] | unique' "$ack_f" > "${ack_f}.tmp" && mv -f -- "${ack_f}.tmp" "$ack_f"
            success "Marked ${BOLD}${name}${RESET} as installed."
        else
            jq --arg k "$key" 'map(select(. != $k))' "$ack_f" > "${ack_f}.tmp" && mv -f -- "${ack_f}.tmp" "$ack_f"
            success "${name} will be checked again."
        fi
        return 0
    fi

    if [[ -n "$ref" ]]; then
        local id rec modid
        id=$(resolve_mod "$ref") || exit 1
        rec=$(db_get "$id"); modid=$(jq -r '.modId // empty' <<< "$rec")
        [[ -n "$modid" ]] || die "${id} is not a Nexus mod — its requirements are unknown."
        banner "Requirements — $(jq -r '.name' <<< "$rec")"
        deps_fetch ${refresh} "$modid"
        deps_report full "$(deps_scope_json "$id")" "Requirements"
        return 0
    fi
    banner "Requirements — ${G_NAME}"
    mapfile -t ids < <(jq -r '.mods[] | select(.enabled and .modId != null) | .modId' "$DB_FILE")
    (( ${#ids[@]} )) || { info "No enabled Nexus mods."; return 0; }
    deps_fetch ${refresh} "${ids[@]}"
    deps_report full "$(deps_scope_json)" "Requirements of ${#ids[@]} enabled mods"
}

# ══════════════════════════════════════════════════════════
# COMMAND: enable / disable
# ══════════════════════════════════════════════════════════
cmd_set_enabled() {
    local val="$1"; shift
    local all=0 col="" refs=() ids=() r id
    while (( $# )); do
        case "$1" in
            --all|-a)        all=1 ;;
            --collection|-c) col="${2:-}"; shift ;;
            *)               refs+=("$1") ;;
        esac
        shift
    done
    (( all )) || [[ -n "$col" ]] || (( ${#refs[@]} )) || die "Usage: ${PROG} $( [[ $val == true ]] && echo enable || echo disable ) <mod...> | --all | --collection <slug>"
    need_game
    acquire_lock
    if (( all )); then
        mapfile -t ids < <(jq -r '.mods[].id' "$DB_FILE")
    elif [[ -n "$col" ]]; then
        mapfile -t ids < <(jq -r --arg c "$col" '.mods[] | select((.collections // []) | index($c)) | .id' "$DB_FILE")
        (( ${#ids[@]} )) || die "No mods belong to collection '${col}'."
    fi
    for r in "${refs[@]+"${refs[@]}"}"; do id=$(resolve_mod "$r") || exit 1; ids+=("$id"); done
    db_update --argjson ids "$(json_array "${ids[@]}")" --argjson v "$val" '.mods |= map(if (.id | IN($ids[])) then .enabled = $v else . end)'
    local word; [[ "$val" == true ]] && word="Enabled" || word="Disabled"
    if (( ${#ids[@]} <= 10 )); then for id in "${ids[@]}"; do success "${word}: ${id}"; done
    else success "${word} ${#ids[@]} mods."; fi
    after_change
}

# ══════════════════════════════════════════════════════════
# COMMAND: uninstall <mod...>
# ══════════════════════════════════════════════════════════
uninstall_ids() {   # uninstall_ids <keep-archive 0|1> <id...>
    local keep="$1"; shift
    local id arch others
    for id in "$@"; do
        arch=$(jq -r --arg id "$id" '.mods[] | select(.id == $id) | .archive // empty' "$DB_FILE")
        rm -rf -- "${MODS_DIR:?}/${id}"
        if [[ "$keep" == 0 && -n "$arch" && -f "$arch" && "$arch" == "${DL_DIR}"/* ]]; then
            others=$(jq --arg a "$arch" --arg id "$id" '[.mods[] | select(.archive == $a and .id != $id)] | length' "$DB_FILE")
            if (( others == 0 )); then
                rm -f -- "$arch"
                grep -lF "\"${arch##*/}\"" "${DL_DIR}/.meta/"*.json 2>/dev/null | xargs -r rm -f -- || true
            fi
        fi
    done
    db_update --argjson ids "$(json_array "$@")" \
        '.mods |= map(select(.id | IN($ids[]) | not)) | .collections |= map_values(.mods |= map(select(IN($ids[]) | not)))'
}

cmd_uninstall() {
    local keep=1 refs=() ids=() r id
    while (( $# )); do
        case "$1" in
            --delete-archive|--purge-archive) keep=0 ;;
            -*) die "Unknown option for uninstall: $1" ;;
            *)  refs+=("$1") ;;
        esac
        shift
    done
    (( ${#refs[@]} )) || die "Usage: ${PROG} uninstall <mod...> [--delete-archive]"
    need_game
    acquire_lock
    for r in "${refs[@]}"; do id=$(resolve_mod "$r") || exit 1; ids+=("$id"); done
    for id in "${ids[@]}"; do echo -e "  ${RED}−${RESET} ${id}"; done
    confirm "Uninstall ${#ids[@]} mod(s)?" Y || { info "Cancelled."; return 0; }
    uninstall_ids "$keep" "${ids[@]}"
    success "Uninstalled ${#ids[@]} mod(s)."
    after_change
}

# ══════════════════════════════════════════════════════════
# COMMAND: reinstall <mod>
# ══════════════════════════════════════════════════════════
cmd_reinstall() {
    local ref="" fomod="reuse"
    while (( $# )); do
        case "$1" in
            --fomod) fomod="${2:-}"; shift ;;
            --ask)   fomod="ask" ;;
            *)       ref="$1" ;;
        esac
        shift
    done
    [[ -n "$ref" ]] || die "Usage: ${PROG} reinstall <mod> [--ask | --fomod ask|default|reuse]"
    need_game
    acquire_lock
    local id rec archive modid fileid md5 meta
    id=$(resolve_mod "$ref") || exit 1
    rec=$(db_get "$id")
    IFS="$SEP" read -r archive modid fileid md5 < <(jq -r "$JQ_DEFS"' [.archive, .modId, .fileId, .md5] | row' <<< "$rec")
    if [[ ! -e "$archive" ]]; then
        [[ -n "$modid" ]] || die "Archive missing: ${archive}"
        require_login
        [[ -n "$IS_PREMIUM" ]] || refresh_account || true
        download_nexus_file "$G_DOMAIN" "$modid" "$fileid" "$md5" || die "Could not re-download the archive."
        archive="$DL_RESULT"
    fi
    meta=$(jq -c --arg fm "$fomod" '. + {fomodMode: $fm, choices: (.fomod // null), reinstall: true}
        | if $fm == "ask" then .variant = "" else . end' <<< "$rec")
    info "Reinstalling ${id}..."
    install_archive "$archive" "$meta" || die "Reinstall failed."
    success "Reinstalled ${id}"
    after_change
}

# ══════════════════════════════════════════════════════════
# COMMAND: order <mod> <position | first | last | up [n] | down [n] | before <mod> | after <mod>>
# ══════════════════════════════════════════════════════════
cmd_order() {
    local ref="${1:-}" spec="${2:-}" arg="${3:-}"
    [[ -n "$ref" && -n "$spec" ]] || die "Usage: ${PROG} order <mod> <position | first | last | up [n] | down [n] | before <mod> | after <mod>>"
    need_game
    acquire_lock
    local id n cur new other oi
    id=$(resolve_mod "$ref") || exit 1
    n=$(db_count)
    cur=$(jq -r --arg id "$id" '.mods | map(.id) | index($id)' "$DB_FILE")
    case "$spec" in
        first|bottom|lowest) new=0 ;;
        last|top|highest)    new=$(( n - 1 )) ;;
        up)                  new=$(( cur + ${arg:-1} )) ;;
        down)                new=$(( cur - ${arg:-1} )) ;;
        before|after)
            [[ -n "$arg" ]] || die "Usage: ${PROG} order <mod> ${spec} <other-mod>"
            other=$(resolve_mod "$arg") || exit 1
            [[ "$other" != "$id" ]] || die "A mod cannot be ordered relative to itself."
            oi=$(jq -r --arg id "$other" --arg me "$id" '.mods | map(select(.id != $me)) | map(.id) | index($id)' "$DB_FILE")
            if [[ "$spec" == before ]]; then new=$oi; else new=$(( oi + 1 )); fi ;;
        \#*|[0-9]*)
            spec="${spec#\#}"
            [[ "$spec" =~ ^[0-9]+$ ]] || die "Invalid position: ${spec}"
            new=$(( spec - 1 )) ;;
        *) die "Invalid order spec '${spec}'" ;;
    esac
    (( new < 0 )) && new=0
    (( new > n - 1 )) && new=$(( n - 1 ))
    db_update --arg id "$id" --argjson new "$new" '
        (.mods | map(.id) | index($id)) as $i | .mods[$i] as $x
        | (.mods[:$i] + .mods[$i + 1:]) as $r
        | .mods = ($r[:$new] + [$x] + $r[$new:])'
    success "${id}: #$(( cur + 1 )) → #$(( new + 1 ))  (of ${n})"
    after_change
}

# ══════════════════════════════════════════════════════════
# COMMAND: updates [--install] [--all] [--refresh]
# ══════════════════════════════════════════════════════════
cmd_updates() {
    local do_install=0 include_exact=0 refresh=0
    while (( $# )); do
        case "$1" in
            -i|--install) do_install=1 ;;
            --all)        include_exact=1 ;;
            --refresh)    refresh=1 ;;
            *)            die "Unknown option for updates: $1" ;;
        esac
        shift
    done
    need_game
    require_login
    banner "Update check — ${G_NAME}"
    local -a modids=()
    mapfile -t modids < <(jq -r '[.mods[] | select(.modId != null) | .modId] | unique | .[]' "$DB_FILE")
    if (( ${#modids[@]} == 0 )); then info "No Nexus mods installed."; return 0; fi

    # One request tells us which mods changed during the last month.
    local -A UPDATED=()
    local body m t
    if body=$(rest_get "/games/${G_DOMAIN}/mods/updated.json?period=1m"); then
        while IFS="$SEP" read -r m t; do UPDATED[$m]="$t"; done < <(jq -r "$JQ_DEFS"' .[] | [.mod_id, .latest_file_update] | row' <<< "$body")
    fi
    local k=0 cf age mtime fetched=0 nowts
    nowts=$(now)
    for m in "${modids[@]}"; do
        k=$(( k + 1 ))
        cf="${CACHE_DIR}/files-${m}.json"
        if [[ -f "$cf" ]] && (( ! refresh )); then
            mtime=$(stat -c %Y -- "$cf"); age=$(( nowts - mtime ))
            if (( age < 21600 )); then continue; fi
            if (( age < 2419200 )) && { [[ -z "${UPDATED[$m]:-}" ]] || (( ${UPDATED[$m]} < mtime )); }; then
                touch -- "$cf"; continue
            fi
        fi
        [[ -t 1 ]] && printf '\r  checking %d/%d (mod %s)…   ' "$k" "${#modids[@]}" "$m"
        if body=$(rest_get "/games/${G_DOMAIN}/mods/${m}/files.json"); then
            jq -c '{files: [.files[] | {file_id, name, version, category_name, file_name, size_in_bytes, uploaded_timestamp}],
                    file_updates: [.file_updates[] | {old_file_id, new_file_id}]}' <<< "$body" > "$cf"
            fetched=$(( fetched + 1 ))
        fi
        local rl; rl=$(cut -d' ' -f1 "$RATELIMIT_FILE" 2>/dev/null || echo "")
        if [[ "$rl" =~ ^[0-9]+$ ]] && (( rl < 20 )); then
            echo ""; warn "Hourly API limit almost used up — stopping early (re-run later)."; break
        fi
    done
    [[ -t 1 ]] && printf '\r%*s\r' 60 ''
    info "Checked ${#modids[@]} mods (${fetched} refreshed from Nexus)."

    # Compare installed files with the end of each file's update chain.
    local -a updates=()
    local id name ver modid fileid policy row
    while IFS="$SEP" read -r id name ver modid fileid policy; do
        cf="${CACHE_DIR}/files-${modid}.json"
        [[ -f "$cf" ]] || continue
        row=$(jq -r --argjson f "$fileid" "$JQ_DEFS"'
            (.file_updates | map({key: (.old_file_id | tostring), value: .new_file_id}) | from_entries) as $u
            | ([.files[] | select(.category_name != "ARCHIVED" and .category_name != "DELETED") | .file_id]) as $live
            | ([limit(100; $f | recurse(if $u[tostring] then $u[tostring] else empty end))]
               | map(select(. as $x | $live | index($x))) | last) as $new
            | if $new != null and $new != $f then
                (.files[] | select(.file_id == $new) | [$new, .version, .name, .size_in_bytes] | row)
              else empty end' "$cf" 2>/dev/null | head -1) || true
        [[ -n "$row" ]] || continue
        updates+=("${id}${SEP}${name}${SEP}${ver}${SEP}${modid}${SEP}${policy}${SEP}${row}")
    done < <(jq -r "$JQ_DEFS"' .mods[] | select(.modId != null and .fileId != null) | [.id, .name, .version, .modId, .fileId, .updatePolicy] | row' "$DB_FILE")

    if (( ${#updates[@]} == 0 )); then success "All mods are up to date."; return 0; fi
    echo ""
    local u nfile nver nname nsize pinned=0
    for u in "${updates[@]}"; do
        IFS="$SEP" read -r id name ver modid policy nfile nver nname nsize <<< "$u"
        local tag=""; [[ "$policy" == exact ]] && { tag=" ${DIM}(pinned by collection)${RESET}"; pinned=$(( pinned + 1 )); }
        printf "  ${YELLOW}↑${RESET} %-40s %s → ${GREEN}%s${RESET}  ${DIM}%s${RESET}%b\n" "$(trunc "$name" 40)" "${ver:-?}" "${nver:-?}" "$(trunc "$nname" 40)" "$tag"
    done
    echo ""
    info "${#updates[@]} update(s) available$( (( pinned )) && echo ", ${pinned} pinned by a collection (use --all to include)")."
    if (( ! do_install )); then
        info "Install them with: ${PROG} updates --install"
        return 0
    fi
    acquire_lock
    [[ -n "$IS_PREMIUM" ]] || refresh_account || true
    local done_n=0 rec meta
    for u in "${updates[@]}"; do
        IFS="$SEP" read -r id name ver modid policy nfile nver nname nsize <<< "$u"
        [[ "$policy" == exact && "$include_exact" == 0 ]] && continue
        echo -e "\n  ${CYAN}Updating${RESET} ${BOLD}${name}${RESET} ${ver} → ${nver}"
        if ! download_nexus_file "$G_DOMAIN" "$modid" "$nfile"; then error "Download failed for ${name}"; continue; fi
        rec=$(db_get "$id")
        meta=$(jq -c --argjson f "$nfile" --arg v "$nver" --arg rep "$id" --arg md5 "$(md5sum -- "$DL_RESULT" | cut -d' ' -f1)" \
            '{name, version: $v, modId, fileId: $f, md5: $md5, source, author, category, updatePolicy,
              collections, choices: .fomod, variant, fomodMode: "reuse", replaces: $rep}' <<< "$rec")
        if install_archive "$DL_RESULT" "$meta"; then
            success "Updated → ${INSTALLED_ID}"; done_n=$(( done_n + 1 ))
        fi
    done
    echo ""
    success "${done_n} mod(s) updated."
    after_change
}

# ══════════════════════════════════════════════════════════
# COMMAND: search <text>
# ══════════════════════════════════════════════════════════
cmd_search() {
    local q="$*"
    [[ -n "$q" ]] || die "Usage: ${PROG} search <text>"
    need_game
    local data vars
    vars=$(jq -cn --arg d "$G_DOMAIN" --arg q "$q" '{d: $d, q: $q}')
    data=$(gql_query 'query($d: String!, $q: String!) {
        mods(filter: {gameDomainName: [{value: $d, op: EQUALS}], nameStemmed: [{value: $q, op: MATCHES}]},
             sort: [{relevance: {direction: DESC}}], count: 25) {
          totalCount nodes { modId name author version summary downloads endorsements } } }' "$vars") \
        || die "Search failed: $(api_error_msg "$data")"
    banner "Search — \"${q}\" (${G_NAME})"
    local -A INST=()
    local m id name author ver summary dls ends
    while IFS= read -r m; do [[ -n "$m" ]] && INST[$m]=1; done < <(jq -r '.mods[].modId // empty' "$DB_FILE")
    local cols; cols=$(term_cols)
    while IFS="$SEP" read -r id name author ver summary dls ends; do
        local mark="  "; [[ -n "${INST[$id]+x}" ]] && mark="${GREEN}✓ ${RESET}"
        printf "  %b${CYAN}%-7s${RESET} ${BOLD}%s${RESET} ${DIM}%s by %s · %s downloads · %s endorsements${RESET}\n" \
            "$mark" "$id" "$(trunc "$name" 50)" "v${ver#[vV]}" "$(trunc "$author" 20)" "$dls" "$ends"
        [[ -n "$summary" ]] && printf "           ${DIM}%s${RESET}\n" "$(trunc "$summary" $(( cols - 12 )))"
    done < <(jq -r "$JQ_DEFS"' .mods.nodes[] | [.modId, .name, .author, .version, .summary, .downloads, .endorsements] | row' <<< "$data")
    echo ""
    info "$(jq -r '.mods.totalCount' <<< "$data") result(s). Install with: ${PROG} install <id>"
}

# ══════════════════════════════════════════════════════════
# COMMAND: profile save|load|list|delete <name>
# Profiles snapshot the load order and enabled state.
# ══════════════════════════════════════════════════════════
cmd_profile() {
    local sub="${1:-list}" name="${2:-}" f
    need_game
    case "$sub" in
        list|ls)
            banner "Profiles — ${G_NAME}"
            local any=0
            for f in "${PROFILES_DIR}"/*.json; do
                [[ -f "$f" ]] || continue
                any=1
                echo -e "  ${CYAN}•${RESET} ${BOLD}$(basename "$f" .json)${RESET}  ${DIM}$(jq -r '"\(.mods | length) mods, \([.mods[] | select(.enabled)] | length) enabled, saved \(.saved | strflocaltime("%Y-%m-%d %H:%M"))"' "$f")${RESET}"
            done
            (( any )) || info "No profiles yet. Save one with: ${PROG} profile save <name>" ;;
        save)
            [[ -n "$name" ]] || die "Usage: ${PROG} profile save <name>"
            [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "Profile names may contain letters, digits, . _ -"
            f="${PROFILES_DIR}/${name}.json"
            [[ -f "$f" ]] && ! confirm "Overwrite profile '${name}'?" Y && return 0
            jq --argjson now "$(now)" '{saved: $now, mods: [.mods[] | {id, enabled}]}' "$DB_FILE" > "$f"
            success "Saved profile '${name}' ($(jq '.mods | length' "$f") mods)." ;;
        load|use)
            [[ -n "$name" ]] || die "Usage: ${PROG} profile load <name>"
            f="${PROFILES_DIR}/${name}.json"
            [[ -f "$f" ]] || die "No profile named '${name}'."
            acquire_lock
            local missing
            missing=$(jq -r --slurpfile db "$DB_FILE" '[.mods[].id] - [$db[0].mods[].id] | length' "$f")
            db_update --slurpfile p "$f" '
                ($p[0].mods | map({key: .id, value: .enabled}) | from_entries) as $en
                | (.mods | map({key: .id, value: .}) | from_entries) as $by
                | .mods = ([ $p[0].mods[] | $by[.id] // empty | .enabled = $en[.id] ]
                           + [ .mods[] | select($en[.id] == null) | .enabled = false ])'
            success "Loaded profile '${name}'."
            (( missing > 0 )) && warn "${missing} mod(s) from the profile are no longer installed."
            after_change ;;
        delete|rm)
            [[ -n "$name" ]] || die "Usage: ${PROG} profile delete <name>"
            f="${PROFILES_DIR}/${name}.json"
            [[ -f "$f" ]] || die "No profile named '${name}'."
            rm -f -- "$f"; success "Deleted profile '${name}'." ;;
        *) die "Usage: ${PROG} profile list | save <name> | load <name> | delete <name>" ;;
    esac
}

# ══════════════════════════════════════════════════════════
# COMMAND: clean — remove unreferenced downloads and temp files
# ══════════════════════════════════════════════════════════
cmd_clean() {
    need_game
    acquire_lock
    banner "Clean — ${G_NAME}"
    local -A REF=()
    local a f bytes=0
    local -a cands=()
    while IFS= read -r a; do [[ -n "$a" ]] && REF[$a]=1; done < <(jq -r '.mods[].archive // empty' "$DB_FILE")
    while IFS= read -r -d '' f; do
        [[ -n "${REF[$f]+x}" ]] && continue
        cands+=("$f"); bytes=$(( bytes + $(stat -c %s -- "$f") ))
    done < <(find "$DL_DIR" -mindepth 1 -maxdepth 1 -type f -print0)
    rm -rf -- "${TMP_DIR:?}"/* "${CONFIG_DIR}/tmp"/run.* 2>/dev/null || true
    if (( ${#cands[@]} == 0 )); then
        success "No unreferenced downloads. Temporary files removed."
        return 0
    fi
    for f in "${cands[@]}"; do echo -e "  ${DIM}${f##*/}${RESET}"; done
    echo ""
    info "${#cands[@]} archive(s) not used by any installed mod ($(human_size "$bytes"))."
    info "Note: reinstalling or updating mods from these archives would need a re-download."
    confirm "Delete them?" N || { info "Kept."; return 0; }
    rm -f -- "${cands[@]}"
    for f in "${DL_DIR}/.meta/"*.json; do
        [[ -f "$f" ]] || continue
        a=$(jq -r '.file // empty' "$f" 2>/dev/null || true)
        [[ -n "$a" && -f "${DL_DIR}/${a}" ]] || rm -f -- "$f"
    done
    success "Freed $(human_size "$bytes")."
}

# ══════════════════════════════════════════════════════════
# COMMAND: launch — start the game through Steam
# ══════════════════════════════════════════════════════════
cmd_launch() {
    need_game
    [[ -n "$G_APPID" ]] || die "No Steam app id for ${G_NAME}. Set one with: ${PROG} game set appid <id>"
    local enabled; enabled=$(jq '[.mods[] | select(.enabled)] | length' "$DB_FILE")
    if (( enabled > 0 )) && [[ "$DB_FILE" -nt "${GDATA}/deployed.stamp" ]]; then
        warn "Mods changed since the last deploy."
        if confirm "Deploy before launching?" Y; then cmd_deploy; exec 9>&-; fi
    fi
    info "Launching ${G_NAME} (Steam app ${G_APPID})..."
    if have steam; then
        (setsid steam "steam://rungameid/${G_APPID}" >/dev/null 2>&1 &)
    else
        open_url "steam://rungameid/${G_APPID}"
    fi
}

cmd_log() {
    local follow=0 n=40
    while (( $# )); do
        case "$1" in
            -f|--follow) follow=1 ;;
            [0-9]*)      n="$1" ;;
            *)           die "Usage: ${PROG} log [-f] [lines]" ;;
        esac
        shift
    done
    if (( follow )); then tail -n "$n" -f -- "$NMM_LOG"; else tail -n "$n" -- "$NMM_LOG"; fi
}

# ══════════════════════════════════════════════════════════
# COMMAND: config [key] [value]
# ══════════════════════════════════════════════════════════
config_var() {
    case "$1" in
        data-dir)      echo DATA_DIR ;;
        deploy-method) echo DEPLOY_METHOD ;;
        jobs)          echo DOWNLOAD_JOBS ;;
        cdn)           echo PREFERRED_CDN ;;
        adult)         echo VIEW_ADULT ;;
        auto-deploy)   echo AUTO_DEPLOY ;;
        fomod)         echo FOMOD_MODE ;;
        *)             return 1 ;;
    esac
}

cmd_config() {
    local key="${1:-}" val="${2-}" var
    if [[ -z "$key" ]]; then
        banner "Configuration"
        printf "  %-14s %s\n" "data-dir" "$DATA_DIR" "deploy-method" "$DEPLOY_METHOD  (auto|hardlink|symlink|copy)" \
            "jobs" "$DOWNLOAD_JOBS  (parallel downloads, Premium)" "cdn" "${PREFERRED_CDN:-auto}  (preferred download server)" \
            "adult" "$VIEW_ADULT  (show adult-only collections)" "auto-deploy" "$AUTO_DEPLOY  (deploy after every change)" \
            "fomod" "$FOMOD_MODE  (auto|ask|default — installer behaviour for single mods)"
        echo ""
        echo -e "  ${DIM}Change with: ${PROG} config <key> <value>   ·   file: ${CONFIG_FILE}${RESET}"
        return 0
    fi
    var=$(config_var "$key") || die "Unknown setting '${key}'. Keys: data-dir deploy-method jobs cdn adult auto-deploy fomod"
    if [[ $# -lt 2 ]]; then echo "${!var}"; return 0; fi
    case "$key" in
        deploy-method) [[ "$val" =~ ^(auto|hardlink|symlink|copy)$ ]] || die "deploy-method must be auto, hardlink, symlink or copy" ;;
        jobs)          [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 1 && val <= 16 )) || die "jobs must be 1-16" ;;
        adult|auto-deploy) [[ "$val" =~ ^(true|false)$ ]] || die "${key} must be true or false" ;;
        fomod)         [[ "$val" =~ ^(auto|ask|default)$ ]] || die "fomod must be auto, ask or default" ;;
        data-dir)
            val="${val/#\~/$HOME}"; val="${val%/}"
            [[ "$val" == /* ]] || die "data-dir must be an absolute path"
            if [[ -d "$DATA_DIR" && -n "$(ls -A "$DATA_DIR" 2>/dev/null)" && "$val" != "$DATA_DIR" ]]; then
                warn "Existing data in ${DATA_DIR} is not moved automatically. Purge deployments first, then move it yourself:"
                echo "    mv '${DATA_DIR}' '${val}'"
            fi ;;
    esac
    printf -v "$var" '%s' "$val"
    [[ "$var" == DATA_DIR ]] && CFG_DATA_DIR="$val"
    save_config
    success "${key} = ${val}"
}

# ══════════════════════════════════════════════════════════
# COMMAND: game list|add|use|remove|info|set|detect
# ══════════════════════════════════════════════════════════
game_add_flow() {   # game_add_flow <domain> [path] [subdir] [profile]
    local domain="${1,,}" path="${2:-}" subdir="${3:-}" profile="${4:-}" body detected
    [[ "$domain" =~ ^[a-z0-9]+$ ]] || die "Invalid game domain '${domain}' (as in nexusmods.com/<domain>/mods/...)"
    if game_exists "$domain"; then
        load_game "$domain"
    else
        game_defaults "$domain"
    fi
    if [[ -n "$NEXUS_API_KEY" ]]; then
        if body=$(rest_get "/games/${domain}.json"); then
            game_preset "$domain" >/dev/null || G_NAME=$(jq -r '.name // empty' <<< "$body")
            G_NEXUS_ID=$(jq -r '.id // empty' <<< "$body")
        else
            die "Nexus does not know the game domain '${domain}': $(api_error_msg "$body")"
        fi
    fi
    if ! game_preset "$domain" >/dev/null; then
        info "No built-in preset for ${G_NAME} — using generic settings."
        if [[ -z "$profile" ]] && is_interactive; then
            ask profile "Layout profile (${KNOWN_PROFILES})" generic
        fi
        if [[ -z "$subdir" ]] && is_interactive; then
            ask subdir "Folder inside the game where mods go (. = game root)" .
        fi
    fi
    [[ -n "$profile" ]] && G_PROFILE="$profile"
    [[ " $KNOWN_PROFILES " == *" $G_PROFILE "* ]] || die "Unknown profile '${G_PROFILE}'. Choose one of: ${KNOWN_PROFILES}"
    [[ -n "$subdir" ]] && G_SUBDIR="$subdir"

    if [[ -z "$path" ]]; then
        detected=$(steam_app_dir "$G_APPID" 2>/dev/null || true)
        if [[ -n "$detected" ]]; then
            info "Found ${G_NAME} in Steam: ${detected}"
            if is_interactive && ! confirm "Use this folder?" Y; then detected=""; fi
        fi
        path="$detected"
        if [[ -z "$path" ]]; then
            [[ -n "$G_FOLDER" ]] && path="$G_FOLDER"
            is_interactive || [[ -n "$path" ]] || die "Game folder not found automatically — pass it: ${PROG} game add ${domain} <path>"
            ask path "Absolute path to the ${G_NAME} folder" "$path"
        fi
    fi
    path="${path/#\~/$HOME}"; path="${path%/}"
    [[ "$path" == /* ]] || die "The game folder must be an absolute path."
    [[ -d "$path" ]] || warn "Folder does not exist yet: ${path}"
    G_FOLDER="$path"
    [[ -z "$G_PREFIX" ]] && G_PREFIX=$(steam_prefix "$G_APPID" 2>/dev/null || true)
    if [[ "$G_PROFILE" == bethesda && -z "$G_PLUGINS" ]]; then G_PLUGINS=$(detect_plugins_file 2>/dev/null || true); fi
    save_game "$domain"
    if [[ -z "$GAME_DOMAIN" || "$GAME_DOMAIN" == "$domain" ]] || confirm "Make ${G_NAME} the active game?" Y; then
        GAME_DOMAIN="$domain"; save_config
    fi
    load_game "$domain"
    success "Game ${BOLD}${G_NAME}${RESET} (${domain}) configured."
    echo -e "    Folder : ${G_FOLDER}"
    echo -e "    Mods go: ${G_FOLDER}/$(deploy_base_rel)   ${DIM}(profile: ${G_PROFILE})${RESET}"
    [[ -n "$G_PLUGINS" ]] && echo -e "    Plugins: ${G_PLUGINS}"
    echo -e "    Data   : ${GDATA}"
    return 0
}

cmd_game() {
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list|ls)
            banner "Games"
            local d any=0
            while IFS= read -r d; do
                [[ -n "$d" ]] || continue
                any=1
                ( load_game "$d"
                  local mark="  "; [[ "$d" == "${FORCE_GAME:-$GAME_DOMAIN}" ]] && mark="${GREEN}* ${RESET}"
                  local cnt; cnt=$(db_count)
                  local dep="not deployed"; deployment_active && dep="${GREEN}deployed${RESET}"
                  echo -e "  ${mark}${BOLD}${d}${RESET}  ${G_NAME}  ${DIM}— ${cnt} mods, ${RESET}${dep}"
                  echo -e "      ${DIM}${G_FOLDER:-<no folder>}${RESET}" )
            done < <(list_game_domains)
            (( any )) || info "No games configured. Run: ${PROG} game add <domain>   (see: ${PROG} game detect)" ;;
        add)
            local domain="" path="" subdir="" profile=""
            while (( $# )); do
                case "$1" in
                    --subdir)  subdir="${2:-}"; shift ;;
                    --profile) profile="${2:-}"; shift ;;
                    *) if [[ -z "$domain" ]]; then domain="$1"; else path="$1"; fi ;;
                esac
                shift
            done
            [[ -n "$domain" ]] || die "Usage: ${PROG} game add <domain> [path] [--subdir Data] [--profile generic]"
            game_add_flow "$domain" "$path" "$subdir" "$profile" ;;
        use|switch|select)
            [[ -n "${1:-}" ]] || die "Usage: ${PROG} game use <domain>"
            game_exists "$1" || die "Game '$1' is not set up. Run: ${PROG} game add $1"
            GAME_DOMAIN="$1"; save_config
            load_game "$1"; success "Active game: ${G_NAME}" ;;
        remove|rm)
            local d="${1:-}" delete_data=0
            [[ "${2:-}" == --delete-data ]] && delete_data=1
            [[ -n "$d" ]] || die "Usage: ${PROG} game remove <domain> [--delete-data]"
            load_game "$d"
            deployment_active && die "Mods are still deployed for ${G_NAME}. Run: ${PROG} -g ${d} purge"
            confirm "Forget ${G_NAME}?$( (( delete_data )) && echo " This also DELETES ${GDATA}")" N || return 0
            rm -f -- "${GAMES_DIR}/${d}.cfg"
            (( delete_data )) && rm -rf -- "${GDATA:?}"
            [[ "$GAME_DOMAIN" == "$d" ]] && { GAME_DOMAIN=""; save_config; }
            success "Removed ${d}." ;;
        info|show)
            [[ -n "${1:-}" ]] && FORCE_GAME="$1"
            need_game
            banner "${G_NAME} (${G_DOMAIN})"
            printf "  %-14s %s\n" "folder" "${G_FOLDER:-—}" "subdir" "$G_SUBDIR" "profile" "$G_PROFILE" \
                "appid" "${G_APPID:-—}" "method" "${G_METHOD:-(global: ${DEPLOY_METHOD})}" "prefix" "${G_PREFIX:-—}" \
                "plugins-file" "${G_PLUGINS:-—}" "paks-dir" "${G_EXTRA:-—}" "data" "$GDATA"
            echo ""
            echo -e "  ${DIM}Change with: ${PROG} game set <key> <value>${RESET}" ;;
        set)
            local key="${1:-}" val="${2-}"
            [[ -n "$key" && $# -ge 2 ]] || die "Usage: ${PROG} game set <folder|subdir|profile|appid|method|prefix|plugins-file|paks-dir|name> <value>"
            need_game
            if [[ "$key" == folder || "$key" == subdir || "$key" == profile ]] && deployment_active; then
                die "Purge the current deployment first (${PROG} purge) — it was made with the old setting."
            fi
            case "$key" in
                folder)       val="${val/#\~/$HOME}"; G_FOLDER="${val%/}"; [[ -d "$G_FOLDER" ]] || warn "Folder does not exist: ${G_FOLDER}" ;;
                subdir)       G_SUBDIR="${val:-.}" ;;
                profile)      [[ " $KNOWN_PROFILES " == *" $val "* ]] || die "Profiles: ${KNOWN_PROFILES}"; G_PROFILE="$val" ;;
                appid)        G_APPID="$val" ;;
                method)       [[ -z "$val" || "$val" =~ ^(auto|hardlink|symlink|copy)$ ]] || die "method: auto|hardlink|symlink|copy"; G_METHOD="$val" ;;
                prefix)       G_PREFIX="${val/#\~/$HOME}" ;;
                plugins-file) G_PLUGINS="${val/#\~/$HOME}" ;;
                paks-dir)     G_EXTRA="$val" ;;
                name)         G_NAME="$val" ;;
                *)            die "Unknown game setting '${key}'" ;;
            esac
            save_game "$G_DOMAIN"
            success "${G_DOMAIN}: ${key} = ${val}" ;;
        detect)
            banner "Installed games with presets"
            local d preset name appid dir found=0
            for d in cyberpunk2077 skyrimspecialedition enderalspecialedition skyrim fallout4 starfield newvegas fallout3 \
                     oblivion morrowind stardewvalley mountandblade2bannerlord witcher3 valheim outward schedule1 palworld \
                     clairobscurexpedition33 oblivionremastered eldenring control hades2 warhammer40000spacemarine2 monsterhunterwilds; do
                preset=$(game_preset "$d"); IFS='|' read -r name appid _ <<< "$preset"
                dir=$(steam_app_dir "$appid" 2>/dev/null || true)
                [[ -n "$dir" ]] || continue
                found=1
                local st="${YELLOW}not set up${RESET} → ${PROG} game add ${d}"; game_exists "$d" && st="${GREEN}configured${RESET}"
                echo -e "  ${BOLD}${d}${RESET}  ${name}  ${DIM}${dir}${RESET}\n      ${st}"
            done
            (( found )) || info "No supported Steam games found. Any Nexus game works: ${PROG} game add <domain> <path>" ;;
        *) die "Usage: ${PROG} game list | add | use | remove | info | set | detect" ;;
    esac
}

# ══════════════════════════════════════════════════════════
# COMMAND: login / logout
# ══════════════════════════════════════════════════════════
cmd_login() {
    banner "Nexus Mods — Login"
    echo -e "modman authenticates with your ${CYAN}Nexus Mods personal API key${RESET}."
    echo -e "  Get yours → ${YELLOW}${SITE_URL}/users/myaccount?tab=api${RESET}"
    echo ""
    local key="" body
    if [[ -t 0 ]]; then
        read -rsp "Paste your Nexus Mods API key: " key; echo ""
    else
        read -r key || true
    fi
    key="${key//[[:space:]]/}"
    [[ -n "$key" ]] || die "API key cannot be empty."
    NEXUS_API_KEY="$key"; CFG_API_KEY="$key"
    info "Validating key..."
    body=$(rest_get "/users/validate.json") || die "Authentication failed: $(api_error_msg "$body")"
    NEXUS_USER=$(jq -r '.name // ""' <<< "$body")
    IS_PREMIUM=$(jq -r 'if .is_premium then "true" else "false" end' <<< "$body")
    save_config
    success "Authenticated as ${BOLD}${NEXUS_USER}${RESET} <$(jq -r '.email // "?"' <<< "$body")>"
    if [[ "$IS_PREMIUM" == true ]]; then
        success "Account tier: ${GREEN}Premium${RESET} — direct and parallel downloads available ✓"
    else
        warn "Account tier: Free — each file needs a click on \"Slow download\" on the website."
        warn "Run '${PROG} nxm register' so the browser can hand links to modman."
    fi
    success "Config saved → ${CONFIG_FILE}"

    if [[ -z "$(list_game_domains)" ]] && is_interactive; then
        echo ""
        echo -e "${BOLD}Game Setup${RESET}"
        local d detected=() preset appid
        for d in cyberpunk2077 skyrimspecialedition fallout4 starfield newvegas stardewvalley witcher3 valheim palworld \
                 mountandblade2bannerlord clairobscurexpedition33 oblivionremastered eldenring; do
            preset=$(game_preset "$d"); appid=$(cut -d'|' -f2 <<< "$preset")
            steam_app_dir "$appid" >/dev/null 2>&1 && detected+=("$d")
        done
        (( ${#detected[@]} )) && info "Detected in Steam: ${detected[*]}"
        local domain
        ask domain "Game domain on Nexus (e.g. cyberpunk2077, skyrimspecialedition)" "${detected[0]:-}"
        [[ -n "$domain" ]] && game_add_flow "$domain" ""
    fi
    return 0
}

cmd_logout() {
    NEXUS_API_KEY=""; CFG_API_KEY=""; NEXUS_USER=""; IS_PREMIUM=""
    save_config
    success "API key removed from ${CONFIG_FILE}."
}

# ══════════════════════════════════════════════════════════
# COMMAND: nxm register|unregister|status|<link>
# ══════════════════════════════════════════════════════════
nxm_register() {
    have xdg-mime || die "xdg-mime not found (package: xdg-utils)."
    local appdir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    mkdir -p "$appdir"
    cat > "${appdir}/${NXM_DESKTOP}" <<DESKTOP
[Desktop Entry]
Type=Application
Name=modman (Nexus Mods)
Comment=Handle Nexus Mods "Mod manager download" links
Exec="${SELF}" nxm %u
Icon=applications-games
Terminal=false
NoDisplay=true
MimeType=x-scheme-handler/nxm;x-scheme-handler/nxm-protocol;
DESKTOP
    xdg-mime default "$NXM_DESKTOP" x-scheme-handler/nxm
    xdg-mime default "$NXM_DESKTOP" x-scheme-handler/nxm-protocol
    have update-desktop-database && update-desktop-database "$appdir" 2>/dev/null || true
    success "modman is now the handler for nxm:// links (${appdir}/${NXM_DESKTOP})."
    info "\"Mod manager download\" / \"Download with Vortex\" buttons on nexusmods.com now open modman."
}

nxm_unregister() {
    local appdir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    rm -f -- "${appdir}/${NXM_DESKTOP}"
    have update-desktop-database && update-desktop-database "$appdir" 2>/dev/null || true
    success "nxm:// handler removed."
}

open_terminal() {   # open_terminal <command...> — runs the command in a new terminal window
    local script t
    script="$(printf '%q ' "$@"); echo; read -rp 'Press Enter to close… ' _"
    for t in "${TERMINAL:-}" konsole gnome-terminal kitty alacritty wezterm foot xfce4-terminal tilix xterm; do
        [[ -n "$t" ]] && have "$t" || continue
        case "$t" in
            gnome-terminal|tilix) (setsid "$t" -- bash -c "$script" >/dev/null 2>&1 &) ;;
            kitty|foot)           (setsid "$t" bash -c "$script" >/dev/null 2>&1 &) ;;
            wezterm)              (setsid wezterm start -- bash -c "$script" >/dev/null 2>&1 &) ;;
            xfce4-terminal)       (setsid "$t" -x bash -c "$script" >/dev/null 2>&1 &) ;;
            *)                    (setsid "$t" -e bash -c "$script" >/dev/null 2>&1 &) ;;
        esac
        return 0
    done
    return 1
}

nxm_handle() {
    local url="$1" pid
    _log INFO "nxm link received: ${url%%\?*}"
    parse_nxm "$url" || { notify "Unrecognised nxm link"; die "Unrecognised nxm link: ${url}"; }
    if [[ "$NXM_KIND" == mod ]]; then
        # A modman process waiting for this file (free-account download)?
        if [[ -f "${NXM_QUEUE}/waiting.pid" ]] && pid=$(cat "${NXM_QUEUE}/waiting.pid" 2>/dev/null) \
           && [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            local qf="${NXM_QUEUE}/${NXM_GAME}-${NXM_MOD}-${NXM_FILE}.nxm"
            printf '%s\n' "$url" > "${qf}.tmp" && mv -f -- "${qf}.tmp" "$qf"
            return 0
        fi
    fi
    local -a cmd
    if [[ "$NXM_KIND" == mod ]]; then cmd=(install "$url"); else cmd=(collection install "$url"); fi
    if [[ -t 0 && -t 1 ]]; then
        if [[ "$NXM_KIND" == mod ]]; then cmd_install "$url"; else collection_install "$url"; fi
        return 0
    fi
    if open_terminal "$SELF" "${cmd[@]}"; then return 0; fi
    if [[ "$NXM_KIND" == mod ]]; then
        notify "Installing mod ${NXM_MOD} (${NXM_GAME})…"
        if ( ASSUME_YES=1; cmd_install "$url" ) >> "$NMM_LOG" 2>&1; then
            notify "Installed mod ${NXM_MOD}. Run 'modman deploy' to apply it."
        else
            notify "Installing mod ${NXM_MOD} failed — see ${NMM_LOG}"
        fi
    else
        notify "Open a terminal and run: modman collection install ${url}"
    fi
}

cmd_nxm() {
    case "${1:-status}" in
        register)   nxm_register ;;
        unregister) nxm_unregister ;;
        status)
            if nxm_handler_registered; then success "modman handles nxm:// links."
            else warn "modman is not the nxm:// handler. Run: ${PROG} nxm register"; fi ;;
        nxm://*)    nxm_handle "$1" ;;
        *)          die "Usage: ${PROG} nxm register | unregister | status | <nxm://link>" ;;
    esac
}

# ══════════════════════════════════════════════════════════
# COMMAND: status
# ══════════════════════════════════════════════════════════
cmd_status() {
    banner "modman — Status"
    echo -e "${BOLD}Configuration${RESET}"
    echo -e "  Config file   : ${CONFIG_FILE}"
    echo -e "  Log file      : ${NMM_LOG}"
    echo -e "  Data dir      : ${DATA_DIR}"
    echo -e "  Deploy method : ${DEPLOY_METHOD}"
    local key_status
    if [[ -n "$NEXUS_API_KEY" ]]; then key_status="${GREEN}configured${RESET}"; else key_status="${RED}not set — run: ${PROG} login${RESET}"; fi
    echo -e "  API key       : ${key_status}"
    if [[ -n "$NEXUS_API_KEY" ]]; then
        if refresh_account 2>/dev/null; then
            local tier="Free"; [[ "$IS_PREMIUM" == true ]] && tier="Premium ✓"
            echo -e "  Logged in as  : ${GREEN}${NEXUS_USER}${RESET} (${tier})"
            echo -e "  API quota     : $(ratelimit_summary)"
        else
            echo -e "  API key status: ${RED}invalid or network error${RESET}"
        fi
    fi
    local h="${RED}not registered${RESET} (${PROG} nxm register)"; nxm_handler_registered && h="${GREEN}registered${RESET}"
    echo -e "  nxm:// links  : ${h}"

    echo ""
    echo -e "${BOLD}Games${RESET}"
    local d any=0
    while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        any=1
        ( load_game "$d"
          local mark="  "; [[ "$d" == "${FORCE_GAME:-$GAME_DOMAIN}" ]] && mark="${GREEN}* ${RESET}"
          local total enabled files ncol
          total=$(db_count); enabled=$(jq '[.mods[] | select(.enabled)] | length' "$DB_FILE")
          ncol=$(jq '.collections | length' "$DB_FILE")
          files=$(grep -c . "$MANIFEST" 2>/dev/null || true)
          echo -e "  ${mark}${BOLD}${G_NAME}${RESET} ${DIM}(${d})${RESET}"
          echo -e "      Folder     : ${G_FOLDER:-${RED}not set${RESET}}"
          echo -e "      Mods       : ${total} installed, ${enabled} enabled, ${ncol} collection(s)"
          if [[ -s "$MANIFEST" ]]; then
              echo -e "      Deployed   : ${GREEN}${files:-0} files${RESET} on $(fmt_date "$(cat "${GDATA}/deployed.stamp" 2>/dev/null || echo 0)")"
              [[ "$DB_FILE" -nt "${GDATA}/deployed.stamp" ]] && echo -e "      ${YELLOW}Mods changed since the last deploy — run: ${PROG} deploy${RESET}"
          else
              echo -e "      Deployed   : no"
          fi
          local cname crev
          while IFS="$SEP" read -r cname crev; do
              echo -e "      Collection : ${cname} (rev ${crev})"
          done < <(jq -r "$JQ_DEFS"' .collections[] | [.name, .revision] | row' "$DB_FILE") )
    done < <(list_game_domains)
    (( any )) || echo -e "  ${YELLOW}No games configured — run: ${PROG} game add <domain>${RESET}"
    if [[ -s "$LEGACY_MANIFEST" ]]; then
        echo ""
        warn "A modman v2 deployment still exists — remove it with: ${PROG} purge"
    fi
    echo ""
}

# ══════════════════════════════════════════════════════════
# Usage / Help
# ══════════════════════════════════════════════════════════
usage() {
    local p="$PROG"
    echo -e "${BOLD}${CYAN}modman${RESET} v${MODMAN_VERSION} — Nexus Mods manager for Linux"
    echo ""
    echo -e "${BOLD}Usage:${RESET}  ${p} [-g <game>] [-y] <command> [arguments]"
    echo ""
    echo -e "${BOLD}Setup${RESET}"
    printf "  ${GREEN}%-34s${RESET} %s\n" \
        "login"                            "Authenticate with your Nexus API key (+ first game setup)" \
        "logout"                           "Forget the API key" \
        "game detect"                      "List supported games installed through Steam" \
        "game add <domain> [path]"         "Set up a game (Steam folder auto-detected)" \
        "game list | use <domain>"         "Show games / switch the active game" \
        "game info | set <key> <value>"    "Show / change game settings (folder, subdir, method...)" \
        "game remove <domain>"             "Forget a game (purge first)" \
        "config [<key> [<value>]]"         "Show / change global settings" \
        "nxm register | unregister"        "Make modman the browser's handler for nxm:// links"
    echo ""
    echo -e "${BOLD}Mods${RESET}"
    printf "  ${GREEN}%-34s${RESET} %s\n" \
        "install <id|url|nxm|file>"        "Install a mod (Nexus id/URL/nxm link or a local archive)" \
        "   --file <id>  --fomod ask|default"  "pick a file / FOMOD behaviour   --deploy  deploy afterwards" \
        "download <id|url|collection>"     "Download archives without installing" \
        "list [text] [-e|-d] [-c <slug>]"  "List installed mods in priority order" \
        "info <mod>"                       "Details, FOMOD choices and conflicts of a mod" \
        "enable | disable <mod...>"        "Toggle mods (--all, --collection <slug>)" \
        "order <mod> <where>"              "Change priority: <#>|first|last|up|down|before X|after X" \
        "uninstall <mod...>"               "Remove mods (--delete-archive to drop downloads too)" \
        "reinstall <mod> [--ask]"          "Re-extract a mod (--ask re-runs the FOMOD installer)" \
        "conflicts [mod] [--files]"        "Show which mods override each other" \
        "deps [mod] [--refresh]"           "Check required mods and external tools (UE4SS, SKSE...)" \
        "deps ack | unack <name>"          "Mark an external requirement as installed by hand" \
        "updates [--install] [--all]"      "Check installed Nexus mods for newer files" \
        "search <text>"                    "Search Nexus for mods of the active game" \
        "profile list|save|load|delete"    "Save / restore load order + enabled state"
    echo ""
    echo -e "${BOLD}Collections${RESET}"
    printf "  ${GREEN}%-34s${RESET} %s\n" \
        "collection install <url|slug>"    "Download + install a collection (FOMOD choices, load-order rules)" \
        "   --optional all|none|ask"       "which optional mods to include   --revision N   --deploy" \
        "collection list"                  "Installed collections" \
        "collection info <url|slug>"       "Details and update availability" \
        "collection update <slug>"         "Move to the newest revision (removes dropped mods)" \
        "collection remove <slug>"         "Uninstall a collection's mods (--keep-mods)"
    echo ""
    echo -e "${BOLD}Deployment${RESET}"
    printf "  ${GREEN}%-34s${RESET} %s\n" \
        "deploy [--dry-run] [--method m]"  "Link enabled mods into the game folder" \
        "purge"                            "Remove deployed files and restore original game files" \
        "verify"                           "Check the deployed files are intact" \
        "status"                           "Account, games, deployment state" \
        "launch"                           "Start the game through Steam (offers to deploy first)" \
        "clean"                            "Delete unused downloads and temp files" \
        "log [-f] [lines]"                 "Show the log"
    echo ""
    echo -e "${BOLD}Mod references${RESET}  #12 (position) · full id · exact name · Nexus mod id · unique part of the name"
    echo ""
    echo -e "${BOLD}Examples${RESET}"
    echo -e "  ${p} login"
    echo -e "  ${p} collection install https://www.nexusmods.com/games/cyberpunk2077/collections/rcuccp"
    echo -e "  ${p} collection install nxm://cyberpunk2077/collections/rcuccp/revisions/179 --optional none"
    echo -e "  ${p} install 107                      ${DIM}# Cyber Engine Tweaks for the active game${RESET}"
    echo -e "  ${p} install ~/Downloads/SomeMod.zip"
    echo -e "  ${p} order 'Some Mod' after 'Other Mod'"
    echo -e "  ${p} deploy && ${p} launch"
    echo -e "  ${p} -g skyrimspecialedition list"
    echo ""
    echo -e "${BOLD}How it works${RESET}"
    echo -e "  • Each mod is extracted into its own folder: ${DIM}<data-dir>/<game>/mods/<id>${RESET}"
    echo -e "  • deploy hardlinks (or symlinks / reflink-copies) every file into the game, matching folder"
    echo -e "    names case-insensitively; replaced game files are backed up and restored by purge."
    echo -e "  • Premium accounts download directly (in parallel); free accounts click \"Slow download\""
    echo -e "    on the website for each file and the browser passes the link to modman (nxm register)."
    echo -e "  • Required tools: curl jq python3 file flock + 7z (zip/7z) and bsdtar or unrar (rar)"
    echo -e "  • Config: ${CONFIG_DIR}   Data: ${DATA_DIR:-~/nexus-mods}"
    echo ""
}

# ══════════════════════════════════════════════════════════
# Entry Point
# ══════════════════════════════════════════════════════════
main() {
    local -a args=()
    while (( $# )); do
        case "$1" in
            -y|--yes)    ASSUME_YES=1 ;;
            -g|--game)   FORCE_GAME="${2:-}"; shift ;;
            --game=*)    FORCE_GAME="${1#*=}" ;;
            --no-color)  MODMAN_NO_COLOR=1; setup_colors ;;
            --debug)     MODMAN_DEBUG=1 ;;
            --)          shift; args+=("$@"); break ;;
            *)           args+=("$1") ;;
        esac
        shift
    done
    set -- "${args[@]+"${args[@]}"}"
    FORCE_GAME="${FORCE_GAME,,}"

    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        help|--help|-h)       init_dirs; DATA_DIR="${DATA_DIR:-}"; usage; return 0 ;;
        version|--version|-V) echo "modman ${MODMAN_VERSION}"; return 0 ;;
    esac

    init_dirs
    check_deps
    load_config
    run_tmp >/dev/null
    if [[ "$cmd" == login ]]; then _log CMD "login"; else _log CMD "${cmd} $*"; fi

    case "$cmd" in
        login)                       cmd_login ;;
        logout)                      cmd_logout ;;
        game|games)                  cmd_game "$@" ;;
        config)                      cmd_config "$@" ;;
        install|add|i)               cmd_install "$@" ;;
        download|dl)                 cmd_download "$@" ;;
        collection|collections|col)  cmd_collection "$@" ;;
        list|ls)                     cmd_list "$@" ;;
        info|show)                   cmd_info "$@" ;;
        enable)                      cmd_set_enabled true "$@" ;;
        disable)                     cmd_set_enabled false "$@" ;;
        uninstall|remove|rm)         cmd_uninstall "$@" ;;
        reinstall)                   cmd_reinstall "$@" ;;
        order|move|mv)               cmd_order "$@" ;;
        conflicts)                   cmd_conflicts "$@" ;;
        deps|requirements|req)       cmd_deps "$@" ;;
        updates|update|outdated)     cmd_updates "$@" ;;
        search|find)                 cmd_search "$@" ;;
        profile|profiles)            cmd_profile "$@" ;;
        deploy)                      cmd_deploy "$@" ;;
        purge|undeploy)              cmd_purge "$@" ;;
        verify)                      cmd_verify "$@" ;;
        status|st)                   cmd_status ;;
        launch|play|run)             cmd_launch "$@" ;;
        clean)                       cmd_clean "$@" ;;
        log|logs)                    cmd_log "$@" ;;
        nxm)                         cmd_nxm "$@" ;;
        nxm://*)                     cmd_nxm "$cmd" ;;
        *)
            error "Unknown command: '${cmd}'"
            echo ""
            usage
            exit 1 ;;
    esac
}

main "$@"
