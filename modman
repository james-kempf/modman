TYPE_LABEL = {'Required': 'required', 'Recommended': 'recommended', 'NotUsable': 'not usable', 'CouldBeUsable': 'could be usable'}
GROUP_LABEL = {'SelectExactlyOne': 'pick one', 'SelectAtMostOne': 'pick one or none', 'SelectAtLeastOne': 'pick at least one',
               'SelectAll': 'all included', 'SelectAny': 'pick any'}

def parse_sel(text, n):
    sel = set()
    for tok in re.split(r'[,\s]+', text):
        if not tok:
            continue
        m = re.fullmatch(r'(\d+)-(\d+)', tok)
        if m:
            sel.update(range(int(m.group(1)) - 1, int(m.group(2))))
        elif tok.isdigit():
            sel.add(int(tok) - 1)
        else:
            return None
    if any(i < 0 or i >= n for i in sel):
        return None
    return sorted(sel)

def ask_group(gname, gtype, plugins, types, dflt):
    n = len(plugins)
    say(f"\n  \033[1m{gname}\033[0m  \033[2m({GROUP_LABEL.get(gtype, gtype)})\033[0m")
    for i, p in enumerate(plugins):
        mark = '\033[32m*\033[0m' if i in dflt else ' '
        line = f"   {mark}{i + 1:>2}. {p.get('name') or ''}"
        lab = TYPE_LABEL.get(types[i], '')
        if lab:
            line += f"  [{lab}]"
        desc = ' '.join((p.findtext('description') or '').split())
        if desc:
            line += f"\033[2m — {desc[:90]}{'…' if len(desc) > 90 else ''}\033[0m"
        say(line)
    if gtype == 'SelectAll':
        return list(range(n))
    dtext = ','.join(str(i + 1) for i in dflt) or 'none'
    hint = {'SelectExactlyOne': 'number', 'SelectAtMostOne': 'number, 0 = none'}.get(gtype, "e.g. 1,3-4 · a = all · 0 = none")
    while True:
        ans = prompt(f"  ? Choose ({hint}, ?N = details) [{dtext}]: ")
        if ans == '':
            sel = list(dflt)
        elif ans.startswith('?'):
            k = ans[1:].strip()
            if k.isdigit() and 1 <= int(k) <= n:
                say('\n' + ((plugins[int(k) - 1].findtext('description') or '(no description)').strip()) + '\n')
            continue
        elif ans.lower() in ('0', 'n', 'none'):
            sel = []
        elif ans.lower() in ('a', 'all'):
            sel = list(range(n))
        else:
            sel = parse_sel(ans, n)
            if sel is None:
                say('    invalid selection')
                continue
        sel = sorted(set(sel) | {i for i in range(n) if types[i] == 'Required'})
        bad = [i + 1 for i in sel if types[i] == 'NotUsable']
        if bad:
            say(f'    option(s) {bad} cannot be used')
            continue
        if gtype == 'SelectExactlyOne' and len(sel) != 1:
            say('    choose exactly one')
            continue
        if gtype == 'SelectAtMostOne' and len(sel) > 1:
            say('    choose at most one')
            continue
        if gtype == 'SelectAtLeastOne' and not sel:
            say('    choose at least one')
            continue
        return sel

