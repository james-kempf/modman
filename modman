nexus_game_id() {
    if [[ -z "${G_NEXUS_ID:-}" ]]; then
        local body
        body=$(rest_get "/games/${G_DOMAIN}.json") || return 1
        G_NEXUS_ID=$(jq -r '.id // empty' <<< "$body")
        [[ -n "$G_NEXUS_ID" ]] && save_game "$G_DOMAIN"
    fi
    [[ -n "$G_NEXUS_ID" ]] && printf '%s' "$G_NEXUS_ID"
