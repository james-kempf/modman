def place_tree(src, dst):
    for dp, dns, fns in os.walk(src):
        rel = os.path.relpath(dp, src)
        tdir = dst if rel == '.' else os.path.join(dst, rel)
        os.makedirs(tdir, exist_ok=True)
        for fn in fns:
