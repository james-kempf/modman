const __vite_ssr_export_default__ = "// SPDX-License-Identifier: GPL-3.0-or-later\n// Typed wrappers of every Tauri command (apps/desktop/src-tauri/src/commands.rs).\n// Arguments are snake_case. `game` is a game id; omitted/null = the\n// active game. Every command rejects with a `CmdError` ({ message }).\n// Long commands (\"job\") emit `vessel:job` start/finish events, stream\n// `vessel:activity` messages and may raise `vessel:prompt` questions that\n// must be answered with `promptAnswer`.\n\nimport { transport } from \"./transport\";\nimport type {\n  AccountInfo,\n  AfterChange,\n  Answer,\n  AppInfo,\n  ShortcutStatus,\n  ArtKind,\n  AutoupdateStatus,\n  BrowseRequest,\n  BrowseView,\n  CollectionInfo,\n  CollectionRemoved,\n  CollectionResult,\n  CollectionSummary,\n  ConfigChange,\n  ConfigEntry,\n  ConflictData,\n  DeployReport,\n  DeployStatus,\n  Detected,\n  Download,\n  FilesView,\n  GameConfig,\n  GameFolder,\n  GameView,\n  InstallResult,\n  Launched,\n  LoginResult,\n  ModDetail,\n  ModsView,\n  MoveResult,\n  NxmReceived,\n  PluginLine,\n  PluginStage,\n  PoisonedBackup,\n  ProfileLoaded,\n  ProfileSummary,\n  PurgeReport,\n  QuarantineManifest,\n  QuarantineReport,\n  ReadyInfo,\n  Reinstalled,\n  ReqRow,\n  RestageReport,\n  RestoreReport,\n  RunLogEntry,\n  StartupCheck,\n  UninstallResult,\n  UpdateReport,\n  VerifyReport,\n} from \"./types\";\n\ntype Game = string | null | undefined;\n\nconst call = <T>(cmd: string, args?: Record<string, unknown>): Promise<T> =>\n  transport().invoke<T>(cmd, args);\n\n/** Every command name, as registered in the backend. */\nexport const COMMANDS = [\n  \"app_info\",\n  \"quit_app\",\n  \"steam_shortcut_status\",\n  \"steam_shortcut_set\",\n  \"app_ready\",\n  \"startup_check\",\n  \"prompt_answer\",\n  \"log_tail\",\n  \"config_list\",\n  \"config_set\",\n  \"account\",\n  \"login\",\n  \"logout\",\n  \"games_list\",\n  \"games_detect\",\n  \"game_add\",\n  \"game_use\",\n  \"game_remove\",\n  \"game_set\",\